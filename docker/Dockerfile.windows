# Cross-compile os9exec for Windows using MinGW
FROM ubuntu:24.04

# Install MinGW and build tools
RUN apt-get update && apt-get install -y \
    build-essential \
    mingw-w64 \
    file \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . .

# Build for Windows (x86-64). OS=Windows_NT drives GNUmakefile's own
# per-OS branching (PLAT/EXE/LDFLAGS) -- the same invocation used to
# build+verify this locally, not a separate hand-rolled CFLAGS override,
# so this Dockerfile can't drift from what's actually been tested.
RUN make clean && \
    make OS=Windows_NT CC=x86_64-w64-mingw32-gcc prod

# Verify the output is a Windows binary
RUN file os9exec.exe && ls -lh os9exec.exe
