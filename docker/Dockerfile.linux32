# Build os9exec for 32-bit Linux
FROM i386/ubuntu:20.04 AS builder

# Prevent apt from blocking on an interactive debconf prompt (e.g. tzdata
# asking for a timezone) -- a classic cause of a Docker build hanging
# forever with no error, since there's no stdin to answer it.
ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies (32-bit)
RUN apt-get update && apt-get install -y \
    build-essential \
    clang \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . .

# Build os9exec (native 32-bit)
RUN make clean && make

# Runtime stage (32-bit)
FROM i386/ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libc6 \
    && rm -rf /var/lib/apt/lists/*

# Copy binary from builder
COPY --from=builder /build/os9exec /usr/local/bin/os9exec

# os9exec looks for ./dd by default
# User mounts their OS-9 binaries at runtime:
#   docker run -v /path/to/your/os9:/dd -it os9exec

ENTRYPOINT ["os9exec"]
