# Build os9exec for 32-bit Linux
FROM i386/ubuntu:20.04 AS builder

# Prevent apt from blocking on an interactive debconf prompt (e.g. tzdata
# asking for a timezone) -- a classic cause of a Docker build hanging
# forever with no error, since there's no stdin to answer it.
ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies (32-bit)
RUN apt-get update && apt-get install -y \
    build-essential \
    clang \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . .

# Build os9exec (native 32-bit)
RUN make clean && make

# Runtime stage (32-bit)
FROM i386/ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libc6 \
    && rm -rf /var/lib/apt/lists/*

# Copy binary from builder
COPY --from=builder /build/os9exec /usr/local/bin/os9exec

# os9exec looks for ./dd by default
# User mounts their OS-9 binaries at runtime:
#   docker run -v /path/to/your/os9:/dd -it os9exec

# Run from a real directory, NOT from "/" -- the same reason spelled out in
# docker/Dockerfile, and this image was the one that had it missing. os9exec
# resolves an hX device by looking for a file of that name next to its working
# directory, so at "/" the image's host path ("/h9") is textually identical to
# the OS-9 device path ("/h9"); the namespaces collide and the device never
# registers. `mount -k=500K /h9` then reports success and the very next
# `dir /h9` fails with E_MNF -- which is exactly how the two `rbf:` suite tests
# failed here, and only here, for as long as this image has existed.
WORKDIR /work

ENTRYPOINT ["os9exec"]
