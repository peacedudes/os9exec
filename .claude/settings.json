{
  "permissions": {
    "deny": [
      "Read(**/os9defs/**)",
      "Read(./Source/OS9exec_core/os9defs/**)",
      "Read(Source/OS9exec_core/os9defs/**)",
      "Grep(**/os9defs/**)",
      "Grep(./Source/OS9exec_core/os9defs/**)",
      "Grep(Source/OS9exec_core/os9defs/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/protect-os9defs.sh\"",
            "timeout": 10,
            "statusMessage": "Checking os9defs protection"
          }
        ]
      }
    ]
  }
}
