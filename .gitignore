# freeware/ is the public-domain disk image shipped with os9exec.
# dd is a symlink -> freeware (tracked so cloners get the convention).
# freeware/ content is gitignored until proprietary items are fully removed.
freeware
h*

# Proprietary OS-9 DEFS headers (Microware copyright)
# EXCEPT *_from_book.h which are derived from public OS-9 Guru book — those ARE committed
/Source/OS9exec_core/os9defs/*.h
!/Source/OS9exec_core/os9defs/*_from_book.h

# Adapted OS-9 headers (user-derived from originals; not redistributable pending permission)
/Source/OS9exec_core/os9defs/orig/

# Build output
/Output/
/build/
/.build/
/os9exec
/test/.build/

# Reference PDFs and research material (large, not redistributable)
/resources/

# Claude Code per-user local settings (machine-specific allowlist)
/.claude/settings.local.json

# Internal planning doc — not ready for public visibility yet
/ROADMAP.md

# Subagent-driven-development scratch state (progress ledger, review packages)
/.superpowers/
