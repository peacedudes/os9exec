* t00smoke.a -- throwaway smoke test for report.i's emit routine.
* Emits one known line and exits. Not part of the conformance suite
* proper; exists only to prove emit's length arithmetic on a real guest.
        nam ConfT00
        mod eom,nm,$11,$81,start,$0100
nm      fcs "ConfT00"
        use report.i
start   equ *
        leax OUTBUF,u
        leay MSG,pcr
        ldb #MSGL
        lbsr copys
        lbsr emit
        clrb
        swi2
        fcb $06
MSG     fcc "RESULT t00 PASS  obs=00001 exp=00001  emitter smoke test"
MSGL    equ *-MSG
        emod
eom     equ *
