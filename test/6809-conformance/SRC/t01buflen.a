* t01buflen.a -- throwaway smoke test proving report.i's 128-byte OUTBUF.
* Not part of the conformance suite proper; exists only to demonstrate, on
* a real guest, that a line at least as long as the spec's longest example
* (73 characters) fits in OUTBUF without overwriting VALUE at offset 128.
*
* Round 1 fix: report.i originally put VALUE at offset 60. A line over ~60
* bytes -- well within what the "RESULT tNN VERDICT  obs=00000 exp=00000
* <description>" format produces -- would have silently overwritten VALUE,
* then DIGIT, ERRB and PATHNUM. This test stores a known value in VALUE,u
* BEFORE emitting a 93-byte line, then reads VALUE,u back (via prdec, into
* a second emitted line) to prove it survived untouched.
        nam ConfT01
        mod eom,nm,$11,$81,start,$0100
nm      fcs "ConfT01"
        use report.i
start   equ *
* Sentinel: a known value in VALUE,u, set before the long line below is
* built or emitted.
        ldd #42
        std VALUE,u

* Line 1: 93 bytes (comfortably over the spec's 73-byte longest example),
* built and emitted the ordinary way.
        leax OUTBUF,u
        leay MSG,pcr
        ldb #MSGL
        lbsr copys
        lbsr emit

* Line 2: read VALUE,u back with prdec and emit it. If OUTBUF were still
* only 60 bytes, line 1 above would already have clobbered the sentinel;
* seeing "00042" here on the guest proves it did not.
        leax OUTBUF,u
        leay SURV,pcr
        ldb #SURVL
        lbsr copys
        lbsr prdec
        leay TAIL,pcr
        ldb #TAILL
        lbsr copys
        lbsr emit

        clrb
        swi2
        fcb $06

MSG     fcc "RESULT t01 PASS  obs=00042 exp=00042  buffer holds a full seventy three character line intact"
MSGL    equ *-MSG
SURV    fcc "RESULT t01 PASS  survivor="
SURVL   equ *-SURV
TAIL    fcc "  VALUE unclobbered by the 93-byte line above"
TAILL   equ *-TAIL
        emod
eom     equ *
