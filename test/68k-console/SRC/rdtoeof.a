* rdtoeof.a -- copy standard input to standard output one line at a time* until a read fails, then write END and exit with the error that stopped it.** An instrument for the HOST side of standard input, which only a program* that reads to the end can see: whether a redirected file is read at all,* and whether the end of a file or a pipe ever arrives. On Windows neither* did -- a file gave nothing and a pipe never ended, so a filter hung --* and tools/verify-winvm.sh runs this three ways (a file, a pipe, NUL)* because nowhere else can reach that code. END is the proof the end came:* a system that never delivers it hangs instead, and the caller's timeout* is what reports it.** Nothing here links against a C library or a trap handler, exactly like the* conformance suite: a kernel is enough to run it.Prgrm     set 1Objct     set 1ReEnt     set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev  set (ReEnt<<8)+1IReadLn   set $8BIWritLn   set $8CFExit     set $06LINE      set 256* psect rdtoeof,Type_Lang,Attr_Rev,0,1024,start vsectbuf ds.b LINE endsstartcopy moveq #0,d0 lea buf(a6),a0 move.l #LINE,d1 trap #0 dc.w IReadLn bcs.s ended moveq #1,d0 lea buf(a6),a0 trap #0 dc.w IWritLn bra.s copyended move.w d1,d7 moveq #1,d0 lea endmsg(pc),a0 moveq #4,d1 trap #0 dc.w IWritLn move.w d7,d1 trap #0 dc.w FExitendmsg dc.b "END",13 ends