* t18evwaitr.a -- CONF68K test t18: Ev$WaitR's range is RELATIVE.** Claim (DOCS/claims.md): for Ev$WaitR "the range specified in d2 and d3 is* relative to the current event value.  The event value is added to d2 and d3* respectively, and the actual values are returned to the caller."  So a* relative minimum of 0 on an event holding 100 must come back as 100.** Chosen so that NEITHER reading blocks: relative [0,+500] resolves to* [100,600], which contains 100, and if the range were wrongly taken as* absolute [0,500] that contains 100 as well.  A test that hung on the wrong* answer would report nothing at all instead of reporting a divergence.* The two readings return different minima -- 100 against 0 -- and both are* small positives, so the failing observation prints as a number rather than* as the formatter's overflow marker.Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FEvent set $53EvCreat set 2EvDelet set 3EvWaitR set 5EvRead set 6EvInfo set 7EvSignl set 8EvSet set $0AEvSetR set $0B*INITVAL set 100RELMAX set 500EXPECT set 100* psect t18evwaitr,Type_Lang,Attr_Rev,0,2048,startstart lea evname(pc),a0 move.l #INITVAL,d0 move.w #EvCreat,d1 move.w #0,d2 move.w #1,d3 trap #0 dc.w FEvent bcs.w setuperr move.l d0,d5 move.l d5,d0 move.w #EvWaitR,d1 moveq #0,d2 move.l #RELMAX,d3 trap #0 dc.w FEvent bcs.w setuperr move.l d2,d6 lea evname(pc),a0 move.w #EvDelet,d1 trap #0 dc.w FEvent cmpi.l #EXPECT,d6 beq.s ispass bra.s isfail* use verdict.i use report.i*evname dc.b "cf18ev",0idstr dc.b "RESULT t18 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  Ev$WaitR resolves its range against the event value",0 ends