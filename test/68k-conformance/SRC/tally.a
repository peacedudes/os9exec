* tally.a -- CONF68K's result counter.** Reads RESULTS/report, counts the RESULT lines by verdict, and prints one* summary line:**   CONF68K totals: PASS=nnnnnn FAIL=nnnnnn SKIP=nnnnnn ERROR=nnnnnn** Written in assembly rather than BASIC09 on purpose. The 6809 suite's* tally is a packed BASIC09 module, which is why that suite's readme has to* tell an operator to "load runb" before running anything -- the counter* drags a language runtime in behind it. This one needs nothing but the* kernel, so the whole 68k suite runs on a system with no development tools* and no BASIC installed at all.** It counts every RESULT line in the file regardless of which run wrote it.* The report is append-only, so run this straight after the run you care* about, or split the file on its RUN boundary lines first.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84IReadLn set $8BIClose set $8FEEOF set 211** Stack frame: 0..127 line buffer, 128 path number.* The four counters live in d4-d7 and nowhere else, because put6dec* clobbers d0-d3: a counter in d3 would be destroyed by the act of* printing the previous one, and the totals would come out wrong only for* the fields after the first -- the kind of bug that looks like a* miscount in the suite rather than in the counter.BUFSZ set 128PATHN set 128* psect tally,Type_Lang,Attr_Rev,0,2048,startstart sub.l #160,a7 movea.l a7,a4 moveq #0,d4 moveq #0,d5 moveq #0,d6 moveq #0,d7* open the report lea rname(pc),a0 moveq #1,d0 trap #0 dc.w IOpen bcs.w noreport move.w d0,PATHN(a4)*rdloop movea.l a4,a0 move.l #BUFSZ,d1        ; NOT moveq: its immediate is a signed byte,*                          so moveq #128 loads -128 and I$ReadLn gets a*                          nonsense byte count instead of a buffer size. moveq #0,d0 move.w PATHN(a4),d0 trap #0 dc.w IReadLn bcs.w rddone* d1.l = bytes read. A RESULT line needs at least 12 of them before the* verdict byte can be looked at; anything shorter is some other line and* is skipped rather than guessed at. cmpi.l #12,d1 blt.s rdloop* does the line start with "RESULT "? movea.l a4,a1 lea rword(pc),a2 moveq #6,d3cmploop move.b (a1)+,d0 cmp.b (a2)+,d0 bne.s rdloop dbra d3,cmploop* offset 11 is the verdict's first letter, and the four verdicts differ* there: PASS, FAIL, SKIP, ERROR. move.b 11(a4),d0 cmpi.b #'P',d0 bne.s notp addq.l #1,d4 bra.s rdloopnotp cmpi.b #'F',d0 bne.s notf addq.l #1,d5 bra.s rdloopnotf cmpi.b #'S',d0 bne.s nots addq.l #1,d6 bra.s rdloopnots cmpi.b #'E',d0 bne.s rdloop addq.l #1,d7 bra.s rdloop*rddone* Any error other than end-of-file means the report was not fully read, so* the totals below would be a partial count presented as a whole one. Say* so instead of printing them. cmpi.w #EEOF,d1 bne.s readerr moveq #0,d0 move.w PATHN(a4),d0 trap #0 dc.w IClose lea t1msg(pc),a0 bsr putstr move.l d4,d2 bsr put6dec lea t2msg(pc),a0 bsr putstr move.l d5,d2 bsr put6dec lea t3msg(pc),a0 bsr putstr move.l d6,d2 bsr put6dec lea t4msg(pc),a0 bsr putstr move.l d7,d2 bsr put6dec bsr putcr bra finish*noreport lea nomsg(pc),a0 bsr putstr bsr putcr bra finish*readerr lea badmsg(pc),a0 bsr putstr move.l d1,d2 andi.l #$FFFF,d2 bsr put6dec bsr putcr bra finish* use report.i*rname dc.b "RESULTS/report",0rword dc.b "RESULT "t1msg dc.b "CONF68K totals: PASS=",0t2msg dc.b " FAIL=",0t3msg dc.b " SKIP=",0t4msg dc.b " ERROR=",0nomsg dc.b "CONF68K tally: no RESULTS/report to count -- run runall first",0badmsg dc.b "CONF68K tally: report could not be read, error ",0 ends