* tally.a -- CONF68K's result counter.** Reads RESULTS/report, counts the RESULT lines by verdict, and prints one* summary line:**   CONF68K totals: PASS=nnnnnn FAIL=nnnnnn SKIP=nnnnnn ERROR=nnnnnn** Written in assembly rather than BASIC09 on purpose. The 6809 suite's* tally is a packed BASIC09 module, which is why that suite's readme has to* tell an operator to "load runb" before running anything -- the counter* drags a language runtime in behind it. This one needs nothing but the* kernel, so the whole 68k suite runs on a system with no development tools* and no BASIC installed at all.** It counts the LAST run only: the report is append-only, and every run* starts with mark's "RUN" line, so the counters start again at each one.* Counting the whole file kept an old run's FAIL in every later total.** Then it says, in plain words, what to do: nothing, if every test passed* or was skipped; open an issue, if anything failed, erred, or did not* report at all (a test that dies prints no RESULT line, so fewer lines* than NTESTS means one did). A SKIP gets a line of its own saying it is* normal, because on a disk that is not RBF -- a host directory, as on* Windows -- many are, and a reader should not take them for failures.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84IReadLn set $8BIClose set $8FEEOF set 211* the number of tests runall runs: keep it in step with runall (and mark)NTESTS set 116** Stack frame: 0..127 line buffer, 128 path number.* The four counters live in d4-d7 and nowhere else, because put6dec* clobbers d0-d3: a counter in d3 would be destroyed by the act of* printing the previous one, and the totals would come out wrong only for* the fields after the first -- the kind of bug that looks like a* miscount in the suite rather than in the counter.BUFSZ set 128PATHN set 128* psect tally,Type_Lang,Attr_Rev,0,2048,startstart sub.l #160,a7 movea.l a7,a4 moveq #0,d4 moveq #0,d5 moveq #0,d6 moveq #0,d7* open the report lea rname(pc),a0 moveq #1,d0 trap #0 dc.w IOpen bcs.w noreport move.w d0,PATHN(a4)*rdloop movea.l a4,a0 move.l #BUFSZ,d1        ; NOT moveq: its immediate is a signed byte,*                          so moveq #128 loads -128 and I$ReadLn gets a*                          nonsense byte count instead of a buffer size. moveq #0,d0 move.w PATHN(a4),d0 trap #0 dc.w IReadLn bcs.w rddone* d1.l = bytes read. A RESULT line needs at least 12 of them before the* verdict byte can be looked at; anything shorter is some other line and* is skipped rather than guessed at. cmpi.l #12,d1 blt.w rdloop* a "RUN " line starts another run: count from nothing again movea.l a4,a1 lea runword(pc),a2 moveq #3,d3runcmp move.b (a1)+,d0 cmp.b (a2)+,d0 bne.s notrun dbra d3,runcmp moveq #0,d4 moveq #0,d5 moveq #0,d6 moveq #0,d7 bra.w rdloopnotrun* does the line start with "RESULT "? movea.l a4,a1 lea rword(pc),a2 moveq #6,d3cmploop move.b (a1)+,d0 cmp.b (a2)+,d0 bne.w rdloop dbra d3,cmploop* The verdict follows the test ID and one space. It used to be read at* offset 11, which is right for "RESULT t99 " and one short for "RESULT* t100 ": every test from t100 on went uncounted. So walk past the ID, as* far as the line's CR at most. The four verdicts differ in their first* letter: PASS, FAIL, SKIP, ERROR.idskip move.b (a1)+,d0 cmpi.b #$0D,d0 beq.w rdloop cmpi.b #$20,d0 bne.s idskip move.b (a1),d0 cmpi.b #'P',d0 bne.s notp addq.l #1,d4 bra.w rdloopnotp cmpi.b #'F',d0 bne.s notf addq.l #1,d5 bra.w rdloopnotf cmpi.b #'S',d0 bne.s nots addq.l #1,d6 bra.w rdloopnots cmpi.b #'E',d0 bne.w rdloop addq.l #1,d7 bra.w rdloop*rddone* Any error other than end-of-file means the report was not fully read, so* the totals below would be a partial count presented as a whole one. Say* so instead of printing them. cmpi.w #EEOF,d1 bne.w readerr moveq #0,d0 move.w PATHN(a4),d0 trap #0 dc.w IClose lea t1msg(pc),a0 bsr putstr move.l d4,d2 bsr put6dec lea t2msg(pc),a0 bsr putstr move.l d5,d2 bsr put6dec lea t3msg(pc),a0 bsr putstr move.l d6,d2 bsr put6dec lea t4msg(pc),a0 bsr putstr move.l d7,d2 bsr put6dec bsr putnl* the verdict: anything that failed, erred or never reported is news move.l d5,d0 add.l d7,d0 bne.s sendit move.l d4,d0 add.l d6,d0 cmpi.l #NTESTS,d0 blt.s short lea okmsg(pc),a0 bsr putstr bsr putnl tst.l d6 beq finish lea skipmsg1(pc),a0 bsr putstr bsr putnl lea skipmsg2(pc),a0 bsr putstr bsr putnl bra finishshort lea shortmsg(pc),a0 bsr putstr bsr putnlsendit lea sendmsg1(pc),a0 bsr putstr bsr putnl lea sendmsg2(pc),a0 bsr putstr bsr putnl bra finish*noreport lea nomsg(pc),a0 bsr putstr bsr putnl bra finish*readerr lea badmsg(pc),a0 bsr putstr move.l d1,d2 andi.l #$FFFF,d2 bsr put6dec bsr putnl bra finish*** putnl: end a line on the screen. report.i's putcr writes its CR with* I$Write, which is right for RESULTS/report, a file; on a terminal SCF adds* the line feed only for I$WritLn, so tally's lines overwrote each other.putnl lea nlbyte(pc),a0 moveq #1,d1 moveq #1,d0 trap #0 dc.w $8C rtsnlbyte dc.b $0D align use report.i*rname dc.b "RESULTS/report",0rword dc.b "RESULT "runword dc.b "RUN "okmsg dc.b "Every test passed or was skipped. Nothing to send -- thank you.",0skipmsg1 dc.b "A SKIP is normal: that claim cannot be checked on this system or disk",0skipmsg2 dc.b "(record locking, for one, needs a real RBF disk). It is not a failure.",0shortmsg dc.b "Some tests did not report: one stopped without printing its result.",0sendmsg1 dc.b "Please tell us: open an issue at github.com/peacedudes/os9exec/issues",0sendmsg2 dc.b "and paste in RESULTS/report, and RESULTS/errors if you have one.",0t1msg dc.b "CONF68K totals: PASS=",0t2msg dc.b " FAIL=",0t3msg dc.b " SKIP=",0t4msg dc.b " ERROR=",0nomsg dc.b "CONF68K tally: no RESULTS/report to count -- run runall first",0badmsg dc.b "CONF68K tally: report could not be read, error ",0* report.i's detail names idstr; tally never calls detail, but the linker* resolves every reference, so it gets one. Eight bytes, keeping this even.idstr dc.b "tally  ",0 ends