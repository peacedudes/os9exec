* t91alpast.a -- CONF68K test t91: an absolute alarm whose time has already* passed is sent, not refused.** Claim (DOCS/claims.md): "The alarm signal is sent anytime the system* date/time becomes greater than or equal to the alarm time" (A$AtDate, page* 1 - 3; the same sentence appears under A$AtJul, page 1 - 4). For a time* already past that condition is already true. Nothing on either page, or in* F$Alarm's own error list (page 1 - 1), says a past time is refused.** The process installs an intercept routine, reads the Julian time, and asks* for signal 310 ten seconds AGO; then it does the same in Gregorian form* with signal 311, taking the time from a fresh reading and stepping the* seconds byte back by ten (reading again after a pause if that would cross a* minute, so no borrow is needed). It then sleeps up to 200 ticks, returning* to sleep when a signal cuts it short, and counts what arrived.** obs is 10 if the Julian one arrived, plus 1 if the Gregorian one did: 11* when the claim holds. A system that refuses a past time reports the error* code of the refused call instead. os9exec answered 000:225 (E$Param) to* both until 2026-09-20.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FTime set $15FIcpt set $09FSleep set $0AFRTE set $1EFAlarm set $56AAtDate set 3AAtJul set 4* the data area, through a6GOTJUL set 0GOTGRG set 2*EXPECT set 11* psect t91alpast,Type_Lang,Attr_Rev,0,2048,startstart clr.w GOTJUL(a6) clr.w GOTGRG(a6) lea sighand(pc),a0 trap #0 dc.w FIcpt bcs.w setuperr* ten seconds ago, in Julian form moveq #1,d0 trap #0 dc.w FTime bcs.w setuperr cmpi.l #20,d0 bhs.s t91jset move.l #400,d4 bsr.w nap moveq #1,d0 trap #0 dc.w FTime bcs.w setuperrt91jset move.l d0,d3 subq.l #8,d3 subq.l #2,d3 move.l d1,d4 moveq #0,d0 move.w #AAtJul,d1 move.l #310,d2 trap #0 dc.w FAlarm bcc.s t91greg moveq #0,d6 move.w d1,d6 bra.w t91v* ten seconds ago, in Gregorian formt91greg moveq #0,d0 trap #0 dc.w FTime bcs.w setuperr cmpi.b #12,d0 bhs.s t91gset move.l #400,d4 bsr.w nap moveq #0,d0 trap #0 dc.w FTime bcs.w setuperrt91gset move.l d0,d3 subq.l #8,d3 subq.l #2,d3 move.l d1,d4 moveq #0,d0 move.w #AAtDate,d1 move.l #311,d2 trap #0 dc.w FAlarm bcc.s t91wait moveq #0,d6 move.w d1,d6 bra.s t91vt91wait move.l #200,d4 bsr.s nap moveq #0,d6 tst.w GOTJUL(a6) beq.s t91g2 moveq #10,d6t91g2 tst.w GOTGRG(a6) beq.s t91v addq.l #1,d6t91v cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail** nap -- sleep d4 ticks in all, however often a signal cuts a sleep shortnap moveq #0,d0 move.l d4,d0 trap #0 dc.w FSleep tst.l d0 beq.s napdone move.l d0,d4 bra.s napnapdone rts** the intercept routine: note which alarm arrivedsighand cmpi.w #310,d1 bne.s sh311 move.w #1,GOTJUL(a6) bra.s shdonesh311 cmpi.w #311,d1 bne.s shdone move.w #1,GOTGRG(a6)shdone trap #0 dc.w FRTE* use verdict.i use report.i*idstr dc.b "RESULT t91 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  an absolute alarm set for a time already past is still sent",0 ends