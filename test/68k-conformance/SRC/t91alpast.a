* t91alpast.a -- CONF68K test t91: an absolute alarm whose time has already* passed is sent, not refused.** Claim (DOCS/claims.md): the signal "is sent anytime the system date/time* becomes greater than or equal to the alarm time" (A$AtDate, page 1 - 3, and* A$AtJul, page 1 - 4, the same sentence in both), and neither page nor* F$Alarm's error list says a time in the past is refused.** Both absolute forms are asked for, because they convert differently:* A$AtJul takes d3 = seconds since midnight and d4 = a Julian day number,* A$AtDate takes d3 = 00hhmmss and d4 = yyyymmdd (F$Time, page 1 - 64).** THE TIME ASKED FOR IS MIDNIGHT TODAY, and that is the whole of the* arithmetic on purpose. The first version of this test asked for "ten* seconds ago" by subtracting 10 from what F$Time returned, which is right* for the Julian form -- a plain count of seconds -- and WRONG for the* Gregorian one: 00hhmmss is three binary fields, so with the second under* 10 the subtraction borrows, 00:12:04 becomes 00:11:250, and the alarm* lands three minutes in the FUTURE. It failed about one run in twenty-five* that way, always with the Gregorian half missing (DOCS/ourruns.md). A time* of zero needs no subtraction, no guard against the field underflowing, and* no reading of the clock to decide whether the guard is satisfied.** Midnight today is in the past for all but the first instant of a day, and* in that instant it is equal to the current time -- which the manual's* "greater than or equal" makes due as well. There is no moment at which* this test asks for the future.** The process installs an intercept routine, asks for signal 310 at midnight* in Julian form and 311 at midnight in Gregorian form, and waits: obs is 10* if the Julian one arrived plus 1 if the Gregorian one did, so 11. A system* that refuses a past time reports that error instead.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FTime set $15FIcpt set $09FSleep set $0AFRTE set $1EFAlarm set $56AAtDate set 3AAtJul set 4* the data area, through a6*EXPECT set 11* psect t91alpast,Type_Lang,Attr_Rev,0,2048,start vsectGOTJUL ds.w 1GOTGRG ds.w 1 endsstart clr.w GOTJUL(a6) clr.w GOTGRG(a6) lea sighand(pc),a0 trap #0 dc.w FIcpt bcs.w setuperr* midnight today, Julian: d3 = 0 seconds since midnight, d4 = today moveq #1,d0 trap #0 dc.w FTime bcs.w setuperr move.l d1,d4 moveq #0,d3 moveq #0,d0 move.w #AAtJul,d1 move.l #310,d2 trap #0 dc.w FAlarm bcc.s t91greg moveq #0,d6 move.w d1,d6 bra.w t91v* midnight today, Gregorian: d3 = 00:00:00, d4 = todayt91greg moveq #0,d0 trap #0 dc.w FTime bcs.w setuperr move.l d1,d4 moveq #0,d3 moveq #0,d0 move.w #AAtDate,d1 move.l #311,d2 trap #0 dc.w FAlarm bcc.s t91wait moveq #0,d6 move.w d1,d6 bra.s t91vt91wait move.l #200,d4 bsr.s nap moveq #0,d6 tst.w GOTJUL(a6) beq.s t91g2 moveq #10,d6t91g2 tst.w GOTGRG(a6) beq.s t91v addq.l #1,d6t91v cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail** nap -- sleep d4 ticks in all, however often a signal cuts a sleep shortnap moveq #0,d0 move.l d4,d0 trap #0 dc.w FSleep tst.l d0 beq.s napdone move.l d0,d4 bra.s napnapdone rts*sighand cmpi.w #310,d1 bne.s sh311 move.w #1,GOTJUL(a6) bra.s shdonesh311 cmpi.w #311,d1 bne.s shdone move.w #1,GOTGRG(a6)shdone trap #0 dc.w FRTE* use verdict.i use report.i*idstr dc.b "RESULT t91 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  an absolute alarm set for a time already past is still sent",0 ends