* t76aldate.a -- CONF68K test t76: A$AtDate signals at the Gregorian time* asked for.** Claim (DOCS/claims.md): A$AtDate, given the signal code in d2, the time as* 00hhmmss in d3 and the date as YYYYMMDD in d4, "sends a signal to the* caller at a specific date and time" (A$AtDate, page 1 - 3). F$Time with* d0 = 0 gives the time in that form: 00hhmmss in d0, YYYYMMDD in d1 (F$Time,* page 1 - 64).** The process reads the time, asks for signal 303 two seconds later -- the* seconds byte plus two, after a 4-second pause and a fresh reading if that* would pass 59 -- and sleeps up to 500 ticks, going back to sleep when a* signal cuts it short. obs is 1000 x the signals received plus the first* code: 1303 when the claim holds; 0 if the alarm never came.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FIcpt set $09FSleep set $0AFRTE set $1EFAlarm set $56ADelete set 0ASet set 1ACycle set 2AAtDate set 3AAtJul set 4FTime set $15* in the data area, through a6*EXPECT set 1303* psect t76aldate,Type_Lang,Attr_Rev,0,2048,start vsectCNT ds.w 1FIRST ds.w 1 endsstart clr.w CNT(a6) clr.w FIRST(a6) lea sighand(pc),a0 trap #0 dc.w FIcpt bcs.w setuperr moveq #0,d0 trap #0 dc.w FTime bcs.w setuperr cmpi.b #57,d0 blo.s t76set move.l #400,d4 bsr.w nap moveq #0,d0 trap #0 dc.w FTime bcs.w setuperrt76set move.l d0,d3 addq.l #2,d3 move.l d1,d4 moveq #0,d0 move.w #AAtDate,d1 move.l #303,d2 trap #0 dc.w FAlarm bcs.w setuperr move.l #500,d4 bsr.w nap moveq #0,d6 move.w CNT(a6),d6 mulu #1000,d6 moveq #0,d0 move.w FIRST(a6),d0 add.l d0,d6 cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* the intercept routine: keep the first code, count every callsighand tst.w CNT(a6) bne.s shcount move.w d1,FIRST(a6)shcount addq.w #1,CNT(a6) trap #0 dc.w FRTE** nap -- sleep d4 ticks in all, however often a signal cuts a sleep shortnap moveq #0,d0 move.l d4,d0 trap #0 dc.w FSleep tst.l d0 beq.s napdone move.l d0,d4 bra.s napnapdone rts* use verdict.i use report.i*idstr dc.b "RESULT t76 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  A$AtDate signals at the Gregorian time asked for",0 ends