* t110rosize.a -- CONF68K test t110: SS_Size on a path opened for reading* only.** Claim (DOCS/claims.md): an INFERENCE, stated as one. I$SetStt SS_Size* (Technical Manual) names no access mode the path must have,* and os9exec accepts the call on a read-only path. A system that refuses it* (E$BMode, 203, would be the natural answer) shows its error code here, and* os9exec should then follow the hardware. obs is 0 when accepted, else the* error code; either way the file is left as it was made.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1ICreate set $83IOpen set $84IWrite set $8AIClose set $8FIDelete set $87ISetStt set $8ESSSize set $02ATTRS set $001BREAD set 1EXPECT set 0 psect t110rosize,Type_Lang,Attr_Rev,0,2048,startstart lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #3,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea block(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #READ,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7 moveq #0,d6 moveq #0,d0 move.w d7,d0 move.w #SSSize,d1 moveq #20,d2 trap #0 dc.w ISetStt bcc.s t110ok move.w d1,d6t110ok moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*fname dc.b "SCRATCH/t110.dat",0block dc.b "0123456789012345678901234567890123456789012345678",13idstr dc.b "RESULT t110 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  SS_Size on a read-only path is accepted (inference)",0 ends