* t95setsize.a -- CONF68K test t95: the SS_Size SetStat sets a file's size.** Claim (DOCS/claims.md): "SS_Size sets the file's size", taking the new size* in d2.l (I$SetStt: SS_Size, page 2 - 27); the GetStat of the same name* "returns the current size of the selected file" in d2.l (page 2 - 13); and a* read past the end of a file reports E$EOF, 211 (I$Read, page 2 - 18, and the* error-code appendix, page Error Codes - 5).** The page marks the call (RBF, PIPE), so a device that is neither cannot be* asked. The test decides which it is on the device's own evidence rather than* on a name: SS_Ticks is an RBF SetStat, and a file manager without it answers* E$UnkSvc, 208 -- which is t32's claim, used here as the probe. E$UnkSvc for* the probe is SKIP carrying 208; anything else means RBF is underneath and* the claim has to hold, so a refusal there is a FAIL and not a shrug.** The file is created in UPDATE mode (3), not write (2): the same path writes* it, cuts it and then reads it back, and a write-only path answers a read* with E$BMode -- which is what the first draft of this test did, scoring the* size digit and failing the other two in a way that looked like the emulator* not truncating anything.** A 300-byte file is cut to 100. obs is 100 if the size reads back as 100,* plus 10 if the bytes below the cut survived it -- truncation keeps the head* of the file, and a system that emptied it instead would still report 100 --* plus 1 if a read at 150 now reports end of file: 111.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1ICreate set $83IOpen set $84IRead set $89IWrite set $8AISeek set $88IClose set $8FIDelete set $87IGetStt set $8DISetStt set $8ESSSize set $02SSTicks set $10ATTRS set $001BEUNKSVC set 208EEOF set 211*EXPECT set 111* psect t95setsize,Type_Lang,Attr_Rev,0,2048,startstart sub.l #128,a7 movea.l a7,a4 lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #3,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7* 300 bytes: six writes of the same 50, so the head is known moveq #6,d5t95fill lea block50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr subq.l #1,d5 bne.s t95fill** is RBF underneath? SS_Ticks is an RBF SetStat (t32) moveq #0,d0 move.w d7,d0 move.w #SSTicks,d1 moveq #5,d2 trap #0 dc.w ISetStt bcc.s t95cut cmpi.w #EUNKSVC,d1 bne.s t95cut move.l #EUNKSVC,d6 bra.w t95skip*t95cut moveq #0,d6 moveq #0,d0 move.w d7,d0 move.w #SSSize,d1 move.l #100,d2 trap #0 dc.w ISetStt bcs.w t95v* the size it now reports moveq #0,d0 move.w d7,d0 move.w #SSSize,d1 trap #0 dc.w IGetStt bcs.s t95head cmpi.l #100,d2 bne.s t95head moveq #100,d6* the bytes below the cut are still theret95head moveq #0,d0 move.w d7,d0 moveq #0,d1 trap #0 dc.w ISeek bcs.s t95eof movea.l a4,a0 moveq #4,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IRead bcs.s t95eof cmpi.l #4,d1 bne.s t95eof cmpi.b #'A',0(a4) bne.s t95eof cmpi.b #'D',3(a4) bne.s t95eof addi.l #10,d6* and there is nothing at 150 any moret95eof moveq #0,d0 move.w d7,d0 move.l #150,d1 trap #0 dc.w ISeek bcs.s t95done movea.l a4,a0 moveq #4,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IRead bcc.s t95done cmpi.w #EEOF,d1 bne.s t95done addq.l #1,d6t95done bsr.s t95shut cmpi.l #EXPECT,d6 beq.w ispass bra.w isfailt95v bsr.s t95shut bra.w isfailt95skip bsr.s t95shut lea skipstr(pc),a5 bra.w report*t95shut moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete rts* use verdict.i use report.i*fname dc.b "SCRATCH/t95.dat",0block50 dc.b "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwx"idstr dc.b "RESULT t95 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0skipstr dc.b "SKIP",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  the SS_Size SetStat cuts a file to the size asked for",0 ends