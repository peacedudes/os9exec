* t42evsigw.a -- CONF68K test t42: an Ev$Signl wakes a process waiting on the* event, and the value it wakes with stays behind.** Claim (DOCS/claims.md): Ev$Signl "signals that an event has occurred.  The* current event variable is updated with the signal auto-increment specified* when the event was created.  Then, the event queue is searched for the first* process waiting for that event value" (page 1-26), and Ev$Wait suspends a* caller whose range does not contain the value until "an Ev$Signl occurs that* puts the value in range" (page 1-22).** t14 already checks that an Ev$Signl applies the signal auto-increment, but it* is a single process and so has nobody waiting: it measures the arithmetic and* not the wake.  This is the wake, which is the whole purpose of the call --* and it is the ordinary case, where t41's pulse is the exotic one.  A system* can get the arithmetic right and never wake anybody.** Kept deliberately parallel to t41 so the pair reads as one experiment with* one variable changed: same event shape, same handshake, same range, same* reported value.  Only the call the parent makes differs.  The event is* created holding 0 with a signal auto-increment of 1 and the child waits on* the range [1,1], so the signal is exactly what puts the value in range.** The last step is what separates this from t41 rather than duplicating it:* after the child has been woken, the PARENT reads the event.  A signal leaves* its value behind (1); a pulse would have put the old one back (0).  The* child's own observation cannot tell those apart -- both wake it with 1 -- so* the test reports what the parent read afterwards, and the child's wake is* what makes reaching that step possible at all.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FEvent set $53EvLink set 0EvCreat set 2EvDelet set 3EvWait set 4EvRead set 6EvSignl set 8*INITVAL set 0WAITINC set 0SIGINC set 1WAKEVAL set 1EXPECT set 1* psect t42evsigw,Type_Lang,Attr_Rev,0,4096,startstart bsr ckrole tst.w d0 bne.w child** ---- parent: create the event, fork, signal it once the child waits ---- lea rdymark(pc),a0 bsr rmmark lea dnmark(pc),a0 bsr rmmark* lea evname(pc),a0 move.l #INITVAL,d0 move.w #EvCreat,d1 move.w #WAITINC,d2 move.w #SIGINC,d3 trap #0 dc.w FEvent bcs.w setuperr move.l d0,d7* moveq #0,d0 moveq #0,d1 moveq #1,d2 moveq #3,d3 moveq #0,d4 lea childpm(pc),a1 lea myname(pc),a0 trap #0 dc.w FFork bcs.w setuperr move.w d0,d4* move.l #READYMAX,d3srdy lea rdymark(pc),a0 bsr ckmark bcc.s ssig moveq #1,d0 bsr napticks subq.l #1,d3 bne.s srdy** Let the child reach its Ev$Wait, then signal.  No all-processes bit: this is* the plain spelling, one waiter, and the first process in range is it.ssig move.l #RELDELAY,d0 bsr napticks moveq #0,d5 move.l d7,d0 move.w #EvSignl,d1 trap #0 dc.w FEvent bcc.s swdone* A refused signal still leaves a child blocked on an event nothing will now* put in range, so the reap below has to happen either way. move.w d1,d5*swdone move.l #DONEMAX,d3swloop lea dnmark(pc),a0 bsr ckmark bcc.s sreap moveq #1,d0 bsr napticks subq.l #1,d3 bne.s swloop* moveq #0,d0 move.w d4,d0 moveq #0,d1 trap #0 dc.w FSend moveq #20,d3shwait trap #0 dc.w FWait bcs.s shung cmp.w d4,d0 beq.s shung subq.w #1,d3 bne.s shwaitshung move.l #HUNG,d6 bra.w sverd*sreap moveq #20,d3swait trap #0 dc.w FWait bcs.w setuperr cmp.w d4,d0 beq.s sgot subq.w #1,d3 bne.s swait move.w #SPNOWAIT,d1 bra.w setuperr** The child's own band still has to be decoded, because a child that could not* set up has nothing to say about the value and must not be read as if it had.sgot moveq #0,d6 move.w d1,d6 cmpi.l #2000,d6 blt.s sobs sub.l #2000,d6 move.w d6,d1 bra.w setuperrsobs cmpi.l #1000,d6 blt.s sdied sub.l #1000,d6** The child woke.  What this test reports is what the event holds NOW: a* signal leaves its value in place where a pulse restores the old one. move.l d7,d0 move.w #EvRead,d1 trap #0 dc.w FEvent bcs.w setuperr move.l d1,d6 bra.s sverdsdied move.w d6,d1 bra.w setuperr*sverd tst.w d5 beq.s sdelet moveq #0,d6 move.w d5,d6sdelet lea evname(pc),a0 move.w #EvDelet,d1 trap #0 dc.w FEvent cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail** ---- child: block on the event until the signal puts it in range ----child lea evname(pc),a0 move.w #EvLink,d1 trap #0 dc.w FEvent bcs.w chfail move.l d0,d7 bsr chready move.l d7,d0 move.w #EvWait,d1 move.l #WAKEVAL,d2 move.l #WAKEVAL,d3 trap #0 dc.w FEvent bcs.w chfail move.l d1,d6 bra.w chdone* use verdict.i use fork.i use report.i*evname dc.b "cf42ev",0myname dc.b "t42evsigw",0idstr dc.b "RESULT t42 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0skipstr dc.b "SKIP",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  Ev$Signl wakes a waiting process and leaves its value behind",0 ends