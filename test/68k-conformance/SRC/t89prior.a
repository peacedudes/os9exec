* t89prior.a -- CONF68K test t89: F$ID reports the caller's own priority, and* F$SPrior changes it.** Claim (DOCS/claims.md): F$ID returns "the caller's process ID number, group* and user ID, and current process priority", in d0.w, d1.l and d2.w (F$ID,* page 1 - 38). F$SPrior takes a process ID in d0.w and a priority in d1.w* and "changes the process priority to the new value specified"; a process* may change its own (F$SPrior, page 1 - 54).** The process asks who it is, sets its own priority to 137 -- a value nothing* here hands out, so it cannot be the one it already had -- and asks again.* The ID must be the same and the priority must now be 137.** obs is 10 if the ID did not change, plus 1 if the priority came back 137: 11* when the claim holds. 10 means F$SPrior did not take, or F$ID does not* report the priority.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FID set $0CFSPrior set $0DNEWPRIOR set 137*EXPECT set 11* psect t89prior,Type_Lang,Attr_Rev,0,2048,startstart trap #0 dc.w FID bcs.w setuperr move.w d0,d7 moveq #0,d0 move.w d7,d0 move.w #NEWPRIOR,d1 trap #0 dc.w FSPrior bcs.w setuperr trap #0 dc.w FID bcs.w setuperr moveq #0,d6 cmp.w d7,d0 bne.s t89pr moveq #10,d6t89pr cmpi.w #NEWPRIOR,d2 bne.s t89v addq.l #1,d6t89v cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*idstr dc.b "RESULT t89 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  F$ID reports the caller's priority, and F$SPrior changes it",0 ends