* t11rewind.a -- CONF68K test t11: I$Seek to position zero.** Claim (DOCS/claims.md): I$Seek's FUNCTION text states directly that a* seek to address zero is the same as a rewind operation. So after reading* the whole file, seeking to 0 and reading again must return the file's* first byte.** The observed value is that byte, 65 ('A'), not an error code: the failure* this test is built to catch is a seek that reports success and leaves the* file pointer where it was, which no error-code check would see.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IRead set $89IWrite set $8AISeek set $88IClose set $8FIDelete set $87IGetStt set $8DSSSize set $02ATTRS set $001B*EXPECT set 65* psect t11rewind,Type_Lang,Attr_Rev,0,2048,startstart* Scratch buffer on the stack, never in the code psect: this module is* marked re-entrant and a real system may hold it in ROM, where a write* into its own body would fault rather than just be untidy. sub.l #128,a7 movea.l a7,a4 lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea data4(pc),a0 moveq #4,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #1,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7* read the file to its end movea.l a4,a0 moveq #4,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IRead bcs.w setuperr* rewind moveq #0,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w ISeek bcs.w setuperr* the next byte read must be the file's first movea.l a4,a0 moveq #1,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IRead bcs.w setuperr moveq #0,d6 move.b (a4),d6 cmpi.l #EXPECT,d6 beq.s ispass bra.s isfail* use verdict.i use report.i*fname dc.b "SCRATCH/t11.dat",0data4 dc.b "ABCD"idstr dc.b "RESULT t11 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  I$Seek to zero rewinds the path",0 ends