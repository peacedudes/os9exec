* t52memsp.a -- CONF68K test t52: F$Mem may not take the stack away.** Claim (DOCS/claims.md): F$Mem "can never return all of a process's memory,* or cause deallocation of memory at its current stack pointer", and* E$DelSP (223) is the code for a "user requested deallocation and return* of the memory where the user's stack is located", which the error table* says "could be caused, for example, by using the F$Mem system call to* contract the data memory".** Sixteen bytes is the smallest area the call can be asked for, and the* stack of any process that has just been entered sits far above it, so* the request is a contraction that would leave the stack pointer outside* the data area. The only right answer is to refuse it.** Success is the divergence here, so it is reported as FAIL with obs=0; an* error other than E$DelSP is reported as FAIL carrying that code.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FMem set $07*EXPECT set 223* psect t52memsp,Type_Lang,Attr_Rev,0,2048,startstart moveq #16,d0 trap #0 dc.w FMem bcs.s t52err moveq #0,d6 bra.w isfailt52err moveq #0,d6 move.w d1,d6 cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*idstr dc.b "RESULT t52 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  F$Mem contracting under the stack pointer reports E$DelSP",0 ends