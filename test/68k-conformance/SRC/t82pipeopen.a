* t82pipeopen.a -- CONF68K test t82: I$Open of a named pipe reaches the pipe* its creator made, and a pipe gives its bytes back in any size of piece.** Claim (DOCS/claims.md): "When accessing named pipes, I$Open searches for the* specified name through a linked list of named pipes ... If I$Open finds the* pipe, the path number returned refers to the same physical path allocated* when the pipe was created" (Operations on Pipes, page 4 - 12); "a process* can even arrange for a single pipe to have data sent to itself", and "data* does not have to be read out of the pipe in the same size sections in* which it was written" (Pipes, page 4 - 11).** One process creates /pipe/t82p, opens it a second time by name, writes* "ABCDEF" in one piece through the creating path, and reads it back through* the opened one as two bytes and then four. obs is 10 if the first read gave* "AB", plus 1 if the second gave "CDEF": 11. Before reading it asks SS_Ready* on the opened path: a system whose open made a separate, empty pipe would* otherwise block in the read forever and take the rest of the run with it,* so there the reads are skipped and obs is 0. One whose writes and reads had* to match scores 10. An open that does not find the pipe at all reports its* error code as the observation.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1ICreate set $83IOpen set $84IRead set $89IWrite set $8AIClose set $8FIGetStt set $8DSSReady set $01*EXPECT set 11* psect t82pipeopen,Type_Lang,Attr_Rev,0,2048,startstart sub.l #16,a7 movea.l a7,a4 lea pname(pc),a0 moveq #3,d0 moveq #0,d1 moveq #0,d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea pname(pc),a0 moveq #3,d0 trap #0 dc.w IOpen bcc.s t82opened* not finding the pipe by its name is the claim failing, not the setup moveq #0,d6 move.w d1,d6 bra.s t82onlyt82opened move.w d0,d5 lea data6(pc),a0 moveq #6,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d6 moveq #0,d0 move.w d5,d0 move.w #SSReady,d1 trap #0 dc.w IGetStt bcs.s t82fin movea.l a4,a0 moveq #2,d1 moveq #0,d0 move.w d5,d0 trap #0 dc.w IRead bcs.w setuperr cmpi.b #'A',(a4) bne.s t82b cmpi.b #'B',1(a4) bne.s t82b moveq #10,d6t82b movea.l a4,a0 moveq #4,d1 moveq #0,d0 move.w d5,d0 trap #0 dc.w IRead bcs.w setuperr cmpi.l #'CDEF',(a4) bne.s t82fin addq.l #1,d6t82fin moveq #0,d0 move.w d5,d0 trap #0 dc.w ICloset82only moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*pname dc.b "/pipe/t82p",0data6 dc.b "ABCDEF"idstr dc.b "RESULT t82 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  a named pipe opened by name is the creator's pipe",0 ends