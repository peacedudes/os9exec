* t27shar.a -- CONF68K test t27: a file opened for non-sharable use cannot* be opened by anybody else.** Claim (DOCS/claims.md): I$Open's access-mode table gives bit 6 as "open* file for non sharable use", and "If the single user bit is set, the file* is opened for non-sharable access even if the file is sharable." Page 7-8* covers what the second process then sees: "If the single-user bit is set,* only one process may open the file at a time. If another process attempts* to open the file, error (#253) is returned." E$Share, 253, is "NON-SHARABLE* FILE BUSY - The requested file or device has the single user bit set or it* was opened in single user mode and another process is accessing the* requested file."** The holder sets the bit in the ACCESS MODE rather than in the file's* attributes, which is the form the manual recommends for the common case:* "More commonly, a file needs to be non-sharable only during the execution* of a specific program." It also leaves nothing behind on the disk to clean* up, so a rerun is the same test as the first run.** Alone among the conflict tests here, the contended operation is an OPEN.* An open that must be refused cannot be an open that waits, so this one* reports a real verdict on any system, including one where a blocked* reader or writer would never be resumed -- which makes it the test most* likely to be informative on a system the rest of this file defeats.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IWrite set $8AIClose set $8FIDelete set $87ATTRS set $001BUPDATE set 3SINGLE set $43*EXPECT set 253* psect t27shar,Type_Lang,Attr_Rev,0,4096,startstart bsr ckrole tst.w d0 bne.w child* lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose bsr canlock bcc.s ready moveq #0,d6 move.w d1,d6 bra.w isskipready lea fname(pc),a0 moveq #SINGLE,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7* bsr contend bcs.w setuperr* moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail*child bsr chready lea fname(pc),a0 moveq #UPDATE,d0 trap #0 dc.w IOpen bcc.s chok moveq #0,d6 move.w d1,d6 bra.s chrepchok moveq #0,d6chrep bsr chsaw bra.w chdone* use verdict.i use fork.i use report.i*fname dc.b "SCRATCH/t27.dat",0myname dc.b "t27shar",0data50 dc.b "0123456789012345678901234567890123456789012345678" dc.b 13idstr dc.b "RESULT t27 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0skipstr dc.b "SKIP",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  a file opened single-user cannot be opened by another process",0 ends