* t10exists.a -- CONF68K test t10: I$Create naming a file that is already* in the directory.** Claim (DOCS/claims.md): I$Create's FUNCTION text states an error occurs* if the pathlist names a file that already exists, and the error-code* table assigns E$CEF (218) to exactly that condition.** Note the first create here is setup, not the assertion: it is preceded* by a delete so that a rerun starts from the same state. Without that,* every run after the first would find the file already present and report* the SETUP create as the failure.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IRead set $89IWrite set $8AISeek set $88IClose set $8FIDelete set $87IGetStt set $8DSSSize set $02ATTRS set $001B*EXPECT set 218* psect t10exists,Type_Lang,Attr_Rev,0,2048,startstart* Scratch buffer on the stack, never in the code psect: this module is* marked re-entrant and a real system may hold it in ROM, where a write* into its own body would fault rather than just be untidy. sub.l #128,a7 movea.l a7,a4 lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose* the file now exists: creating it again must fail lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcc.s t10ok moveq #0,d6 move.w d1,d6 bra.s t10jdgt10ok* it should not have succeeded; close the second path so the run does not* leak it, then report no-error as the observed value move.w d0,d7 moveq #0,d6 moveq #0,d0 move.w d7,d0 trap #0 dc.w ICloset10jdg cmpi.l #EXPECT,d6 beq.s ispass bra.s isfail** --- verdict tail, identical in every test ---* ERROR is not FAIL: it means this test could not establish the situation* it set out to check (its own create/open/write step failed), so it has no* standing to report a verdict on the claim. d6 carries the error code that* stopped it.* setuperr is where every failed create/open/write lands. It falls straight* through into iserror rather than branching to it -- the branch it replaces* was the one far jump whose distance grew with the body, so removing it* removes a per-test range problem instead of solving it twelve times.setuperr moveq #0,d6 move.w d1,d6iserror lea errstr(pc),a5 bra.s reportisfail lea failstr(pc),a5 bra.s reportispass lea passtr(pc),a5report lea idstr(pc),a0 bsr putstr movea.l a5,a0 bsr putstr lea obsstr(pc),a0 bsr putstr move.l d6,d2 bsr put6dec lea expstr(pc),a0 bsr putstr move.l #EXPECT,d2 bsr put6dec lea descstr(pc),a0 bsr putstr bsr putcr bra.w finish* use report.i*fname dc.b "SCRATCH/t10.dat",0idstr dc.b "RESULT t10 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  I$Create of an existing name reports E$CEF",0 ends