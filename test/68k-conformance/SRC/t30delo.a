* t30delo.a -- CONF68K test t30: a file that another process has open* cannot be deleted.** Claim (DOCS/claims.md): the error-code appendix entry for E$Share, 253,* says "NON-SHARABLE FILE BUSY - The requested file or device has the single* user bit set or it was opened in single user mode and another process is* accessing the requested file. A common way to get this error is to attempt* to delete a file that is currently open." I$Delete's own description adds* that the caller "must have non-sharable write access to the file".** Like t27 the contended operation cannot block -- a delete that must be* refused is not a delete that waits -- so this reports a real verdict even* on a system where a blocked reader or writer is never resumed. Unlike t27* the holder asks for nothing unusual: an ordinary update-mode open, which* is what makes this the case a program is most likely to meet by accident.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IRead set $89IWrite set $8AISeek set $88IClose set $8FIDelete set $87ATTRS set $001BUPDATE set 3*EXPECT set 253* psect t30delo,Type_Lang,Attr_Rev,0,4096,startstart bsr ckrole tst.w d0 bne.w child* lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #UPDATE,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7 bsr canlock bcc.s ready moveq #0,d6 move.w d1,d6 bra.w isskipready* bsr contend bcs.w setuperr* moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail*child bsr chready lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete bcc.s chok moveq #0,d6 move.w d1,d6 bra.s chrepchok moveq #0,d6chrep bsr chsaw bra.w chdone* use verdict.i use fork.i use report.i*fname dc.b "SCRATCH/t30.dat",0myname dc.b "t30delo",0data50 dc.b "0123456789012345678901234567890123456789012345678" dc.b 13idstr dc.b "RESULT t30 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0skipstr dc.b "SKIP",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  deleting a file another process holds open reports E$Share",0 ends