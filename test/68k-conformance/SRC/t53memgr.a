* t53memgr.a -- CONF68K test t53: F$Mem shrinks the data area and grows it back.** Claim (DOCS/claims.md): "F$Mem contracts or expands the process's data* memory area ... Additional memory is allocated contiguously upward* (towards higher addresses), or de-allocated downward from the old highest* address", the call returning the new size in d0.l and the new end (+1)* in (a1). The test gives back the top 4096 bytes of the area it was* forked with, checks that the top came down by exactly that much, asks for* its original size again, checks that the top is back where the fork put* it, and then writes to the last long word of the regained area and reads* it back: memory the kernel says the process owns must be usable.** WHY SHRINK FIRST.** The manual is explicit that an expansion "may return an error ... even* though adequate free memory exists, because the data area must always be* contiguous". Whether the memory above a process's data area happens to be* free is an accident of what else the system has allocated, and the first* version of this test -- expand only -- measured exactly that accident:* PASS when run by hand, SKIP when run from runall on a host-native* directory, PASS from an RBF image. Giving memory back first and asking* for it again makes the space above the area free by construction, so the* verdict is about the kernel and not about the neighbours.** The stack has to move out of the way before the contraction: at entry* the stack pointer sits directly under the parameter area at the very top,* and taking 4096 bytes off the top would take the memory at the stack* pointer with it, which is E$DelSP -- t52's claim, not this one. So the* stack pointer is first lowered by more than the contraction, into the* stack space the psect declares for that purpose, and everything below* it stays the program's.** E$NoRAM (237) and E$MemFul (207) on the second call are still SKIP* carrying the code -- a kernel that does not merge returned memory back* under the area could report them honestly -- and any other error on* either call is FAIL with its code, 208 (E$UnkSvc) being the answer of a* system without F$Mem. A top in the wrong place is FAIL with 2 after the* contraction and 3 after the expansion; a probe that reads back wrong is* FAIL with 1; a probe that faults ends the process before it prints and* shows as a MISSING line.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FMem set $07ENoRAM set 237EMemFul set 207*GROW set 4096STEP set GROW+64STACK set 8192PATTERN set $5A5AA5A5PROBEBAD set 1LOWBAD set 2HIGHBAD set 3*EXPECT set GROW* psect t53memgr,Type_Lang,Attr_Rev,0,STACK,startstart movea.l a1,a4 move.l d6,d7 suba.l #STEP,a7 move.l d7,d0 sub.l #GROW,d0 trap #0 dc.w FMem bcs.s t53err movea.l a4,a2 suba.l #GROW,a2 cmpa.l a2,a1 beq.s t53low movea.l a1,a3 move.l a3,d4 lea dlowx(pc),a3 move.l a2,d2 bsr.w detail lea dgot(pc),a3 move.l d4,d2 bsr.w detail moveq #LOWBAD,d6 bra.w isfailt53low move.l d7,d0 trap #0 dc.w FMem bcs.s t53noroom cmpa.l a4,a1 beq.s t53high move.l a1,d4 lea dhighx(pc),a3 move.l a4,d2 bsr.w detail lea dgot(pc),a3 move.l d4,d2 bsr.w detail moveq #HIGHBAD,d6 bra.w isfailt53high move.l #PATTERN,d2 move.l d2,-4(a1) cmp.l -4(a1),d2 beq.s t53probed moveq #PROBEBAD,d6 bra.w isfailt53probed move.l #GROW,d6 bra.w ispasst53noroom cmpi.w #ENoRAM,d1 beq.s t53skip cmpi.w #EMemFul,d1 beq.s t53skipt53err moveq #0,d6 move.w d1,d6 bra.w isfailt53skip moveq #0,d6 move.w d1,d6 lea skipstr(pc),a5 bra.w report* use verdict.i use report.i*idstr dc.b "RESULT t53 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0skipstr dc.b "SKIP",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  F$Mem gives back the top of the data area and regains it",0dlowx dc.b "shrunk: expected the top at",0dhighx dc.b "regrown: expected the top at",0dgot dc.b "F$Mem reported the top at",0 ends