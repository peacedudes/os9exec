* t107fdivz.a -- CONF68K test t107: 5.0 divided by 0.0 on the 68881 is +infinity.** Claim (DOCS/claims.md): with the divide-by-zero exception disabled, which* is the FPU's reset state, a finite value divided by zero delivers an* infinity of the right sign and sets the condition code I (M68000 Family* Programmer's Reference, FDIV; IEEE 754). Digit 1: the double stored is* $7FF00000 00000000. Digit 2: FPSR's I bit (bit 25) is set.** WHY: BASIC09 under math881 relies on this to report x/0 as an error. An* emulator that got it wrong printed 2. for 5./0. -- so this is checked on* real hardware rather than assumed.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FSTrap set $0ET_LINEF set $2CEXPECT set 11 psect t107fdivz,Type_Lang,Attr_Rev,0,2048,startstart moveq #0,d0 movea.l d0,a0 lea exctbl(pc),a1 trap #0 dc.w FSTrap bcs.w setuperr moveq #0,d6 subq.l #8,a7 movea.l a7,a2 lea five(pc),a0 dc.w $F210,$5400 lea zero(pc),a1 dc.w $F211,$5420 dc.w $F212,$7400 mulu #10,d6 cmpi.l #$7FF00000,(a2) bne.s c1 cmpi.l #0,4(a2) bne.s c1 addq.l #1,d6c1 dc.w $F200,$A800 mulu #10,d6 btst #25,d0 beq.s c9 addq.l #1,d6c9 cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* No FPU and no FPU emulation: the first FPU instruction is a line-F trap.* That system cannot exercise the claim, which is a SKIP, not a failure.exctbl dc.w T_LINEF,nofpu-*-4 dc.w -1nofpu* the digits scored before the trap, from the saved d6 (R$d6, 24(a5)),* so a partial FPU -- a 68040 or 68060 with no FPSP -- shows how far it got move.l 24(a5),d6 lea skipstr(pc),a5 bra.w report use verdict.i use report.i alignfive dc.l $40140000,0zero dc.l 0,0idstr dc.b "RESULT t107 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0skipstr dc.b "SKIP",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  a 68881 divide by zero gives +infinity and sets I",0 ends