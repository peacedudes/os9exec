* t08seekeof.a -- CONF68K test t08: I$Seek beyond the end of a file, then* read instead of write.** Claim (DOCS/claims.md): the same I$Seek passage that permits a seek past* the end states that reads there return an end-of-file condition, and* that seeking alone never allocates anything. So a read at position 1000* of a 4-byte file must report E$EOF (211).** This is the other half of t07: together they establish that a seek past* the end commits to nothing by itself, and that it is the write, not the* seek, that grows the file.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IRead set $89IWrite set $8AISeek set $88IClose set $8FIDelete set $87IGetStt set $8DSSSize set $02ATTRS set $001B*EXPECT set 211* psect t08seekeof,Type_Lang,Attr_Rev,0,2048,startstart* Scratch buffer on the stack, never in the code psect: this module is* marked re-entrant and a real system may hold it in ROM, where a write* into its own body would fault rather than just be untidy. sub.l #128,a7 movea.l a7,a4 lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea data4(pc),a0 moveq #4,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7* seek well past the 4 bytes this file holds move.l #1000,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w ISeek bcs.w setuperr* reading there must report end of file movea.l a4,a0 moveq #4,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IRead bcc.s t08ok moveq #0,d6 move.w d1,d6 bra.s t08jdgt08ok moveq #0,d6t08jdg cmpi.l #EXPECT,d6 beq.s ispass bra.s isfail** --- verdict tail, identical in every test ---* ERROR is not FAIL: it means this test could not establish the situation* it set out to check (its own create/open/write step failed), so it has no* standing to report a verdict on the claim. d6 carries the error code that* stopped it.* setuperr is where every failed create/open/write lands. It falls straight* through into iserror rather than branching to it -- the branch it replaces* was the one far jump whose distance grew with the body, so removing it* removes a per-test range problem instead of solving it twelve times.setuperr moveq #0,d6 move.w d1,d6iserror lea errstr(pc),a5 bra.s reportisfail lea failstr(pc),a5 bra.s reportispass lea passtr(pc),a5report lea idstr(pc),a0 bsr putstr movea.l a5,a0 bsr putstr lea obsstr(pc),a0 bsr putstr move.l d6,d2 bsr put6dec lea expstr(pc),a0 bsr putstr move.l #EXPECT,d2 bsr put6dec lea descstr(pc),a0 bsr putstr bsr putcr bra.w finish* use report.i*fname dc.b "SCRATCH/t08.dat",0data4 dc.b "ABCD"idstr dc.b "RESULT t08 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  a read at a position past EOF reports E$EOF",0 ends