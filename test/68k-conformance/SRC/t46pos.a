* t46pos.a -- CONF68K test t46: I$GetStt SS_Pos on an SCF path.** Claim (DOCS/claims.md): SS_Pos is a GetStat of RBF and PIPE. A file manager* that does not implement a given status code reports E$UnkSvc -- the same* principle t32 checks from the SetStat side -- and NOT E$BMode, which means* the path was opened in the wrong access mode and says something else* entirely about why the call failed.** /nil is used for the same reason t32 uses it: it is an SCF device on any* system that has one, it holds no data, and the claim reads identically on a* host directory and on an RBF image, so this test does not SKIP.** The distinction this test respects: it asserts the ERROR CODE, not that* SS_Pos is unavailable. A system that chooses to answer SS_Pos on a character* device reports 0 here and FAILs, which is the right outcome to look at --* the manual scopes SS_Pos to RBF and PIPE, and a third answer is news.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84IGetStt set $8DIClose set $8FSSPos set $0005*EXPECT set 208* psect t46pos,Type_Lang,Attr_Rev,0,2048,startstart lea nilname(pc),a0 moveq #3,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7 moveq #0,d6 moveq #0,d0 move.w d7,d0 move.w #SSPos,d1 trap #0 dc.w IGetStt bcc.s noerror move.w d1,d6noerror moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose cmpi.l #EXPECT,d6 beq.s ispass bra.s isfail* use verdict.i use report.i*nilname dc.b "/nil",0idstr dc.b "RESULT t46 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  SS_Pos on an SCF path reports E$UnkSvc, not E$BMode",0 ends