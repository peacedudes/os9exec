* t93readln.a -- CONF68K test t93: I$ReadLn stops at the end-of-line* character, and the character is part of what it read.** Claim (DOCS/claims.md): "ReadLn is similar to Read except it reads data* from the input file or device until an end-of-line character is* encountered", it returns "d1.l = Actual number of bytes read", and "after* all data in a file has been read, the next I$ReadLn service request* returns an end of file error" (I$ReadLn, page 2 - 19); E$EOF is 211* (error-code appendix, page Error Codes - 5).** The file holds two three-byte lines, "AB" and "CD", each ended by CR. A* 64-byte ReadLn must come back with 3 -- not 6, which is what a system* reading past the end of the line gives, and not 2, which is what one* dropping the terminator gives. The second call must give 3 again, which a* system that stopped at the first CR for good cannot do, and the third must* report 211.** obs is 100 for the first count, plus 10 for the second, plus 1 for the* end-of-file code: 111.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1ICreate set $83IOpen set $84IWrite set $8AIReadLn set $8BIClose set $8FIDelete set $87ATTRS set $001BEEOF set 211*EXPECT set 111* psect t93readln,Type_Lang,Attr_Rev,0,2048,startstart sub.l #128,a7 movea.l a7,a4 lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea twolines(pc),a0 moveq #6,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose* lea fname(pc),a0 moveq #1,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7 moveq #0,d6** first line movea.l a4,a0 moveq #64,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IReadLn bcs.s t93two cmpi.l #3,d1 bne.s t93two moveq #100,d6* second linet93two movea.l a4,a0 moveq #64,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IReadLn bcs.s t93eof cmpi.l #3,d1 bne.s t93eof addi.l #10,d6* nothing leftt93eof movea.l a4,a0 moveq #64,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IReadLn bcc.s t93done cmpi.w #EEOF,d1 bne.s t93done addq.l #1,d6t93done moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*fname dc.b "SCRATCH/t93.dat",0twolines dc.b "AB",$0D,"CD",$0D dc.b 0idstr dc.b "RESULT t93 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  I$ReadLn stops at the end-of-line character",0 ends