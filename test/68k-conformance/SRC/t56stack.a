* t56stack.a -- CONF68K test t56: an F$STrap handler runs on the stack* F$STrap was given.** Claim (DOCS/claims.md): F$STrap takes in a0 the stack to use when an* exception occurs, zero meaning the stack in use at the time.** A handler that relies on that can go back to the interrupted program's own* stack, call ordinary routines there, and still find its register image* intact at (a5) afterwards. GNU Oleo's run-time does exactly that: it* installs its handlers with a stack of their own, and inside the handler it* switches to the program's stack, signals itself, and then restores the* image. A system that builds the image just below the program's stack* pointer and ignores the stack it was given lets those calls overwrite it.** The test passes a stack 1024 bytes below its entry stack pointer, carries* that address to the handler in d5 (read back from the image, R$d5(a5)),* raises TRAPV, and checks from inside the handler that a7 lies on the given* stack: at or below it, and within 256 bytes, which leaves room for a* register image with or without floating-point state. obs is 0 when it* does, 1 when it does not, and 8 if TRAPV never reached the handler.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1*FSTrap set $0ET_TRAPV set $1CRD5 set $14VBIT set 2SLACK set 256*EXPECT set 0* psect t56stack,Type_Lang,Attr_Rev,0,2048,startstart lea -1024(a7),a0 move.l a0,d5 lea exctbl(pc),a1 trap #0 dc.w FSTrap bcs.w setuperr ori #VBIT,ccr trapv moveq #8,d6 bra.w isfail*exctbl dc.w T_TRAPV,handler-*-4 dc.w -1*handler move.l RD5(a5),d0 move.l a7,d1 move.l d0,d4 move.l d1,d7 moveq #1,d6 cmp.l d0,d1 bhi.s judge sub.l d1,d0 cmpi.l #SLACK,d0 bhi.s judge moveq #0,d6judge cmpi.l #EXPECT,d6 beq.w ispass lea dgiven(pc),a3 move.l d4,d2 bsr.w detail lea dsp(pc),a3 move.l d7,d2 bsr.w detail bra.w isfail* use verdict.i use report.i*idstr dc.b "RESULT t56 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  an F$STrap handler runs on the stack F$STrap was given",0dgiven dc.b "F$STrap was given the stack",0dsp dc.b "the handler ran with a7 at",0 ends