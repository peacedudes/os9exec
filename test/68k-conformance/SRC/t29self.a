* t29self.a -- CONF68K test t29: one process holding two paths to the same* file does not lock itself out.** Claim (DOCS/claims.md): "Only one portion of a file may be locked out at* one time. If an application requires more than one record to be locked* out, multiple paths to the same file may be opened with each path having* its own record locked out. RBF notices that the same process owns both* paths and keeps them from locking each other out" (Technical Manual, page* 7-8). So a read through one path and a write through another, from the* SAME process, must not conflict.** This is the exemption every other test in this group depends on being* real: it is the reason none of them can be written as a single process,* and the reason each one has to fork. It is worth checking rather than* assuming, because a system that lost it would not fail loudly -- it would* deadlock a program against itself, which looks like the program hanging.** Both paths are opened by the CHILD, not the parent, even though no second* process is needed for the claim. That is purely so the parent can rescue* it: a process that locks itself out has nobody to release it, and this is* the one test here whose failure mode would otherwise be an unrecoverable* hang rather than a verdict.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IRead set $89IWrite set $8AISeek set $88IClose set $8FIDelete set $87ATTRS set $001BUPDATE set 3*EXPECT set 0* psect t29self,Type_Lang,Attr_Rev,0,4096,startstart bsr ckrole tst.w d0 bne.w child* lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #UPDATE,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7 bsr canlock bcc.s ready moveq #0,d6 move.w d1,d6 bra.w isskipready* bsr contend bcs.w setuperr* moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail*child* Two paths to the same file, BOTH from this one process. d5 holds the path* that takes the lock, d7 the one that then tries to write through it --* d7 because chticks applies to whichever path might have to wait. lea fname(pc),a0 moveq #UPDATE,d0 trap #0 dc.w IOpen bcs.w chfail move.w d0,d5 lea fname(pc),a0 moveq #UPDATE,d0 trap #0 dc.w IOpen bcs.w chfail move.w d0,d7 bsr chticks bcs.w chfail clr.l d1 moveq #0,d0 move.w d5,d0 trap #0 dc.w ISeek bcs.w chfail sub.l #128,a7 movea.l a7,a4 movea.l a4,a0 moveq #50,d1 moveq #0,d0 move.w d5,d0 trap #0 dc.w IRead bcs.w chfail clr.l d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w ISeek bcs.w chfail bsr chready lea data50(pc),a0 moveq #10,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcc.s chok moveq #0,d6 move.w d1,d6 bra.s chrepchok moveq #0,d6chrep bsr chsaw bra.w chdone* use verdict.i use fork.i use report.i*fname dc.b "SCRATCH/t29.dat",0myname dc.b "t29self",0data50 dc.b "0123456789012345678901234567890123456789012345678" dc.b 13idstr dc.b "RESULT t29 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0skipstr dc.b "SKIP",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  two paths held by one process do not lock each other out",0 ends