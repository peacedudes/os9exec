* t59rename.a -- CONF68K test t59: rewriting a directory entry with a new* name renames the file.** Claim (DOCS/claims.md): a directory file is an integral number of 32-byte* entries, each a 28-byte name with the sign bit set on its last character* followed by the LSN of the file's FD sector (Technical Manual, Directory* File Format, page 7 - 5), and I$Open opens a directory file when mode bit 7* is set, with the read and write bits granting read and write access* (I$Open, page 2 - 16). A directory opened for update can therefore be read* to an entry and that entry written back spelt differently, and the file is* then found under the new name and not the old one. Microware's C library* rename() and utilities such as move rename this way.** The second half renames again changing only the case of the name, then* looks for an entry spelt exactly that way. The name is stored as written,* so the new spelling must be what the directory now holds; rewriting that* entry unchanged must also succeed.** obs is 0 when all of it holds. Otherwise it is the error code of the step* that was refused, 1 if the old name still opens, or 2 if no entry carries* the new spelling. A system that refuses writes to a directory reports the* error the write gave -- E$BMode (203) on os9exec's host-native directories* until 2026-09-14.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IRead set $89IWrite set $8AISeek set $88IClose set $8FIDelete set $87ATTRS set $001BDIRUPD set $83*EXPECT set 0* psect t59rename,Type_Lang,Attr_Rev,0,2048,startstart* the entry buffer lives on the stack, never in this re-entrant module sub.l #128,a7 movea.l a7,a4* start clean: no name may be left over from an earlier run lea oldname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea newname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea oldname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose* rename t59old to t59new by rewriting its entry lea oldpat(pc),a1 lea newpat(pc),a2 bsr.w ren beq.s t59a tst.l d3 beq.s t59se move.l d4,d6 bra.s t59jdgt59se move.l d4,d1 bra.w setuperrt59a* it must open under the new name lea newname(pc),a0 moveq #1,d0 trap #0 dc.w IOpen bcc.s t59b moveq #0,d6 move.w d1,d6 bra.s t59jdgt59b move.w d0,d7 moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose* and no longer under the old one lea oldname(pc),a0 moveq #1,d0 trap #0 dc.w IOpen bcs.s t59c move.w d0,d7 moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose moveq #1,d6 bra.s t59jdgt59c* change only the case of the name lea newpat(pc),a1 lea uppat(pc),a2 bsr.s ren beq.s t59d tst.l d3 beq.s t59se move.l d4,d6 bra.s t59jdgt59d* the entry must now be spelt in upper case; writing it back unchanged is* accepted lea uppat(pc),a1 lea uppat(pc),a2 bsr.s ren beq.s t59ok tst.l d3 bne.s t59we moveq #2,d6 bra.s t59jdgt59we move.l d4,d6 bra.s t59jdgt59ok moveq #0,d6t59jdg lea upname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail** ren -- open SCRATCH for update, read to the entry spelt as the six bytes at* (a1), seek back to it and write it spelt as the six bytes at (a2).* Returns with Z set when that worked. Otherwise d4 is the error code, and d3* is 1 when it was the WRITE that was refused, 0 for anything before it* (including no such entry, which reads to end of file).ren moveq #0,d3 moveq #0,d4 lea dirname(pc),a0 moveq #0,d0 move.b #DIRUPD,d0 trap #0 dc.w IOpen bcs.s renerr move.w d0,d7 moveq #0,d5renrd moveq #0,d0 move.w d7,d0 movea.l a4,a0 moveq #32,d1 trap #0 dc.w IRead bcs.s renfail movea.l a4,a0 movea.l a1,a3 moveq #5,d2rencmp cmpm.b (a0)+,(a3)+ bne.s rennext dbra d2,rencmp moveq #0,d0 move.w d7,d0 move.l d5,d1 trap #0 dc.w ISeek bcs.s renfail movea.l a4,a0 movea.l a2,a3 moveq #5,d2rencpy move.b (a3)+,(a0)+ dbra d2,rencpy moveq #1,d3 moveq #0,d0 move.w d7,d0 movea.l a4,a0 moveq #32,d1 trap #0 dc.w IWrite bcs.s renfail bra.s rencloserennext addi.l #32,d5 bra.s renrdrenfail move.w d1,d4renclose moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose tst.l d4 rtsrenerr move.w d1,d4 tst.l d4 rts* use verdict.i use report.i*dirname dc.b "SCRATCH",0oldname dc.b "SCRATCH/t59old",0newname dc.b "SCRATCH/t59new",0upname dc.b "SCRATCH/T59NEW",0oldpat dc.b "t59ol",$E4newpat dc.b "t59ne",$F7uppat dc.b "T59NE",$D7idstr dc.b "RESULT t59 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  a directory entry rewritten with a new name renames the file",0 ends