* t06short.a -- CONF68K test t06: I$Read asking for more than the file* holds.** Claim (DOCS/claims.md): I$Read's FUNCTION text states that if there is* not enough data to satisfy the request, fewer bytes are read than were* asked for and an end-of-file error is NOT returned. So a 64-byte read of* a 4-byte file must succeed and report 4 bytes actually read.** The observed value here is a byte count rather than an error code, which* is the point: a system that returned E$EOF instead would look correct to* anyone testing only for "did the read fail", and wrong to this test.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IRead set $89IWrite set $8AISeek set $88IClose set $8FIDelete set $87IGetStt set $8DSSSize set $02ATTRS set $001B*EXPECT set 4* psect t06short,Type_Lang,Attr_Rev,0,2048,startstart* Scratch buffer on the stack, never in the code psect: this module is* marked re-entrant and a real system may hold it in ROM, where a write* into its own body would fault rather than just be untidy. sub.l #128,a7 movea.l a7,a4 lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea data4(pc),a0 moveq #4,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #1,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7* ask for 64 bytes from a 4-byte file movea.l a4,a0 moveq #64,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IRead bcs.s t06err move.l d1,d6 bra.s t06jdgt06err* an error here IS the failure this test looks for, so report it as the* observed value rather than as ERROR -- E$EOF (211) is exactly the wrong* answer the manual rules out, not a setup problem. moveq #0,d6 move.w d1,d6t06jdg cmpi.l #EXPECT,d6 beq.s ispass bra.s isfail* use verdict.i use report.i*fname dc.b "SCRATCH/t06.dat",0data4 dc.b "ABCD"idstr dc.b "RESULT t06 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  I$Read of more bytes than remain returns a short count",0 ends