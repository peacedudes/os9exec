* t40evpuls.a -- CONF68K test t40: a pulse leaves the event value where it* found it.** Claim (DOCS/claims.md): Ev$Pulse "signals an event occurrence, but differs* from Ev$Signl.  The event variable is set to the value passed in d2, and the* signal auto-increment is not applied.  Then, the Ev$Signl search routine is* executed and the original event value is restored." (page 1-25)** Single process, so the event queue is empty and the search finds nobody.* That is what isolates the last clause: with no process to wake, the whole* observable effect of the call must be no effect at all.  Every wrong answer* is a different number, which is why the three constants are far apart:**   999   the pulsed value was left behind -- the search ran but the restore*         did not*   105   the call was treated as an Ev$Signl and applied the signal*         auto-increment, which the manual says a pulse does not*   an error code   the call was refused outright** wInc is 0 deliberately.  The search applies the wait auto-increment as it* wakes each process, so with nobody to wake it cannot fire here -- but the* manual does not say what a pulse leaves behind if it ever did, and a test* should not need that question settled to be trusted.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FEvent set $53EvCreat set 2EvUnLnk set 1EvDelet set 3EvRead set 6EvPulse set 9*INITVAL set 100WAITINC set 0SIGINC set 5PULSVAL set 999EXPECT set 100* psect t40evpuls,Type_Lang,Attr_Rev,0,2048,startstart lea evname(pc),a0 move.l #INITVAL,d0 move.w #EvCreat,d1 move.w #WAITINC,d2 move.w #SIGINC,d3 trap #0 dc.w FEvent bcs.w setuperr move.l d0,d5* move.l d5,d0 move.w #EvPulse,d1 move.l #PULSVAL,d2 trap #0 dc.w FEvent bcc.s pulseok* Refusing the call IS the failure this test exists for -- report the error* code as the observation rather than calling it a setup error.  os9exec* answered E$UnkSvc here until the event queue was built. moveq #0,d6 move.w d1,d6 bra.w isfailpulseok move.l d5,d0 move.w #EvRead,d1 trap #0 dc.w FEvent bcs.w setuperr move.l d1,d6* move.l d5,d0 move.w #EvUnLnk,d1 trap #0 dc.w FEvent lea evname(pc),a0 move.w #EvDelet,d1 trap #0 dc.w FEvent* cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*evname dc.b "cf40ev",0idstr dc.b "RESULT t40 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  Ev$Pulse restores the original event value",0 ends