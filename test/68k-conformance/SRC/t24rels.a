* t24rels.a -- CONF68K test t24: SS_Lock with a size of zero releases a* whole-file lock.** Claim (DOCS/claims.md): "If 0 bytes are requested, all locks are removed* (Record Lock, EOF Lock, and File Lock)" (I$SetStt, SS_Lock), and the* file-lock entry names SS_Lock(0) first among the things that end it.** This is t23 with the release added, and it is the test that stops t23* being satisfiable by a system that simply never lets anything through.* The pair has to be read together: t23 alone says a lock can be taken,* t24 alone says a write can succeed, and only together do they say the* lock is a lock rather than a permanent refusal. The two differ by exactly* one call, so nothing else can account for the different outcome.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IWrite set $8AISeek set $88IClose set $8FIDelete set $87ISetStt set $8ESSLock set $11ATTRS set $001BUPDATE set 3*EXPECT set 0* psect t24rels,Type_Lang,Attr_Rev,0,4096,startstart bsr ckrole tst.w d0 bne.w child* lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #UPDATE,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7 bsr canlock bcc.s ready moveq #0,d6 move.w d1,d6 bra.w isskipready move.l #90,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w ISeek bcs.w setuperr moveq #0,d0 move.w d7,d0 move.w #SSLock,d1 moveq #-1,d2 trap #0 dc.w ISetStt bcs.w setuperr moveq #0,d0 move.w d7,d0 move.w #SSLock,d1 moveq #0,d2 trap #0 dc.w ISetStt bcs.w setuperr* bsr contend bcs.w setuperr* moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail*child lea fname(pc),a0 moveq #UPDATE,d0 trap #0 dc.w IOpen bcs.w chfail move.w d0,d7 bsr chticks bcs.w chfail move.l #0,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w ISeek bcs.w chfail bsr chready lea data50(pc),a0 moveq #10,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcc.s chok moveq #0,d6 move.w d1,d6 bra.s chrepchok moveq #0,d6chrep bsr chsaw bra.w chdone* use verdict.i use fork.i use report.i*fname dc.b "SCRATCH/t24.dat",0myname dc.b "t24rels",0data50 dc.b "0123456789012345678901234567890123456789012345678" dc.b 13idstr dc.b "RESULT t24 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0skipstr dc.b "SKIP",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  SS_Lock 0 releases every lock the path held",0 ends