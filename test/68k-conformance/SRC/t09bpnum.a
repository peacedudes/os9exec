* t09bpnum.a -- CONF68K test t09: I$Read quoting a path number that is* not open.** Claim (DOCS/claims.md): the error-code table defines E$BPNum (201) as a* path number that was too large or refers to a non-existent path, and says* it can occur whenever a path number is passed to an I/O call. I$Read* lists E$BPNum in its own POSSIBLE ERRORS.** The path number is obtained honestly rather than guessed: open a real* file, keep the number OS-9 assigned, close it, then read on that same* number. A hardcoded number could accidentally name a path the shell had* open, which would test nothing and might read from it.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IRead set $89IWrite set $8AISeek set $88IClose set $8FIDelete set $87IGetStt set $8DSSSize set $02ATTRS set $001B*EXPECT set 201* psect t09bpnum,Type_Lang,Attr_Rev,0,2048,startstart* Scratch buffer on the stack, never in the code psect: this module is* marked re-entrant and a real system may hold it in ROM, where a write* into its own body would fault rather than just be untidy. sub.l #128,a7 movea.l a7,a4 lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea data4(pc),a0 moveq #4,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #1,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7 moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose* d7 still holds the number of the path we just closed movea.l a4,a0 moveq #4,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IRead bcc.s t09ok moveq #0,d6 move.w d1,d6 bra.s t09jdgt09ok moveq #0,d6t09jdg cmpi.l #EXPECT,d6 beq.s ispass bra.s isfail* use verdict.i use report.i*fname dc.b "SCRATCH/t09.dat",0data4 dc.b "ABCD"idstr dc.b "RESULT t09 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  I$Read on a closed path number reports E$BPNum",0 ends