* t79sseof.a -- CONF68K test t79: SS_EOF tells a file path at its end from* one that is not.** Claim (DOCS/claims.md): I$GetStt SS_EOF, "Test for End of File (RBF, SCF,* PIPE)", returns d1.l = 0 when the path is not at end of file, and fails* with E$EOF when it is (I$GetStt SS_EOF, page 2 - 10, its output continued* on 2 - 11); the appendix gives E$EOF as 000:211.** A four-byte file: SS_EOF straight after opening must answer 0; after all* four bytes are read it must answer E$EOF. obs is 10 for the first, plus 1* for the second: 11. A system that always answers 0 scores 10; one that* always says end of file scores 1.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IRead set $89IWrite set $8AIClose set $8FIDelete set $87IGetStt set $8DSSEOF set $06EEOF set 211ATTRS set $001B*EXPECT set 11* psect t79sseof,Type_Lang,Attr_Rev,0,2048,startstart sub.l #128,a7 movea.l a7,a4 lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea data4(pc),a0 moveq #4,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #1,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7 moveq #0,d6* at the start: not end of file moveq #0,d0 move.w d7,d0 move.w #SSEOF,d1 trap #0 dc.w IGetStt bcs.s t79rd tst.l d1 bne.s t79rd moveq #10,d6* read all four bytes, then ask againt79rd movea.l a4,a0 moveq #4,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IRead bcs.w setuperr moveq #0,d0 move.w d7,d0 move.w #SSEOF,d1 trap #0 dc.w IGetStt bcc.s t79fin cmpi.w #EEOF,d1 bne.s t79fin addq.l #1,d6t79fin moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*fname dc.b "SCRATCH/t79.dat",0data4 dc.b "ABCD"idstr dc.b "RESULT t79 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  SS_EOF answers 0 before the end of a file and E$EOF at it",0 ends