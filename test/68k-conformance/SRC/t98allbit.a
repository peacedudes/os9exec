* t98allbit.a -- CONF68K test t98: F$AllBit sets the bits it is given and* F$DelBit clears them, in the caller's own map.** Claim (DOCS/claims.md): F$AllBit "sets bits in the allocation map", taking* the first bit in d0.w, a count in d1.w and the map in (a0), with bits* numbered 0 to n-1 (F$AllBit, page 1 - 5); F$DelBit is the same call for* clearing them (page 1 - 5, SEE ALSO, and the shared description of the* three elementary operations). "If the bit is set, the block is in use. If* the bit is clear, the block is available."** t97 asks what F$SchBit makes of the map; this asks what is actually IN it,* which is the half a search can agree with while writing nothing. Whole* bytes are used throughout, so the answer does not depend on which end of a* byte bit 0 is -- a thing the page does not say and this suite does not* invent.** obs is 100 if allocating the first 8 bits fills exactly the first byte,* plus 10 if allocating the next 8 fills the second and leaves the rest* alone, plus 1 if freeing all 16 empties them again: 111.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FAllBit set $13FDelBit set $14*EXPECT set 111* psect t98allbit,Type_Lang,Attr_Rev,0,2048,startstart sub.l #16,a7 movea.l a7,a4 clr.l 0(a4) moveq #0,d6* moveq #0,d0 moveq #8,d1 movea.l a4,a0 trap #0 dc.w FAllBit bcc.s t98one moveq #0,d6 move.w d1,d6 bra.w t98vt98one cmpi.b #$FF,0(a4) bne.s t98two cmpi.b #0,1(a4) bne.s t98two moveq #100,d6*t98two moveq #8,d0 moveq #8,d1 movea.l a4,a0 trap #0 dc.w FAllBit bcs.s t98del cmpi.b #$FF,0(a4) bne.s t98del cmpi.b #$FF,1(a4) bne.s t98del cmpi.b #0,2(a4) bne.s t98del addi.l #10,d6*t98del moveq #0,d0 moveq #16,d1 movea.l a4,a0 trap #0 dc.w FDelBit bcs.s t98v cmpi.b #0,0(a4) bne.s t98v cmpi.b #0,1(a4) bne.s t98v addq.l #1,d6t98v cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*idstr dc.b "RESULT t98 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  F$AllBit sets the bits it is given, F$DelBit clears them",0 ends