* run.a -- run the whole CONF68K suite with no shell.** runall is a procedure file, so it needs a shell, and the shell is* Microware's: an emulator started with only this disk -- os9exec on* Windows, the browser build, anyone with no OS-9 system disk -- had no* way to run the suite at all. This module does what runall says without* one. It reads runall itself, so the list of tests stays in one place:* each line's first word is a module to run, with its output appended to* RESULTS/report, and the tally line runs last with its output on the* screen. "set" lines and comments are skipped.** On an OS-9 system with a shell, runall does exactly the same and is* still the documented way; this is for everywhere else:**    os9exec -r /dd/CMDS/run        with OS9DISK naming conf68k.dsk** The screen shows one dot per test, a note for any test that could not be* started or ended with an error, and then tally's verdict.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FFork set $03FWait set $04FExit set $06IDup set $82ICreate set $83IOpen set $84ISeek set $88IWrite set $8AIReadLn set $8BIGetStt set $8DIClose set $8FSSSize set $02EPNNF set 216LINESZ set 256* psect run,Type_Lang,Attr_Rev,0,4096,start vsectline ds.b LINESZlistp ds.w 1repp ds.w 1outp ds.w 1numbuf ds.b 8 endsstart* the list of tests: runall, in the data directory lea lname(pc),a0 moveq #1,d0 trap #0 dc.w IOpen bcs.w nolist move.w d0,listp(a6)* the report, created if need be, written from its end lea rname(pc),a0 moveq #2,d0 trap #0 dc.w IOpen bcc.s gotrep cmpi.w #EPNNF,d1 bne.w norep lea rname(pc),a0 moveq #2,d0 move.w #$1B,d1 trap #0 dc.w ICreate bcs.w norepgotrep move.w d0,repp(a6) moveq #SSSize,d1 trap #0 dc.w IGetStt bcs.w norep move.l d2,d1 moveq #0,d0 move.w repp(a6),d0 trap #0 dc.w ISeek bcs.w norep* keep the screen, and put the report in its place as path 1: every* test started from here inherits it as its standard output moveq #1,d0 trap #0 dc.w IDup bcs.w norep move.w d0,outp(a6) moveq #1,d0 trap #0 dc.w IClose moveq #0,d0 move.w repp(a6),d0 trap #0 dc.w IDup*next moveq #0,d0 move.w listp(a6),d0 lea line(a6),a0 move.l #LINESZ,d1 trap #0 dc.w IReadLn bcs.w listdone lea line(a6),a1 move.b (a1),d0 cmpi.b #$0D,d0 beq.w next cmpi.b #' ',d0 beq.w next cmpi.b #'*',d0 beq.w next lea wset(pc),a2 bsr.w isword beq.w next lea wtally(pc),a2 bsr.w isword beq.w dotally* a test: started by name, its output going to the report bsr.w start1 bcs.w next lea dot(pc),a0 bsr.w say bra.w next** tally reports to the screen, and is the end of the rundotally bsr.w screen1 lea nl(pc),a0 bsr.w say bsr.w start1 bra.w finish*listdone bsr.w screen1 lea nl(pc),a0 bsr.w say bra.w finish** start1: fork the module named at line(a6), wait for it, and note on the* screen a failure to start it or an error it ended with. Carry set if it* could not be started.start1 lea line(a6),a0 lea parm(pc),a1 moveq #0,d0 moveq #0,d1 moveq #1,d2 moveq #3,d3 moveq #0,d4 trap #0 dc.w FFork bcs.s nostart move.w d0,d7 moveq #20,d6wait1 trap #0 dc.w FWait bcs.s waited cmp.w d7,d0 beq.s gotstat subq.w #1,d6 bne.s wait1 bra.s waitedgotstat tst.w d1 beq.s waited move.w d1,d5 lea nl(pc),a0 bsr.w say bsr.w sayname lea endmsg(pc),a0 bsr.w say moveq #0,d2 move.w d5,d2 bsr.w saynum lea nl(pc),a0 bsr.w saywaited andi.b #$FE,ccr rtsnostart move.w d1,d5 lea nl(pc),a0 bsr.w say lea cantmsg(pc),a0 bsr.w say bsr.w sayname lea errmsg(pc),a0 bsr.w say moveq #0,d2 move.w d5,d2 bsr.w saynum lea nl(pc),a0 bsr.w say ori.b #$01,ccr rts** screen1: give path 1 back to the screen, and let go of the report.* Both of the runner's paths to it are closed: a writer holding the file* keeps its record locked on an RBF disk, and tally, reading it next, then* waited for ever (measured, on the single-disk image; a host folder has* no locking and hid it).screen1 moveq #0,d0 move.w repp(a6),d0 trap #0 dc.w IClose moveq #1,d0 trap #0 dc.w IClose moveq #0,d0 move.w outp(a6),d0 trap #0 dc.w IDup rts** isword: Z set if the line at (a1) starts with the NUL-ended word at (a2)* followed by a space or its endisword movea.l a1,a3iswl move.b (a2)+,d0 beq.s iswend cmp.b (a3)+,d0 beq.s iswl rtsiswend move.b (a3),d0 cmpi.b #' ',d0 beq.s iswyes cmpi.b #$0D,d0 beq.s iswyes rtsiswyes moveq #0,d0 rts** say: write the NUL-ended string at (a0) to the screensay movea.l a0,a1 moveq #0,d1sayl tst.b (a1)+ beq.s saygo addq.l #1,d1 bra.s saylsaygo moveq #0,d0 move.w outp(a6),d0 trap #0 dc.w IWrite rts** sayname: write the line's first word, the module's namesayname lea line(a6),a0 movea.l a0,a1 moveq #0,d1sayn move.b (a1)+,d0 cmpi.b #' ',d0 beq.s saygo cmpi.b #$0D,d0 beq.s saygo addq.l #1,d1 bra.s sayn** saynum: write d2 in decimalsaynum lea numbuf(a6),a0 lea 6(a0),a1 moveq #0,d1snl divu #10,d2 swap d2 addi.b #'0',d2 move.b d2,-(a1) clr.w d2 swap d2 addq.l #1,d1 tst.l d2 bne.s snl movea.l a1,a0 bra.s saygo*nolist moveq #0,d7 move.w d1,d7 lea nolmsg(pc),a0 bra.s failmsgnorep moveq #0,d7 move.w d1,d7 lea normsg(pc),a0failmsg move.w #2,outp(a6) bsr.w say move.l d7,d2 bsr.w saynum lea nl(pc),a0 bsr.w say move.w d7,d1 trap #0 dc.w FExitfinish moveq #0,d1 trap #0 dc.w FExit*lname dc.b "runall",0rname dc.b "RESULTS/report",0wset dc.b "set",0wtally dc.b "tally",0parm dc.b $0Ddot dc.b ".",0nl dc.b $0D,0endmsg dc.b " ended with error ",0cantmsg dc.b "can't start ",0errmsg dc.b ", error ",0nolmsg dc.b "run: can't open runall here (chd to the suite first), error ",0normsg dc.b "run: can't write RESULTS/report, error ",0 ends