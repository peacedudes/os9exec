* t101gregor.a -- CONF68K test t101: F$Gregor undoes F$Julian, and the time* really is seconds since midnight.** Claim (DOCS/claims.md): F$Julian takes "d0.l = time (00hhmmss)" and* "d1.l = date (yyyymmdd)" and returns "d0.l = time (seconds since midnight)"* with "d1.l = Julian date" (F$Julian, page 1 - 40); F$Gregor takes exactly* those two back and returns the packed time and date again (F$Gregor,* page 1 - 37). The two pages are converses of each other, register for* register.** 17 May 1994 at 13:45:07 goes in. Two things are then true and both are* checked: the pair must come back unchanged -- a system whose two* conversions disagree fails here even if each looks sensible alone -- and* the intermediate must be 49507, which is 13*3600 + 45*60 + 7. That second* one is what makes this more than a round trip: a system that carried the* packed time through untouched would satisfy the round trip and fail this.** No epoch is assumed. The manual does fix one -- days since January 1,* 4713 B.C., rolling at midnight rather than noon -- but a test that pinned* the absolute Julian number would be testing our reading of that sentence* rather than the two calls, and t34 and t35 already pin the calendar itself* through date DIFFERENCES.** obs is 100 if the date came back, plus 10 if the time came back, plus 1 for* the seconds: 111.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FJulian set $20FGregor set $54GDATE set $07CA0511GTIME set $000D2D07GSECS set 49507*EXPECT set 111* psect t101gregor,Type_Lang,Attr_Rev,0,2048,startstart moveq #0,d6 move.l #GTIME,d0 move.l #GDATE,d1 trap #0 dc.w FJulian bcs.w setuperr move.l d0,d5 move.l d1,d4* move.l d5,d0 move.l d4,d1 trap #0 dc.w FGregor bcs.w setuperr cmpi.l #GDATE,d1 bne.s t101time moveq #100,d6t101time cmpi.l #GTIME,d0 bne.s t101secs addi.l #10,d6t101secs cmpi.l #GSECS,d5 bne.s t101v addq.l #1,d6t101v cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*idstr dc.b "RESULT t101 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  F$Gregor undoes F$Julian; the time is seconds since midnight",0 ends