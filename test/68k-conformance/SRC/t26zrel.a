* t26zrel.a -- CONF68K test t26: a write of no bytes at all releases EOF* lock.** Claim (DOCS/claims.md): "Any read or write of zero bytes releases any* record lock, EOF lock, or File lock" (Technical Manual, page 7-11), and* the Write entry on the same page repeats it: "a write of zero bytes* releases EOF lock and File lock."** This is the release half of t25, and it is the only documented way to put* down an EOF lock without giving up the position or closing the file --* the ordinary release rule, "until a read or write is performed that is not* at the end of the file", cannot apply to a process that intends to stay at* the end. A zero-length write is otherwise a no-op, which is exactly why a* system is likely to optimise it away and lose the release with it; that is* the failure this test is shaped to catch.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IWrite set $8AISeek set $88IClose set $8FIDelete set $87ATTRS set $001BUPDATE set 3*EXPECT set 0* psect t26zrel,Type_Lang,Attr_Rev,0,4096,startstart bsr ckrole tst.w d0 bne.w child* lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr bsr canlock bcc.s ready moveq #0,d6 move.w d1,d6 bra.w isskipready lea data50(pc),a0 moveq #0,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr* bsr contend bcs.w setuperr* moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail*child lea fname(pc),a0 moveq #UPDATE,d0 trap #0 dc.w IOpen bcs.w chfail move.w d0,d7 bsr chticks bcs.w chfail move.l #100,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w ISeek bcs.w chfail bsr chready lea data50(pc),a0 moveq #10,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcc.s chok moveq #0,d6 move.w d1,d6 bra.s chrepchok moveq #0,d6chrep bsr chsaw bra.w chdone* use verdict.i use fork.i use report.i*fname dc.b "SCRATCH/t26.dat",0myname dc.b "t26zrel",0data50 dc.b "0123456789012345678901234567890123456789012345678" dc.b 13idstr dc.b "RESULT t26 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0skipstr dc.b "SKIP",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  a write of zero bytes releases EOF lock",0 ends