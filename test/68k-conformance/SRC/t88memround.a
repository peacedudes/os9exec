* t88memround.a -- CONF68K test t88: F$Mem rounds a request up to a whole* allocation block.** Claim (DOCS/claims.md): F$Mem's "new size requested is rounded up to an even* memory allocation block (16 bytes in version 2.0)", it returns "the actual* size of new memory area in bytes" in d0.l and "a pointer to new end of data* segment (+1)" in (a1); with d0 zero it is an information request returning* the current upper bound and size (F$Mem, page 1 - 43).** The information request gives the size S and the end E, so the area begins* at E-S. Asking for S+1 -- one byte more, which cannot be a whole number of* 16-byte blocks -- must therefore give back a size that IS a multiple of 16,* is at least S+1, and an end exactly that far above the base.** obs is 100 if the size came back a multiple of 16, plus 10 if it is at* least what was asked for, plus 1 if the end matches the base plus the size:* 111. A system that handed back the request unrounded scores 11.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FMem set $07*EXPECT set 111* psect t88memround,Type_Lang,Attr_Rev,0,2048,startstart* what have we got now? moveq #0,d0 trap #0 dc.w FMem bcs.w setuperr move.l d0,d7 movea.l a1,a3* the base of the area: end minus size suba.l d7,a3* one byte more than we have move.l d7,d0 addq.l #1,d0 move.l d0,d5 trap #0 dc.w FMem bcs.w setuperr moveq #0,d6 move.l d0,d4 move.l d4,d1 andi.l #15,d1 bne.s t88ge move.l #100,d6t88ge cmp.l d5,d4 blo.s t88end addi.l #10,d6t88end lea 0(a3,d4.l),a2 cmpa.l a1,a2 bne.s t88v addq.l #1,d6t88v cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*idstr dc.b "RESULT t88 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  F$Mem rounds a request up to a whole 16-byte block",0 ends