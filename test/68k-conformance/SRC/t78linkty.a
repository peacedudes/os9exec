* t78linkty.a -- CONF68K test t78: F$Link finds a module only when its type* and language match the ones asked for, 0 meaning any.** Claim (DOCS/claims.md): F$Link takes the "desired module type/language* byte (0 = any)" in d0.w and a name at (a0), and "causes OS-9 to search the* module directory for a module having a name, language, and type as given* in the parameters"; it returns the actual type/language in d0.w and lists* E$MNF among its errors (F$Link, page 1 - 41). The error appendix gives* E$MNF, 000:221, as a module not found in the module directory.** The module linked is this one, by its own name: a program ($01) in object* code ($01). Three links:*   type/language 0      any -- must succeed, reporting $0101 in d0.w*   type/language $0101  exactly this module -- must succeed*   type/language $0400  a data module -- no module has this name AND that*                        type, so it must fail with E$MNF* Every successful link is undone with F$UnLink. obs is 100 + 10 + 1 for the* three holding, 111; a system that matched on the name alone scores 110.* Asking for a type with its language left at 0 is not tested: the page does* not say how a partial match compares.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FLink set $00FUnLink set $02EMNF set 221*EXPECT set 111* psect t78linkty,Type_Lang,Attr_Rev,0,2048,startstart moveq #0,d6* any type lea myname(pc),a0 moveq #0,d0 trap #0 dc.w FLink bcs.s t78b move.w d0,d5 trap #0 dc.w FUnLink cmpi.w #Type_Lang,d5 bne.s t78b moveq #100,d6* exactly this typet78b lea myname(pc),a0 move.w #Type_Lang,d0 trap #0 dc.w FLink bcs.s t78c trap #0 dc.w FUnLink addi.l #10,d6* a type this name does not havet78c lea myname(pc),a0 move.w #$0400,d0 trap #0 dc.w FLink bcc.s t78wrong cmpi.w #EMNF,d1 bne.s t78v addq.l #1,d6 bra.s t78vt78wrong trap #0 dc.w FUnLinkt78v cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*myname dc.b "t78linkty",0idstr dc.b "RESULT t78 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  F$Link matches the type/language asked for, 0 meaning any",0 ends