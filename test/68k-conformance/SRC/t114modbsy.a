* t114modbsy.a -- CONF68K test t114: a module that is not re-entrant can be* linked by only one process at a time.** Claim (DOCS/claims.md): F$Link, "If the module requested is not re-entrant,* only one process may link to it at a time" (Technical Manual, page 1-41),* and the error appendix's E$ModBsy (209): "non-sharable module already in use* by another process". The parent makes a data module with M$Attr clear -- not* re-entrant -- and keeps its link; a forked copy of this module, told it is* the child by the one-byte parameter "C" (the fork.i convention), links it by* name and exits with what F$Link returned. obs is the child's exit status: 0* if the link was allowed, else its error. Expected 209.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FLink set $00FUnLink set $02FFork set $03FWait set $04FExit set $06FDatMod set $25EXPECT set 209 psect t114modbsy,Type_Lang,Attr_Rev,0,2048,startstart tst.l d5 beq.s parent cmpi.l #256,d5 bhi.s parent cmpi.b #'C',(a5) bne.s parent* the child: link the parent's module, and exit with what that gave lea mname(pc),a0 moveq #0,d0 trap #0 dc.w FLink bcs.s childout trap #0 dc.w FUnLink moveq #0,d1childout trap #0 dc.w FExitparent lea mname(pc),a0 moveq #16,d0 move.w #$0001,d1 move.w #$0333,d2 trap #0 dc.w FDatMod bcs.w setuperr movea.l a2,a3 moveq #0,d0 moveq #0,d1 moveq #1,d2 moveq #3,d3 moveq #0,d4 lea childpm(pc),a1 lea myname(pc),a0 trap #0 dc.w FFork bcs.s forkerr move.w d0,d5waitkid trap #0 dc.w FWait bcs.s forkerr cmp.w d5,d0 bne.s waitkid moveq #0,d6 move.w d1,d6 movea.l a3,a2 trap #0 dc.w FUnLink cmpi.l #EXPECT,d6 beq.w ispass bra.w isfailforkerr move.w d1,d4 movea.l a3,a2 trap #0 dc.w FUnLink move.w d4,d1 bra.w setuperr* use verdict.i use report.i*mname dc.b "t114nre",0myname dc.b "t114modbsy",0childpm dc.b "C",13idstr dc.b "RESULT t114 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0skipstr dc.b "SKIP",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  a module that is not re-entrant is linked by one process at a time",0 ends