* t77dup.a -- CONF68K test t77: I$Dup takes the lowest free path number,* and the two numbers share one path.** Claim (DOCS/claims.md): "I$Dup always uses the lowest available path* number. For example, if you do I$Close on path #0, then do I$Dup on path* #4, path #0 is returned as the new path number", and "service requests* using either the old or new path numbers operate on the same file or* device"; its CAVEATS add that the path descriptor "is NOT copied", only* its use count raised (I$Dup, page 2 - 9).** The manual's own example: open a file, close path 0, duplicate the file's* path -- the new number must be 0. Then read one byte through the ORIGINAL* number and one through the NEW one. One descriptor means one file* position, so the second read gets "B", not "A" again.** obs is 10 if the new number was 0, plus 1 if the second read got "B": 11* when the claim holds. 1 means a different number but a shared path; 10 a* path that was copied rather than shared.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IDup set $82IOpen set $84ICreate set $83IRead set $89IWrite set $8AIClose set $8FIDelete set $87ATTRS set $001B*EXPECT set 11* psect t77dup,Type_Lang,Attr_Rev,0,2048,startstart sub.l #128,a7 movea.l a7,a4 lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea data4(pc),a0 moveq #4,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #1,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7* free path 0, as in the manual's example (it may already be free) moveq #0,d0 trap #0 dc.w IClose moveq #0,d0 move.w d7,d0 trap #0 dc.w IDup bcs.w setuperr move.w d0,d5 moveq #0,d6 tst.w d5 bne.s t77rd moveq #10,d6* one byte through the original number: the file's firstt77rd movea.l a4,a0 moveq #1,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IRead bcs.w setuperr cmpi.b #'A',(a4) bne.s t77fin* one byte through the new number: the next one, if the path is shared movea.l a4,a0 moveq #1,d1 moveq #0,d0 move.w d5,d0 trap #0 dc.w IRead bcs.w setuperr cmpi.b #'B',(a4) bne.s t77fin addq.l #1,d6t77fin moveq #0,d0 move.w d5,d0 trap #0 dc.w IClose moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*fname dc.b "SCRATCH/t77.dat",0data4 dc.b "ABCD"idstr dc.b "RESULT t77 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  I$Dup takes the lowest free path number, and shares the path",0 ends