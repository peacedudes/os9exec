* t15evset.a -- CONF68K test t15: Ev$Set hands back the PREVIOUS value.** Claim (DOCS/claims.md): Ev$Set takes "d2.l = new event value" and its OUTPUT* is "d1.l = previous event value".  The value returned is the one the event* held before the call, not the one just installed -- which is what makes* Ev$Set usable as an atomic read-and-replace.** The two values are far apart and neither is zero, so a system that returned* the new value, or nothing at all, cannot coincide with the right answer.Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FEvent set $53EvCreat set 2EvUnLnk set 1EvDelet set 3EvWaitR set 5EvRead set 6EvInfo set 7EvSignl set 8EvSet set $0AEvSetR set $0B*INITVAL set 700NEWVAL set 900EXPECT set 700* psect t15evset,Type_Lang,Attr_Rev,0,2048,startstart lea evname(pc),a0 move.l #INITVAL,d0 move.w #EvCreat,d1 move.w #0,d2 move.w #1,d3 trap #0 dc.w FEvent bcs.w setuperr move.l d0,d5 move.l d5,d0 move.w #EvSet,d1 move.l #NEWVAL,d2 trap #0 dc.w FEvent bcs.w setuperr move.l d1,d6 move.l d5,d0 move.w #EvUnLnk,d1 trap #0 dc.w FEvent lea evname(pc),a0 move.w #EvDelet,d1 trap #0 dc.w FEvent cmpi.l #EXPECT,d6 beq.s ispass bra.s isfail* use verdict.i use report.i*evname dc.b "cf15ev",0idstr dc.b "RESULT t15 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  Ev$Set returns the value held before the call",0 ends