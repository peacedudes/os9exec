* t14evsignl.a -- CONF68K test t14: a broadcast Ev$Signl is still an Ev$Signl.** Claim (DOCS/claims.md): Ev$Signl takes "d1.w = MS bit set to activate all* processes in range / LS bits = 8".  The MS bit is a MODIFIER sharing the word* with the function code, so d1 = $8008 is the documented spelling of "signal,* waking everyone in range" -- not a different call.  It must behave as a* signal: the signal auto-increment is added to the event value.** Single-process, so nothing here observes the waking half of the flag; what it* pins down is that setting the bit does not stop the call being recognised.* os9exec dispatched on the whole word and answered $8008 with E$UnkSvc.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FEvent set $53EvCreat set 2EvDelet set 3EvWaitR set 5EvRead set 6EvInfo set 7EvSignl set 8EvSet set $0AEvSetR set $0B*INITVAL set 100SIGINC set 5EXPECT set 105* psect t14evsignl,Type_Lang,Attr_Rev,0,2048,startstart lea evname(pc),a0 move.l #INITVAL,d0 move.w #EvCreat,d1 move.w #0,d2 move.w #SIGINC,d3 trap #0 dc.w FEvent bcs.w setuperr move.l d0,d5* the broadcast spelling: function code with the all-processes bit set move.l d5,d0 move.w #$8000+EvSignl,d1 trap #0 dc.w FEvent bcc.s signalok* refusing the call IS the failure this test exists for -- report the error* code as the observation rather than calling it a setup error. moveq #0,d6 move.w d1,d6 bra.w isfailsignalok move.l d5,d0 move.w #EvRead,d1 trap #0 dc.w FEvent bcs.w setuperr move.l d1,d6 lea evname(pc),a0 move.w #EvDelet,d1 trap #0 dc.w FEvent cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*evname dc.b "cf14ev",0idstr dc.b "RESULT t14 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  Ev$Signl with the all-processes bit set still signals",0 ends