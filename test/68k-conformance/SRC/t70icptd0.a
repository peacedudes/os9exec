* t70icptd0.a -- CONF68K test t70: on entry to an intercept routine d0* holds the number of signals queued for the process, the one being* delivered included.** **Not Microware.** The v2.4 Technical Manual names only d1 (the signal* code) and a6 as set on entry (F$Icpt, page 1 - 39). The d0 count is given* by Peter Dibble, OS-9 Insights (3rd edition), 8.1 "An Undocumented* Feature": d0 is "the number of queued signals for that process", counting* the signal being delivered, so 1 means nothing else is waiting. Like t54,* this is a third party's word, recorded as such in DOCS/claims.md.** The same frame as t69: mask, send 300, 301 and 302 to itself, unmask. The* intercept routine records d0 on each of its first three calls, and the* queue drains one signal per call, so they should read 3, 2 and 1. obs is* 1000 x the calls made plus those three d0 values as digits: 3321. A* system that leaves d0 alone shows whatever the interrupted code had there.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FSend set $08FIcpt set $09FSleep set $0AFID set $0CFRTE set $1EFSigMask set $57* The counters are this process's static storage, the vsect after psect.* a6 points $8000 INTO the data area, so a small constant offset from it* (this test once used 0, 2, 4) lands 32K past the end of a 2K data area,* in whatever memory is next -- on real hardware as much as here.NSIG set 3EARLY set 50000*EXPECT set 3321* psect t70icptd0,Type_Lang,Attr_Rev,0,2048,start vsectCNT ds.w 1SIG1 ds.w 1SIG2 ds.w 1SIG3 ds.w 1 endsstart clr.w CNT(a6) clr.w SIG1(a6) clr.w SIG2(a6) clr.w SIG3(a6) lea sighand(pc),a0 trap #0 dc.w FIcpt bcs.w setuperr moveq #0,d0 moveq #1,d1 trap #0 dc.w FSigMask bcs.w setuperr trap #0 dc.w FID bcs.w setuperr move.w d0,d7 moveq #0,d0 move.w d7,d0 move.w #300,d1 trap #0 dc.w FSend bcs.w setuperr moveq #0,d0 move.w d7,d0 move.w #301,d1 trap #0 dc.w FSend bcs.w setuperr moveq #0,d0 move.w d7,d0 move.w #302,d1 trap #0 dc.w FSend bcs.w setuperr moveq #0,d6 tst.w CNT(a6) beq.s t70held move.l #EARLY,d6t70held moveq #0,d0 moveq #0,d1 trap #0 dc.w FSigMask bcs.w setuperr moveq #50,d5t70nap cmpi.w #NSIG,CNT(a6) bhs.s t70tally moveq #2,d0 trap #0 dc.w FSleep subq.w #1,d5 bne.s t70napt70tally moveq #0,d0 move.w CNT(a6),d0 mulu #1000,d0 add.l d0,d6 cmpi.w #NSIG,CNT(a6) bne.s t70verd moveq #0,d0 move.w SIG1(a6),d0 mulu #100,d0 add.l d0,d6 moveq #0,d0 move.w SIG2(a6),d0 mulu #10,d0 add.l d0,d6 moveq #0,d0 move.w SIG3(a6),d0 add.l d0,d6t70verd cmpi.l #EXPECT,d6 beq.w ispass lea dcnt(pc),a3 moveq #0,d2 move.w CNT(a6),d2 bsr.w detail lea dsig1(pc),a3 moveq #0,d2 move.w SIG1(a6),d2 bsr.w detail lea dsig2(pc),a3 moveq #0,d2 move.w SIG2(a6),d2 bsr.w detail lea dsig3(pc),a3 moveq #0,d2 move.w SIG3(a6),d2 bsr.w detail bra.w isfail** the intercept routine: note d0 on the first three calls, count every callsighand move.w d0,d7 move.w CNT(a6),d0 cmpi.w #NSIG,d0 bhs.s shdone add.w d0,d0 lea SIG1(a6),a1 move.w d7,0(a1,d0.w)shdone addq.w #1,CNT(a6) trap #0 dc.w FRTE* use verdict.i use report.i*idstr dc.b "RESULT t70 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  an intercept routine finds the queued-signal count in d0",0dcnt dc.b "intercepts that ran",0dsig1 dc.b "the first one's d0",0dsig2 dc.b "the second one's d0",0dsig3 dc.b "the third one's d0",0 ends