* t116wolock.a -- CONF68K test t116: a write-only path can lock the whole* file.** Claim (DOCS/claims.md): an INFERENCE, stated as one. I$SetStt SS_Lock* (Technical Manual, page 2-25) locks from the file pointer, or the whole* file for $FFFFFFFF, and names no access mode the path must have; the* update-mode rule (page 7-9) is about the automatic lock a READ takes.* nethack3, a released OS-9 port, locks its log this way at every quit.* This is t23 with the holder's path opened WRITE, not UPDATE. os9exec* once refused the lock E$FNA (214): a system that does shows it in obs,* and os9exec should then follow the hardware. Otherwise obs is what the* contender's write at 0 got, and a lock that holds makes that 252.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IWrite set $8AISeek set $88IClose set $8FIDelete set $87ISetStt set $8ESSLock set $11ATTRS set $001BUPDATE set 3WRITE set 2*EXPECT set 252* psect t116wolock,Type_Lang,Attr_Rev,0,4096,startstart bsr ckrole tst.w d0 bne.w child* lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #WRITE,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7 bsr canlock bcc.s ready moveq #0,d6 move.w d1,d6 bra.w isskipready move.l #90,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w ISeek bcs.w setuperr moveq #0,d0 move.w d7,d0 move.w #SSLock,d1 moveq #-1,d2 trap #0 dc.w ISetStt bcc.s locked moveq #0,d6 move.w d1,d6 moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose bra.w isfaillocked* bsr contend bcs.w setuperr* moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail*child lea fname(pc),a0 moveq #UPDATE,d0 trap #0 dc.w IOpen bcs.w chfail move.w d0,d7 bsr chticks bcs.w chfail move.l #0,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w ISeek bcs.w chfail bsr chready lea data50(pc),a0 moveq #10,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcc.s chok moveq #0,d6 move.w d1,d6 bra.s chrepchok moveq #0,d6chrep bsr chsaw bra.w chdone* use verdict.i use fork.i use report.i*fname dc.b "SCRATCH/t116.dat",0myname dc.b "t116wolock",0data50 dc.b "0123456789012345678901234567890123456789012345678" dc.b 13idstr dc.b "RESULT t116 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0skipstr dc.b "SKIP",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  SS_Lock -1 on a write-only path locks the file (inference)",0 ends