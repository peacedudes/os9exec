* t69sigq.a -- CONF68K test t69: signals held back by a mask are queued,* and delivered first-in first-out once it is cleared.** Claim (DOCS/claims.md): F$SigMask: "If a signal is sent to a process whose* mask is disabled, the signal is queued until the process mask becomes* enabled" (page 1 - 52). F$Send: a signal sent while an earlier one is still* unprocessed "is placed in a FIFO queue of signals for the individual* process" (page 1 - 48). F$Icpt: the intercept routine is entered with the* signal code in d1.w and a6 as given, and returns with F$RTE (page 1 - 39).** One process. It installs an intercept routine that records the first two* codes it is handed, masks signals, sends ITSELF 300, 301 and 302, checks* that nothing arrived while masked, clears the mask and naps (bounded) until* all three have been handled. obs is 1000 x the number handled, plus the* three codes less 300 as the next three digits when all three came: 3012* when the claim holds. Any other order shows as its digits (3210, 3102...);* fewer than 3000 means signals were lost; 50000 is added if the handler ran* while signals were still masked. Three, not two: the first delivery and* the ones made while the intercept routine is already running are queued* differently, and two signals exercise only the first.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FSend set $08FIcpt set $09FSleep set $0AFID set $0CFRTE set $1EFSigMask set $57* in this process's data area, reached through a6CNT set 0SIG1 set 2SIG2 set 4SIG3 set 6NSIG set 3EARLY set 50000*EXPECT set 3012* psect t69sigq,Type_Lang,Attr_Rev,0,2048,startstart clr.w CNT(a6) clr.w SIG1(a6) clr.w SIG2(a6) clr.w SIG3(a6) lea sighand(pc),a0 trap #0 dc.w FIcpt bcs.w setuperr moveq #0,d0 moveq #1,d1 trap #0 dc.w FSigMask bcs.w setuperr trap #0 dc.w FID bcs.w setuperr move.w d0,d7 moveq #0,d0 move.w d7,d0 move.w #300,d1 trap #0 dc.w FSend bcs.w setuperr moveq #0,d0 move.w d7,d0 move.w #301,d1 trap #0 dc.w FSend bcs.w setuperr moveq #0,d0 move.w d7,d0 move.w #302,d1 trap #0 dc.w FSend bcs.w setuperr moveq #0,d6 tst.w CNT(a6) beq.s t69held move.l #EARLY,d6t69held moveq #0,d0 moveq #0,d1 trap #0 dc.w FSigMask bcs.w setuperr moveq #50,d5t69nap cmpi.w #NSIG,CNT(a6) bhs.s t69tally moveq #2,d0 trap #0 dc.w FSleep subq.w #1,d5 bne.s t69napt69tally moveq #0,d0 move.w CNT(a6),d0 mulu #1000,d0 add.l d0,d6 cmpi.w #NSIG,CNT(a6) bne.s t69verd moveq #0,d0 move.w SIG1(a6),d0 sub.l #300,d0 mulu #100,d0 add.l d0,d6 moveq #0,d0 move.w SIG2(a6),d0 sub.l #300,d0 mulu #10,d0 add.l d0,d6 moveq #0,d0 move.w SIG3(a6),d0 sub.l #300,d0 add.l d0,d6t69verd cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail** the intercept routine: note the first three codes, count every callsighand move.w CNT(a6),d0 cmpi.w #NSIG,d0 bhs.s shdone add.w d0,d0 move.w d1,SIG1(a6,d0.w)shdone addq.w #1,CNT(a6) trap #0 dc.w FRTE* use verdict.i use report.i*idstr dc.b "RESULT t69 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  signals sent while masked are queued, delivered first-in first-out",0 ends