* t97schbit.a -- CONF68K test t97: F$SchBit finds a free run, and sees it go* and come back as F$AllBit and F$DelBit change the map.** Claim (DOCS/claims.md): F$SchBit "searches the specified allocation bit map* for a free block (cleared bits) of the required length, starting at the* beginning bit number (d0.w)" and "returns the offset of the first block* found"; if no block of that size exists it "returns with the carry set,* beginning bit number, and size of the largest block found" (F$SchBit, page* 1 - 47). F$AllBit "sets bits in the allocation map", numbered 0 to n-1* (page 1 - 5), and F$DelBit clears them again. A set bit means the block is* in use, a clear bit means it is available (same page).** Nothing here depends on which end of a byte bit 0 sits at, which the pages* do not say: every operation covers whole bytes, so both readings give the* same answers.** A 32-bit map, all free. Asking for 8 must answer 0. After allocating those* 8 the same question must answer 8 -- the run moved, which is the whole* point -- and after freeing them, 0 again. Then 40 bits are asked of a* 32-bit map, which must be refused.** ONLY the refusal is asked for, not what comes back with it, because the* page contradicts itself there: its FUNCTION text says a failed search* returns "with the carry set, beginning bit number, and size of the* largest block found", while its own ERROR OUTPUT says d1.w holds an* error code. Both cannot be true of d1, and a suite whose whole purpose* is to compare a system against the manual must not pick a side where* the manual has not. Real hardware would settle it.** obs is 1000 for the oversized request refused and measured, plus 100 for* the first answer, plus 10 for the moved run, plus 1 for the run coming* back: 1111. If F$SchBit itself is not implemented, obs is the error code it* gave, which reads as the FAIL it is.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FSchBit set $12FAllBit set $13FDelBit set $14*EXPECT set 1111* psect t97schbit,Type_Lang,Attr_Rev,0,2048,startstart sub.l #16,a7 movea.l a7,a4 clr.l 0(a4) moveq #0,d6** all free: a run of 8 starts at 0 moveq #0,d0 moveq #8,d1 movea.l a4,a0 lea 4(a4),a1 trap #0 dc.w FSchBit bcc.s t97first* not implemented, or refused: that code IS the observation moveq #0,d6 move.w d1,d6 bra.w t97vt97first tst.w d0 bne.s t97all moveq #100,d6** take them, and the next run must start after themt97all moveq #0,d0 moveq #8,d1 movea.l a4,a0 trap #0 dc.w FAllBit bcs.s t97free moveq #0,d0 moveq #8,d1 movea.l a4,a0 lea 4(a4),a1 trap #0 dc.w FSchBit bcs.s t97free cmpi.w #8,d0 bne.s t97free addi.l #10,d6** give them back, and the run returns to the frontt97free moveq #0,d0 moveq #8,d1 movea.l a4,a0 trap #0 dc.w FDelBit bcs.s t97big moveq #0,d0 moveq #8,d1 movea.l a4,a0 lea 4(a4),a1 trap #0 dc.w FSchBit bcs.s t97big tst.w d0 bne.s t97big addq.l #1,d6** more than the map holds: refused, and the largest run reportedt97big moveq #0,d0 moveq #40,d1 movea.l a4,a0 lea 4(a4),a1 trap #0 dc.w FSchBit bcc.s t97v addi.l #1000,d6t97v cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*idstr dc.b "RESULT t97 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  F$SchBit finds a free run; F$AllBit and F$DelBit move it",0 ends