* t100devnm.a -- CONF68K test t100: SS_DevNm names the device a path is on.** Claim (DOCS/claims.md): the SS_DevNm GetStat takes the path number in d0.w,* its function code in d1.w and "the address of [a] 32 byte area for device* name" in (a0), and answers with the "device name in 32 byte storage area,* null terminated". The page marks it (ALL) -- every file manager, not one* class of device (I$GetStt: SS_DevNum, page 2 - 10).** So it is asked of two different managers: /nil, whose name is known and* fixed on every system, and an ordinary file, whose device name is whatever* disk the suite was copied onto and so is only asked to be non-empty and* terminated. That is what makes this a test of "(ALL)" rather than of one* device.** The name is compared with case folded. OS-9 device names are conventionally* lower case and os9exec answers "nil", but a system that spelled its own* descriptor "NIL" would not be disagreeing with this page, which says nothing* about case -- and a suite that reported FAIL for it would be making a claim* the manual does not.** obs is 1000 if /nil answers at all, plus 100 if it answers "nil", plus 10 if* a file's path answers at all, plus 1 if that answer is non-empty and* terminated within the 32 bytes: 1111.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1ICreate set $83IOpen set $84IClose set $8FIDelete set $87IGetStt set $8DSSDevNm set $0EATTRS set $001B*EXPECT set 1111* psect t100devnm,Type_Lang,Attr_Rev,0,2048,startstart sub.l #64,a7 movea.l a7,a4 moveq #0,d6* The error codes a FAIL's DETAIL lines report live in the buffer's last* long, 60(a4), beyond the 32 bytes clrbuf clears: registers are no place* to keep them across system calls. High word the file, low word /nil. moveq #0,d4 clr.l 60(a4)** --- /nil, a device every system has lea nilname(pc),a0 moveq #3,d0 trap #0 dc.w IOpen exg d1,d4 bcs.w t100file moveq #0,d4 move.w d0,d7 bsr.w clrbuf moveq #0,d0 move.w d7,d0 move.w #SSDevNm,d1 movea.l a4,a0 trap #0 dc.w IGetStt bcc.s t100nilg move.w d1,62(a4) bra.s t100nilxt100nilg addi.l #1000,d6* the three letters, case folded, then a terminator move.b 0(a4),d0 ori.b #$20,d0 cmpi.b #'n',d0 bne.s t100nilx move.b 1(a4),d0 ori.b #$20,d0 cmpi.b #'i',d0 bne.s t100nilx move.b 2(a4),d0 ori.b #$20,d0 cmpi.b #'l',d0 bne.s t100nilx tst.b 3(a4) bne.s t100nilx addi.l #100,d6t100nilx moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose** --- an ordinary file, on whatever disk this suite is running fromt100file lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #3,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 bsr.w clrbuf moveq #0,d0 move.w d7,d0 move.w #SSDevNm,d1 movea.l a4,a0 trap #0 dc.w IGetStt bcc.s t100fg move.w d1,60(a4) bra.s t100donet100fg addi.l #10,d6* non-empty, and terminated somewhere in the 32 bytes tst.b 0(a4) beq.s t100done moveq #0,d5t100scan cmpi.b #0,0(a4,d5.w) beq.s t100term addq.w #1,d5 cmpi.w #32,d5 blt.s t100scan bra.s t100donet100term addq.l #1,d6t100done moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete cmpi.l #EXPECT,d6 beq.w ispass lea dnilo(pc),a3 moveq #0,d2 move.w d4,d2 bsr.w detail lea dgs(pc),a3 move.l 60(a4),d2 bsr.w detail lea dname(pc),a3 move.l 0(a4),d2 bsr.w detail lea dname2(pc),a3 move.l 4(a4),d2 bsr.w detail bra.w isfail** clrbuf -- 32 bytes of zero, so a manager that writes nothing cannot look* like one that answeredclrbuf moveq #0,d0 moveq #31,d1cb1 move.b d0,0(a4,d1.w) dbra d1,cb1 rts* use verdict.i use report.i*nilname dc.b "/nil",0fname dc.b "SCRATCH/t100.dat",0idstr dc.b "RESULT t100 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  SS_DevNm names the device a path is on",0dnilo dc.b "opening /nil failed with (0: it opened)",0dgs dc.b "SS_DevNm errors, file << 16 + /nil (0: none)",0dname dc.b "file path's name bytes 0-3",0dname2 dc.b "file path's name bytes 4-7",0 ends