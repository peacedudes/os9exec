* t05mode0rd.a -- CONF68K test t05: I$Read on a path opened with an access* mode of zero.** Claim (DOCS/claims.md): the manual's I$Open NOTE states that a file* opened with no mode bits does not permit any actual I/O on the path, and* the error-code table defines E$BMode (203) as an I/O function the file or* device is incapable of. So the read must be refused, and refused with* that code.** This is the companion to t04 and the more interesting half: it is the* difference between a system that merely tolerates a mode-0 open and one* that honours what the mode means. If the open in t04 fails, this test* reports ERROR rather than a verdict -- it never got a path to read.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IRead set $89IWrite set $8AISeek set $88IClose set $8FIDelete set $87IGetStt set $8DSSSize set $02ATTRS set $001B*EXPECT set 203* psect t05mode0rd,Type_Lang,Attr_Rev,0,2048,startstart* Scratch buffer on the stack, never in the code psect: this module is* marked re-entrant and a real system may hold it in ROM, where a write* into its own body would fault rather than just be untidy. sub.l #128,a7 movea.l a7,a4 lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea data4(pc),a0 moveq #4,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose* open with an access mode of zero -- legal per t04 lea fname(pc),a0 moveq #0,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7* no access was requested, so this read must be refused movea.l a4,a0 moveq #4,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IRead bcc.s t05ok moveq #0,d6 move.w d1,d6 bra.s t05jdgt05ok moveq #0,d6t05jdg cmpi.l #EXPECT,d6 beq.s ispass bra.s isfail* use verdict.i use report.i*fname dc.b "SCRATCH/t05.dat",0data4 dc.b "ABCD"idstr dc.b "RESULT t05 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  I$Read on a no-access-mode path reports E$BMode",0 ends