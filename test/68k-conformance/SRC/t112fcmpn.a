* t112fcmpn.a -- CONF68K test t112: FCMP of two equal negative values.** Claim (DOCS/claims.md): an INFERENCE, stated as one. FCMP's operation table* (M68000 Family Programmer's Reference) marks equal in-range negative operands* {NZ} -- N and Z "set or cleared as appropriate" -- and for two negative ZEROS* sets both N and Z, although IEEE subtraction gives +0 there. os9exec reads* that as N following the operands' sign when they are equal: -5 FCMP -5 sets* N and Z. obs is the condition code nibble (N=8, Z=4, I=2, NAN=1): 12 is our* reading, 4 (Z alone) would say N follows the difference's sign instead.** WHY: the pre-release CPU review could not settle it from the manual's text;* only hardware can. The predicates that decide branches are not affected.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FSTrap set $0ET_LINEF set $2CEXPECT set 12 psect t112fcmpn,Type_Lang,Attr_Rev,0,2048,startstart moveq #0,d0 movea.l d0,a0 lea exctbl(pc),a1 trap #0 dc.w FSTrap bcs.w setuperr dc.w $F23C,$4000 dc.l -5 dc.w $F23C,$4038 dc.l -5 dc.w $F206,$A800 rol.l #8,d6 andi.l #$0F,d6 cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail*exctbl dc.w T_LINEF,nofpu-*-4 dc.w -1nofpu moveq #11,d6 lea skipstr(pc),a5 bra.w report use verdict.i use report.i alignidstr dc.b "RESULT t112 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0skipstr dc.b "SKIP",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  -5 FCMP -5 sets N and Z (inference)",0 ends