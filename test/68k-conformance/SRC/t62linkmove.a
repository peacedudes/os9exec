* t62linkmove.a -- CONF68K test t62: a file moved by link-then-unlink is found* under the new name only.** Claim (DOCS/claims.md): a directory entry is a name and the LSN of the* file's FD sector, and a zero first byte marks a deleted entry (Technical* Manual, Directory File Format, page 7 - 5). A directory opens for update* with mode bit 7 set (I$Open, page 2 - 16). So an entry appended to the* directory carrying the file's FD sector gives the file a second name, and* clearing the first byte of its old entry removes the old one: afterwards* the file opens under the new name, holds its data, and does not open under* the old one. This is how move renames a file without copying it.** It is done as move does it: the old entry found through one update path,* the new entry appended through a second, the old entry cleared through the* first.** obs is 0 when it all holds. Otherwise it is the error code of the step that* was refused, 1 if the old name still opens, or 2 if the new name does not* hold the file's data.** os9exec failed it both ways until 2026-09-14. On an RBF image the clear was* lost to the second path's stale copy of the sector, so both names stayed* (obs=1). On a host-native directory the append was refused, E$BMode (203).*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IRead set $89IWrite set $8AISeek set $88IClose set $8FIDelete set $87IGetStt set $8DSSSize set $02ATTRS set $001BDIRUPD set $83*EXPECT set 0* psect t62linkmove,Type_Lang,Attr_Rev,0,2048,startstart sub.l #128,a7 movea.l a7,a4* start clean, then a one-byte file under the old name lea oldname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea newname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea oldname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 moveq #0,d0 move.w d7,d0 lea chM(pc),a0 moveq #1,d1 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose* path A (d6): find the old entry, its offset in d5 lea dirname(pc),a0 moveq #0,d0 move.b #DIRUPD,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d6 moveq #0,d5t62rd moveq #0,d0 move.w d6,d0 movea.l a4,a0 moveq #32,d1 trap #0 dc.w IRead bcs.w setuperr movea.l a4,a0 lea oldpat(pc),a3 moveq #5,d2t62cmp cmpm.b (a0)+,(a3)+ bne.s t62nxt dbra d2,t62cmp bra.s t62fndt62nxt addi.l #32,d5 bra.s t62rdt62fnd* path B (d7): append the entry, renamed, at the directory's end lea dirname(pc),a0 moveq #0,d0 move.b #DIRUPD,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7 moveq #0,d0 move.w d7,d0 moveq #SSSize,d1 trap #0 dc.w IGetStt bcs.w setuperr moveq #0,d0 move.w d7,d0 move.l d2,d1 trap #0 dc.w ISeek bcs.w setuperr movea.l a4,a0 lea newpat(pc),a3 moveq #5,d2t62cpy move.b (a3)+,(a0)+ dbra d2,t62cpy moveq #0,d0 move.w d7,d0 movea.l a4,a0 moveq #32,d1 trap #0 dc.w IWrite bcs.s t62err* path A: clear the old entry's first byte moveq #0,d0 move.w d6,d0 move.l d5,d1 trap #0 dc.w ISeek bcs.s t62err moveq #0,d0 move.w d6,d0 lea zero(pc),a0 moveq #1,d1 trap #0 dc.w IWrite bcs.s t62err moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose moveq #0,d0 move.w d6,d0 trap #0 dc.w IClose* the new name opens and holds the data lea newname(pc),a0 moveq #1,d0 trap #0 dc.w IOpen bcs.s t62err move.w d0,d7 moveq #0,d0 move.w d7,d0 movea.l a4,a0 moveq #1,d1 trap #0 dc.w IRead bcs.s t62err moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose moveq #2,d6 cmpi.b #'M',(a4) bne.s t62jdg* and the old name does not open lea oldname(pc),a0 moveq #1,d0 trap #0 dc.w IOpen bcs.s t62gone move.w d0,d7 moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose moveq #1,d6 bra.s t62jdgt62gone moveq #0,d6 bra.s t62jdgt62err moveq #0,d6 move.w d1,d6t62jdg lea newname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*dirname dc.b "SCRATCH",0oldname dc.b "SCRATCH/t62old",0newname dc.b "SCRATCH/t62new",0oldpat dc.b "t62ol",$E4newpat dc.b "t62ne",$F7zero dc.b 0chM dc.b 'M'idstr dc.b "RESULT t62 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  a file moved by link-then-unlink opens under the new name only",0 ends