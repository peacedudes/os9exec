* t75aljul.a -- CONF68K test t75: A$AtJul signals at the Julian time asked for.** Claim (DOCS/claims.md): A$AtJul, given the signal code in d2, the time as* seconds after midnight in d3 and the Julian day number in d4, "sends a* signal to the caller at a specific Julian date and time" (A$AtJul, page* 1 - 4). F$Time with d0 = 1 gives the time in that form: seconds since* midnight in d0, Julian date in d1 (F$Time, page 1 - 64).** The process reads the Julian time, asks for signal 302 two seconds later* (reading again after a 4-second pause if that would cross midnight), and* sleeps up to 500 ticks, going back to sleep when a signal cuts it short.* obs is 1000 x the signals received plus the first code: 1302 when the* claim holds; 0 if the alarm never came.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FIcpt set $09FSleep set $0AFRTE set $1EFAlarm set $56ADelete set 0ASet set 1ACycle set 2AAtDate set 3AAtJul set 4FTime set $15* in the data area, through a6CNT set 0FIRST set 2*EXPECT set 1302* psect t75aljul,Type_Lang,Attr_Rev,0,2048,startstart clr.w CNT(a6) clr.w FIRST(a6) lea sighand(pc),a0 trap #0 dc.w FIcpt bcs.w setuperr moveq #1,d0 trap #0 dc.w FTime bcs.w setuperr cmpi.l #86400-3,d0 blo.s t75set move.l #400,d4 bsr.w nap moveq #1,d0 trap #0 dc.w FTime bcs.w setuperrt75set move.l d0,d3 addq.l #2,d3 move.l d1,d4 moveq #0,d0 move.w #AAtJul,d1 move.l #302,d2 trap #0 dc.w FAlarm bcs.w setuperr move.l #500,d4 bsr.w nap moveq #0,d6 move.w CNT(a6),d6 mulu #1000,d6 moveq #0,d0 move.w FIRST(a6),d0 add.l d0,d6 cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* the intercept routine: keep the first code, count every callsighand tst.w CNT(a6) bne.s shcount move.w d1,FIRST(a6)shcount addq.w #1,CNT(a6) trap #0 dc.w FRTE** nap -- sleep d4 ticks in all, however often a signal cuts a sleep shortnap moveq #0,d0 move.l d4,d0 trap #0 dc.w FSleep tst.l d0 beq.s napdone move.l d0,d4 bra.s napnapdone rts* use verdict.i use report.i*idstr dc.b "RESULT t75 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  A$AtJul signals at the Julian time asked for",0 ends