* t01open.a -- CONF68K test t01: I$Open of a pathlist that does not exist.** Claim (DOCS/claims.md): opening a pathlist with no corresponding file* reports E$PNNF, error 216. Unlike the 6809 suite's equivalent test no* inference is needed here -- the 68k manual lists E$PNNF in I$Open's own* POSSIBLE ERRORS.** An open that SUCCEEDS is a FAIL, not an ERROR: the test established its* situation perfectly well, and the system answered wrongly. The path is* closed first regardless, so a run does not leak a path number into the* tests that follow.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IRead set $89IWrite set $8AISeek set $88IClose set $8FIDelete set $87IGetStt set $8DSSSize set $02ATTRS set $001B*EXPECT set 216* psect t01open,Type_Lang,Attr_Rev,0,2048,startstart* Scratch buffer on the stack, never in the code psect: this module is* marked re-entrant and a real system may hold it in ROM, where a write* into its own body would fault rather than just be untidy. sub.l #128,a7 movea.l a7,a4 lea fname(pc),a0 moveq #1,d0 trap #0 dc.w IOpen bcs.s t01err* the open succeeded -- close the path we should never have been given trap #0 dc.w IClose moveq #0,d6 bra.s t01jdgt01err moveq #0,d6 move.w d1,d6t01jdg cmpi.l #EXPECT,d6 beq.s ispass bra.s isfail* use verdict.i use report.i*fname dc.b "SCRATCH/nosuchfile",0idstr dc.b "RESULT t01 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  I$Open of an absent pathlist reports E$PNNF",0 ends