* t81pipecef.a -- CONF68K test t81: creating a named pipe whose name is* already in use reports E$CEF.** Claim (DOCS/claims.md): pipes are created with I$Create, a named one as* /pipe/<name>, and "if a pipe file with the same name already exists, an* error (E$CEF) is returned" (OS-9 Technical Manual, Interprocess* Communications, Operations on Pipes, page 4 - 12). The error appendix gives* E$CEF as 000:218.** The pipe is created and its path kept open -- a named pipe exists while a* path to it does -- and then created again under the same name. obs is the* second create's error, or 0 if it succeeded: 218 when the claim holds.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1ICreate set $83IOpen set $84IRead set $89IWrite set $8AIClose set $8F*EXPECT set 218* psect t81pipecef,Type_Lang,Attr_Rev,0,2048,startstart lea pname(pc),a0 moveq #3,d0 moveq #0,d1 moveq #0,d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea pname(pc),a0 moveq #3,d0 moveq #0,d1 moveq #0,d2 trap #0 dc.w ICreate bcs.s t81err moveq #0,d6 moveq #0,d5 move.w d0,d5 move.l d5,d0 trap #0 dc.w IClose bra.s t81fint81err moveq #0,d6 move.w d1,d6t81fin moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*pname dc.b "/pipe/t81p",0data6 dc.b "ABCDEF"idstr dc.b "RESULT t81 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  creating a named pipe that exists reports E$CEF",0 ends