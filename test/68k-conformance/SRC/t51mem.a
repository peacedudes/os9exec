* t51mem.a -- CONF68K test t51: F$Mem with d0 = 0 is an information request.** Claim (DOCS/claims.md): "If d0 equals zero, the call is considered an* information request and the current upper bound and size is returned" --* d0.l the size of the data area in bytes, (a1) its end (+1). What a* freshly forked process was handed is the same pair by another route: at* entry a1 is the top of its memory area and d6 its total memory, so the two* views must agree, and this test asks the kernel and compares.** An error from the call is reported as FAIL carrying the code, not as* ERROR: nothing was set up that could have failed, so the call itself is* the observation. A system that does not implement F$Mem shows here as* FAIL with 208 (E$UnkSvc).*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FMem set $07** Observations that are not error codes: 1 means the size disagreed with* d6, 2 means the upper bound disagreed with a1. Both stay clear of the* 901/902 band fork.i spends and of every OS-9 error code.SIZEDIFF set 1TOPDIFF set 2*EXPECT set 0* psect t51mem,Type_Lang,Attr_Rev,0,2048,startstart movea.l a1,a4 move.l d6,d7 moveq #0,d0 trap #0 dc.w FMem bcc.s t51ok moveq #0,d6 move.w d1,d6 bra.w isfailt51ok cmp.l d7,d0 beq.s t51size moveq #SIZEDIFF,d6 bra.w isfailt51size cmpa.l a4,a1 beq.s t51top moveq #TOPDIFF,d6 bra.w isfailt51top moveq #0,d6 bra.w ispass* use verdict.i use report.i*idstr dc.b "RESULT t51 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  F$Mem with d0=0 reports the size and top the fork handed over",0 ends