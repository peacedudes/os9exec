* t48sas.a -- CONF68K test t48: PD_SAS survives an SS_Opt SetStat.** Claim (DOCS/claims.md): the RBF path descriptor's option section may be* read with I$GetStt SS_Opt and nine of its fields changed with I$SetStt --* "You can update the following fields using GetStat and SetStat system* calls: PD_STP PD_TYP PD_DNS PD_CYL PD_SID PD_VFY PD_SCT PD_TOS PD_SAS.* All other fields are read-only." PD_SAS is the segment allocation size,* "the minimum number of sectors to allocate to a new segment".** The test writes a value RBF cannot have chosen for itself and reads the* option section back. What it observes is the field, not the allocator:* how many sectors a later write actually takes is not visible to a program* through any documented call, so asserting the stored value is as far as a* portable test can go -- and it is the half that distinguishes a system* honouring the SetStat from one discarding it.** SKIP is reached through this test's own isskip rather than verdict.i's,* which has none: as fork.i explains, a skipstr referenced from verdict.i* would stop the eighteen tests that define no such string from assembling.* This test defines one, so it carries the three lines itself.** PD_SAS is an RBF field, so the test first asks the path what kind of* device it is (PD_DTP, the first byte of the option section) and reports* SKIP carrying that type where the answer is not RBF. Under a host-native* directory presented by an emulator there is no allocation map and no* segment size, and a verdict earned there would say nothing about OS-9.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IGetStt set $8DISetStt set $8EIClose set $8FIDelete set $87SSOpt set $0000ATTRS set $001BDTP set 0SAS set $0EDTRBF set 1ASKED set 40*EXPECT set ASKED* psect t48sas,Type_Lang,Attr_Rev,0,2048,startstart* The 128-byte option section goes on the stack, never in the code psect:* this module is re-entrant and a real system may hold it in ROM. sub.l #128,a7 movea.l a7,a4 lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #3,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 moveq #0,d6* --- read the option section as it stands moveq #0,d0 move.w d7,d0 move.w #SSOpt,d1 movea.l a4,a0 trap #0 dc.w IGetStt bcs.w setuperr* --- an RBF path, or nothing to say moveq #0,d6 move.b DTP(a4),d6 cmpi.b #DTRBF,d6 bne.w isskip* --- ask for a segment allocation size RBF would not have chosen move.w #ASKED,SAS(a4) moveq #0,d0 move.w d7,d0 move.w #SSOpt,d1 movea.l a4,a0 trap #0 dc.w ISetStt bcs.s setfail* --- and read the section back moveq #0,d0 move.w d7,d0 move.w #SSOpt,d1 movea.l a4,a0 trap #0 dc.w IGetStt bcs.s setfail moveq #0,d6 move.w SAS(a4),d6 bra.s donesetfail moveq #0,d6 move.w d1,d6done moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete cmpi.l #EXPECT,d6 beq.s ispass bra.s isfail* use verdict.i use report.i** isskip -- this device is not RBF, so the claim cannot be exercised here.* d6 carries the device type that said so.isskip lea skipstr(pc),a5 bra.w report*fname dc.b "SCRATCH/t48file",0idstr dc.b "RESULT t48 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0skipstr dc.b "SKIP",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  SS_Opt SetStat changes PD_SAS on an RBF path",0 ends