* t23whol.a -- CONF68K test t23: a whole-file lock covers bytes the file* pointer is nowhere near.** Claim (DOCS/claims.md): "If $FFFFFFFF bytes are requested, then the entire* file is locked out regardless of where the file pointer is. This is a* special type of file lock that remains in effect until released by* SS_Lock(0), a read or write of zero bytes, or the file is closed"* (I$SetStt, SS_Lock). The manual adds that "There is no way to gain file* lock using only read or write system calls", so this call is the only* route to the behaviour and nothing else in the suite reaches it.** The holder seeks to 90 before locking and the contender writes at 0 --* about as far apart as a hundred-byte file allows. That gap is the test:* an implementation that honoured the request but measured the range from* the current position would leave byte 0 free and let the write through,* and would be indistinguishable from a correct one if both processes* worked near the same offset.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IWrite set $8AISeek set $88IClose set $8FIDelete set $87ISetStt set $8ESSLock set $11ATTRS set $001BUPDATE set 3*EXPECT set 252* psect t23whol,Type_Lang,Attr_Rev,0,4096,startstart bsr ckrole tst.w d0 bne.w child* lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #UPDATE,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7 bsr canlock bcc.s ready moveq #0,d6 move.w d1,d6 bra.w isskipready move.l #90,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w ISeek bcs.w setuperr moveq #0,d0 move.w d7,d0 move.w #SSLock,d1 moveq #-1,d2 trap #0 dc.w ISetStt bcs.w setuperr* bsr contend bcs.w setuperr* moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail*child lea fname(pc),a0 moveq #UPDATE,d0 trap #0 dc.w IOpen bcs.w chfail move.w d0,d7 bsr chticks bcs.w chfail move.l #0,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w ISeek bcs.w chfail bsr chready lea data50(pc),a0 moveq #10,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcc.s chok moveq #0,d6 move.w d1,d6 bra.s chrepchok moveq #0,d6chrep bsr chsaw bra.w chdone* use verdict.i use fork.i use report.i*fname dc.b "SCRATCH/t23.dat",0myname dc.b "t23whol",0data50 dc.b "0123456789012345678901234567890123456789012345678" dc.b 13idstr dc.b "RESULT t23 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0skipstr dc.b "SKIP",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  SS_Lock -1 locks the file whatever the file pointer is",0 ends