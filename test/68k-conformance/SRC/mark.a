* mark.a -- the run-boundary line, then what the run happened on.** A report comes back from somebody else's machine, and every question we* would otherwise have to send back is answered here instead: which OS-9 and* which processor (the init module's own fields, Technical Manual Figure 2-2),* which user ran it (several tests SKIP unless it is the super user), which* device the suite ran from and whether that is RBF (the locking tests SKIP* on anything else), the tick rate, and when. Each line starts "INFO"; every* tool that reads a report counts only RESULT lines, so these change no* totals. A call that fails prints its error code in place of its answer --* an error here is information too, never a reason to stop.** Only documented calls, and nothing is written outside this module's own* stack: the pre-3.0 F$SysID is deliberately NOT used, since v3.0 redefined* it around a parameter block and the old form could write through garbage.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+2FLink set $00FUnLink set $02FExit set $06FID set $0CFTime set $15FSetSys set $27IOpen set $84IWrite set $8AIGetStt set $8DIClose set $8FSSOpt set $00SSDevNm set $0ELINE set 0NAME set 256OPTS set 320AREA set 448 psect mark,Type_Lang,Attr_Rev,0,2048,startstart suba.l #AREA,a7 movea.l a7,a4 lea LINE(a4),a1 lea s_run(pc),a0 bsr.w apstr bsr.w flush lea s_suite(pc),a0 bsr.w apstr bsr.w flush** --- the operating system and processor, from the init module. F$Link* returns the entry point in a1, which is the line pointer: kept in a5. lea s_os(pc),a0 bsr.w apstr lea n_init(pc),a0 moveq #0,d0 movea.l a1,a5 trap #0 dc.w FLink exg a1,a5 bcs.w oserr movea.l a2,a3 moveq #0,d2 move.w $5A(a3),d2 beq.s osnorev lea 0(a3,d2.l),a0 bsr.w apstrosnorev lea s_lvl(pc),a0 bsr.w apstr moveq #0,d2 move.b $56(a3),d2 bsr.w apdec move.b #'.',(a1)+ moveq #0,d2 move.b $57(a3),d2 bsr.w apdec move.b #'.',(a1)+ moveq #0,d2 move.b $58(a3),d2 bsr.w apdec move.b #'.',(a1)+ moveq #0,d2 move.b $59(a3),d2 bsr.w apdec lea s_cpu(pc),a0 bsr.w apstr move.l $52(a3),d2 bsr.w apdec movea.l a3,a2 trap #0 dc.w FUnLink bra.s osdoneoserr bsr.w aperrosdone bsr.w flush** --- processor and FPU as the kernel found them (D_MPUTyp, D_68881) lea s_mpu(pc),a0 bsr.w apstr move.w #$3C8,d0 move.l #$80000004,d1 trap #0 dc.w FSetSys bcs.s mpuerr bsr.w apdec bra.s mpufpumpuerr bsr.w aperrmpufpu lea s_fpu(pc),a0 bsr.w apstr move.w #$2F,d0 move.l #$80000001,d1 trap #0 dc.w FSetSys bcs.s fpuerr andi.l #$FF,d2 bsr.w apdec bra.s fpudonefpuerr bsr.w aperrfpudone lea s_tick(pc),a0 bsr.w apstr move.w #$28,d0 move.l #$80000002,d1 trap #0 dc.w FSetSys bcs.s tickerr andi.l #$FFFF,d2 bsr.w apdec bra.s tickdonetickerr bsr.w aperrtickdone bsr.w flush** --- who is running it lea s_user(pc),a0 bsr.w apstr trap #0 dc.w FID bcs.s usererr move.l d1,d4 swap d4 moveq #0,d2 move.w d4,d2 bsr.w apdec move.b #'.',(a1)+ swap d4 moveq #0,d2 move.w d4,d2 bsr.w apdec bra.s userdoneusererr bsr.w aperruserdone bsr.w flush** --- the device the suite runs from, and its type (PD_DTP: 1 is RBF) lea s_dev(pc),a0 bsr.w apstr lea n_dot(pc),a0 move.b #$81,d0 trap #0 dc.w IOpen bcs.s deverr move.w d0,d7 lea NAME(a4),a0 moveq #15,d0devclr clr.l (a0)+ dbra d0,devclr move.w d7,d0 move.w #SSDevNm,d1 lea NAME(a4),a0 trap #0 dc.w IGetStt bcs.s devnmerr lea NAME(a4),a0 bsr.w apstr bra.s devtypedevnmerr bsr.w aperrdevtype lea s_type(pc),a0 bsr.w apstr move.w d7,d0 moveq #SSOpt,d1 lea OPTS(a4),a0 trap #0 dc.w IGetStt bcs.s typeerr moveq #0,d2 move.b OPTS(a4),d2 bsr.w apdec bra.s devclosetypeerr bsr.w aperrdevclose move.w d7,d0 trap #0 dc.w IClose bra.s devdonedeverr bsr.w aperrdevdone bsr.w flush** --- when (F$Time, Gregorian: d0 = 00hhmmss, d1 = yyyymmdd) lea s_date(pc),a0 bsr.w apstr moveq #0,d0 trap #0 dc.w FTime bcs.s dateerr move.l d0,d4 move.l d1,d5 moveq #0,d2 swap d5 move.w d5,d2 bsr.w apdec move.b #'/',(a1)+ swap d5 moveq #0,d2 move.w d5,d2 lsr.w #8,d2 bsr.w ap2 move.b #'/',(a1)+ moveq #0,d2 move.b d5,d2 bsr.w ap2 move.b #' ',(a1)+ move.l d4,d2 swap d2 andi.l #$FF,d2 bsr.w ap2 move.b #':',(a1)+ move.l d4,d2 lsr.w #8,d2 andi.l #$FF,d2 bsr.w ap2 move.b #':',(a1)+ move.l d4,d2 andi.l #$FF,d2 bsr.w ap2 bra.s datedonedateerr bsr.w aperrdatedone bsr.w flush moveq #0,d1 trap #0 dc.w FExit** apstr: append the string at (a0) to (a1). It ends at a NUL, or at a byte* with bit 7 set (OS-9's own name form), which is appended without it.* At most 80 characters, so a bad pointer cannot run away with the line.apstr moveq #79,d5apsloop move.b (a0)+,d0 beq.s apsdone bmi.s apslast move.b d0,(a1)+ dbra d5,apsloop rtsapslast andi.b #$7F,d0 move.b d0,(a1)+apsdone rts** aperr: append "error NNN" for the error code in d1.waperr move.w d1,d6 lea s_err(pc),a0 bsr.s apstr moveq #0,d2 move.w d6,d2 bra.s apdec** ap2: append d2 as at least two digitsap2 cmpi.l #10,d2 bcc.s apdec move.b #'0',(a1)+** apdec: append d2.l, unsigned, in decimal with no leading zerosapdec lea pow10(pc),a2 moveq #0,d3apdloop move.l (a2)+,d1 beq.s apdlast moveq #'0',d0apdsub cmp.l d1,d2 bcs.s apdput sub.l d1,d2 addq.b #1,d0 bra.s apdsubapdput tst.b d3 bne.s apdemit cmpi.b #'0',d0 beq.s apdloop moveq #1,d3apdemit move.b d0,(a1)+ bra.s apdloopapdlast addi.b #'0',d2 move.b d2,(a1)+ rts** flush: write the line built at LINE(a4) with its CR, and start a new oneflush move.b #13,(a1)+ lea LINE(a4),a0 move.l a1,d1 sub.l a0,d1 moveq #1,d0 trap #0 dc.w IWrite lea LINE(a4),a1 rts*pow10 dc.l 1000000000,100000000,10000000,1000000,100000,10000,1000,100,10,0s_run dc.b "RUN prebuilt",0s_suite dc.b "INFO suite CONF68K, 114 tests (os9exec v4.1.0 release)",0s_os dc.b "INFO os ",0s_lvl dc.b "  level.version.revision.edition ",0s_cpu dc.b "  init CPU type ",0s_mpu dc.b "INFO kernel CPU type ",0s_fpu dc.b "  FPU ",0s_tick dc.b "  ticks per second ",0s_user dc.b "INFO user group.user ",0s_dev dc.b "INFO device ",0s_type dc.b "  type ",0s_date dc.b "INFO date ",0s_err dc.b "error ",0n_init dc.b "init",0n_dot dc.b ".",0 ends