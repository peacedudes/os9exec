* t71sendid.a -- CONF68K test t71: F$Send to a process ID that names no* process reports E$IPrcID.** Claim (DOCS/claims.md): F$Send lists E$IPrcID and E$USigP as its possible* errors (F$Send, POSSIBLE ERRORS, page 1 - 49), and the error-code appendix* gives E$IPrcID, 000:224, as a process ID passed to a system call naming a* process that does not exist (Error Codes - 7). So a signal addressed to an* ID no process can have must be refused with 224, never reported as sent.** The four IDs are t60's, all far past any plausible process table: $0100,* $01A8, $7FFF and $FFFF. The signal is S$Wake, deliberately: if one of these* did name a process on some large system, a wakeup is the one signal that* could not end it ("will not abort a process that has not made an F$Icpt* call", page 1 - 48). ID 0 is not among them: it means "all processes" to* F$Send, not a process.** obs is 224 when every one is refused that way; otherwise the first* different answer: the error it gave, or 0 if the send reported success.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FSend set $08SWake set 1*EXPECT set 224* psect t71sendid,Type_Lang,Attr_Rev,0,2048,startstart lea pids(pc),a3 moveq #3,d5t71nxt moveq #0,d0 move.w (a3)+,d0 moveq #SWake,d1 trap #0 dc.w FSend bcc.s t71sent moveq #0,d6 move.w d1,d6 cmpi.l #EXPECT,d6 bne.s t71jdg dbra d5,t71nxt bra.s t71jdgt71sent* the send claimed to reach a process that cannot exist moveq #0,d6t71jdg cmpi.l #EXPECT,d6 beq.s ispass bra.s isfail* use verdict.i use report.i*pids dc.w $0100,$01A8,$7FFF,$FFFFidstr dc.b "RESULT t71 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  F$Send to a process ID that names no process reports E$IPrcID",0 ends