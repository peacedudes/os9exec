* t113supln.a -- CONF68K test t113: can the super user link a module whose* access word gives nobody read permission?** Claim (DOCS/claims.md): an INFERENCE, stated as one. F$Link: "If the module's* access word does not give the process read permission, the link call fails"* (Technical Manual). The OS-9 Guru (3.2.4) says the super-user group is* checked the same way, through the owner field; other accounts say group 0* bypasses the check. os9exec follows the Guru: a module with access $0000 is* refused E$Permit (164) even to the super user. obs is 0 if the link is* allowed, else its error code -- 0 from real hardware says group 0 bypasses.* Run as a group-0 user; any other user reports SKIP, with the group in obs.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FLink set $00FUnLink set $02FID set $0CFDatMod set $25EXPECT set 164 psect t113supln,Type_Lang,Attr_Rev,0,2048,startstart trap #0 dc.w FID bcs.w setuperr swap d1 tst.w d1 beq.s super moveq #0,d6 move.w d1,d6 lea skipstr(pc),a5 bra.w reportsuper lea mname(pc),a0 moveq #16,d0 move.w #$8001,d1 move.w #$0000,d2 trap #0 dc.w FDatMod bcs.w setuperr movea.l a2,a3 lea mname(pc),a0 moveq #0,d0 trap #0 dc.w FLink bcs.s refused trap #0 dc.w FUnLink moveq #0,d6 bra.s judgerefused moveq #0,d6 move.w d1,d6judge movea.l a3,a2 trap #0 dc.w FUnLink cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*mname dc.b "t113perm",0idstr dc.b "RESULT t113 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0skipstr dc.b "SKIP",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  the super user may not link an unreadable module (inference)",0 ends