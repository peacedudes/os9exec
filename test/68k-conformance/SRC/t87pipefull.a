* t87pipefull.a -- CONF68K test t87: a write that would fill an unnamed pipe* nobody else holds reports E$Write.** Claim (DOCS/claims.md): "A pipe error (E$Write) is returned when all the* processes with a full unnamed pipe open are attempting to write to the* pipe. Each process attempting to write to the pipe receives the error, and* the pipe remains full" (Interprocess Communications, Write/WritLn, page* 4 - 13). The buffer size is the descriptor's unless the creator overrides* it "by setting the initial file size bit of the mode byte and passing the* desired file size in register d2" (Creating Pipes, page 4 - 12). E$Write* is 000:245.** One process creates an unnamed pipe with its size set to 90 bytes -- the* manual's own default, asked for explicitly, since a descriptor may declare* more -- so it is the pipe's only user, and writes 200 bytes to it. When the* buffer fills, every process with the pipe open (this one) is writing, so* the write must fail with 245. obs is the write's error, or 0 if it claimed* to succeed.** A system that waited instead would wait forever. An alarm sends signal 30* after two seconds (a signal below 32 ends the current I/O with itself as* the error, F$Send page 1 - 49), with S$Kill after six as the last resort;* obs is then 30, or the line is missing. Both are deleted before the verdict.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1ICreate set $83IWrite set $8AIClose set $8FFIcpt set $09FRTE set $1EFAlarm set $56ADelete set 0ASet set 1SKill set 0NBYTES set 200PIPESZ set 90ISIZE set $20*EXPECT set 245* psect t87pipefull,Type_Lang,Attr_Rev,0,2048,startstart sub.l #NBYTES,a7 movea.l a7,a4 lea icpt(pc),a0 trap #0 dc.w FIcpt bcs.w setuperr moveq #0,d0 move.w #ASet,d1 moveq #30,d2 move.l #200,d3 trap #0 dc.w FAlarm bcs.w setuperr move.l d0,d4 moveq #0,d0 move.w #ASet,d1 moveq #SKill,d2 move.l #600,d3 trap #0 dc.w FAlarm bcs.w setuperr move.l d0,d5 lea pname(pc),a0 moveq #3+ISIZE,d0 moveq #0,d1 moveq #PIPESZ,d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 moveq #0,d6 movea.l a4,a0 move.l #NBYTES,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcc.s t87fin move.w d1,d6t87fin move.l d4,d0 move.w #ADelete,d1 trap #0 dc.w FAlarm move.l d5,d0 move.w #ADelete,d1 trap #0 dc.w FAlarm moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail*icpt trap #0 dc.w FRTE* use verdict.i use report.i*pname dc.b "/pipe",0idstr dc.b "RESULT t87 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  filling an unnamed pipe only its writer holds reports E$Write",0 ends