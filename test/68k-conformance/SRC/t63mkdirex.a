* t63mkdirex.a -- CONF68K test t63: I$MakDir of a name that is already a* directory reports E$CEF.** Claim (DOCS/claims.md): I$MakDir's POSSIBLE ERRORS are E$BPNam and E$CEF* (Technical Manual, I$MakDir, page 2 - 15), and the error-code appendix* assigns 218, E$CEF, to an attempt to create a file under a name already* present in the directory. A directory already there is such a name, so a* second I$MakDir of it must report 218 -- the same as it does for a plain* file of that name, which t10 checks through I$Create.** The first I$MakDir is setup and its result is ignored: on a device that* keeps SCRATCH between runs the directory is already there from the last one,* and that is fine -- the claim is about the call that follows.** obs is the error the second I$MakDir reported, or 0 if it succeeded.** os9exec answered 214 (E$FNA) on an RBF image until 2026-09-14: makdir* creates through an open that asks for a file, and the open refused the* existing directory as "not a file" before it asked whether it was creating.* A host-native directory already answered 218.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IMakDir set $85ATTRS set $001B*EXPECT set 218* psect t63mkdirex,Type_Lang,Attr_Rev,0,2048,startstart* setup: make it, or find it already made lea dname(pc),a0 moveq #3,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w IMakDir* the claim: make it again lea dname(pc),a0 moveq #3,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w IMakDir bcc.s t63ok moveq #0,d6 move.w d1,d6 bra.s t63jdgt63ok moveq #0,d6t63jdg cmpi.l #EXPECT,d6 beq.s ispass bra.s isfail* use verdict.i use report.i*dname dc.b "SCRATCH/t63d",0idstr dc.b "RESULT t63 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  I$MakDir of an existing directory reports E$CEF",0 ends