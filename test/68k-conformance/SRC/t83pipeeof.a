* t83pipeeof.a -- CONF68K test t83: a pipe read short of data returns what is* there, and an empty pipe whose only user is reading is end of file.** Claim (DOCS/claims.md): "The end-of-file is recognized when the pipe is* empty and the number of processes waiting to read the pipe is equal to the* number of users on the pipe. If any data was read before end-of-file was* reached, an end-of-file error is not returned. However, the byte count* returned is the number of bytes actually transferred, which is less than* the number requested" (Interprocess Communications, Read/ReadLn, page* 4 - 13). E$EOF is 000:211.** One process opens an unnamed pipe -- it is the pipe's only user -- writes* four bytes and asks to read ten: it must get the four, with no error. It* asks again: the pipe is empty and its one user is the one reading, so that* read must be end of file. obs is 10 for the short count, plus 1 for E$EOF:* 11.** A system that got this wrong would block in either read with nobody left* to write, which would hang the run. So an alarm is set first to send signal* 30 after two seconds, with an intercept routine to receive it: signals* below 32 "usually cause the current I/O operation to terminate with an* error status equal to the signal value" (F$Send, page 1 - 49). A read that* blocks therefore comes back with 30, and the verdict says so. The alarm is* deleted before the verdict.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1ICreate set $83IOpen set $84IRead set $89IWrite set $8AIClose set $8FIGetStt set $8DSSReady set $01FIcpt set $09FRTE set $1EFAlarm set $56ADelete set 0ASet set 1EEOF set 211*EXPECT set 11* psect t83pipeeof,Type_Lang,Attr_Rev,0,2048,startstart sub.l #16,a7 movea.l a7,a4 lea icpt(pc),a0 trap #0 dc.w FIcpt bcs.w setuperr moveq #0,d0 move.w #ASet,d1 moveq #30,d2 move.l #200,d3 trap #0 dc.w FAlarm bcs.w setuperr move.l d0,d4 lea pname(pc),a0 moveq #3,d0 moveq #0,d1 moveq #0,d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea data4(pc),a0 moveq #4,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d6* ten asked for, four there movea.l a4,a0 moveq #10,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IRead bcs.s t83err cmpi.l #4,d1 bne.s t83two moveq #10,d6* now empty, and its only user is the readert83two movea.l a4,a0 moveq #10,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IRead bcc.s t83fin cmpi.w #EEOF,d1 bne.s t83err addq.l #1,d6 bra.s t83fin* a blocked read cut short by the watchdog, or some other refusalt83err moveq #0,d6 move.w d1,d6t83fin move.l d4,d0 move.w #ADelete,d1 trap #0 dc.w FAlarm moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail*icpt trap #0 dc.w FRTE* use verdict.i use report.i*pname dc.b "/pipe",0data4 dc.b "WXYZ"idstr dc.b "RESULT t83 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  a short pipe read returns what is there; then end of file",0 ends