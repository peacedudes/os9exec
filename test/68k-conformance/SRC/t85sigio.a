* t85sigio.a -- CONF68K test t85: a signal ends a blocked read, with the* signal code as its error.** Claim (DOCS/claims.md): "Signal values less than 32 (S$Deadly) usually* cause the current I/O operation to terminate with an error status equal to* the signal value" (F$Send, CAVEATS, page 1 - 49); and the Relative Time* Alarms section gives exactly this as the way to put a time limit on a* read: "sending a keyboard abort signal at the maximum allowable time, and* then issuing the I$Read request" (Interprocess Communications, page 4 - 5).* The manual's "usually" is noted in claims.md: this is the case its own* example depends on.** The process installs an intercept routine (so the signal does not end the* process), sets an alarm to send S$Abort (2) in two seconds, and reads an* empty unnamed pipe that has a second path on it (I$Dup), so the read is* not end of file: it must wait. The alarm must end the wait, and the read* must return carry set with 2. obs is the read's error code, or 0 if it* claimed to succeed: 2 when the claim holds.** A system where the signal does NOT end the read would wait forever. A* second alarm sends S$Kill after six seconds, which "terminates the* receiving process, regardless of the state of its mask": the test then* dies without a RESULT line, and the totals show one missing, rather than* the run hanging. Both alarms are deleted before the verdict.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1ICreate set $83IDup set $82IRead set $89IClose set $8FFIcpt set $09FRTE set $1EFAlarm set $56ADelete set 0ASet set 1SAbort set 2SKill set 0*EXPECT set 2* psect t85sigio,Type_Lang,Attr_Rev,0,2048,startstart sub.l #16,a7 movea.l a7,a4 lea icpt(pc),a0 trap #0 dc.w FIcpt bcs.w setuperr moveq #0,d0 move.w #ASet,d1 moveq #SAbort,d2 move.l #200,d3 trap #0 dc.w FAlarm bcs.w setuperr move.l d0,d4 moveq #0,d0 move.w #ASet,d1 moveq #SKill,d2 move.l #600,d3 trap #0 dc.w FAlarm bcs.w setuperr move.l d0,d3 lea pname(pc),a0 moveq #3,d0 moveq #0,d1 moveq #0,d2 move.l d3,-(a7) trap #0 dc.w ICreate move.l (a7)+,d3 bcs.w setuperr move.w d0,d7 moveq #0,d0 move.w d7,d0 trap #0 dc.w IDup bcs.w setuperr move.w d0,d5* an empty pipe, and not end of file: this read has to wait moveq #0,d6 movea.l a4,a0 moveq #10,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IRead bcc.s t85fin move.w d1,d6t85fin move.l d4,d0 move.w #ADelete,d1 trap #0 dc.w FAlarm move.l d3,d0 move.w #ADelete,d1 trap #0 dc.w FAlarm moveq #0,d0 move.w d5,d0 trap #0 dc.w IClose moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail*icpt trap #0 dc.w FRTE* use verdict.i use report.i*pname dc.b "/pipe",0idstr dc.b "RESULT t85 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  an alarm's keyboard abort ends a blocked read with error 2",0 ends