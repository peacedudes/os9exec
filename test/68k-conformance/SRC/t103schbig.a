* t103schbig.a -- CONF68K test t103: F$SchBit never reports a bit number it* cannot express.** Claim (DOCS/claims.md): F$SchBit "searches the specified allocation bit map* for a free block (cleared bits) of the required length" and "returns the* offset of the first block found of the specified length" in d0.w; a set bit* means the block is in use, a clear bit means it is available (F$SchBit,* page 1 - 47).** d0.w is sixteen bits, so it can name bits 0 through 65535 and no others. A* map longer than 8192 bytes has bits past that, and a free run found up* there has no number the call can hand back. Answering anyway means naming* a DIFFERENT bit -- the low sixteen of the real one -- and the bit so named* is in use, which the page says the answer never is.** The map here is 12288 bytes: 98304 bits. Every bit in the first 65536 is* set, so nothing nameable is free, and one byte is cleared at offset 8750,* which is bits 70000 through 70007 -- past naming whichever end of a byte* bit 0 sits at, so this test does not depend on that (t97 says the pages do* not settle it). A run of one must therefore be refused: no answer exists* that is both true and sixteen bits wide.** obs is 1 for the refusal. If the call answers instead, obs is the number it* gave, and the map says what that is worth: every bit below 65536 is in use,* so any number below there is wrong on its face.*Prgrm       set   1Objct       set   1ReEnt       set   $80Type_Lang   set   (Prgrm<<8)+ObjctAttr_Rev    set   (ReEnt<<8)+1FSchBit     set   $12*MAPSZ       set   12288FREEBYTE    set   8750EXPECT      set   1*  psect t103schbig,Type_Lang,Attr_Rev,0,20480,startstart  sub.l #MAPSZ,a7  movea.l a7,a4* every bit in use  movea.l a4,a1  move.w #MAPSZ-1,d0t103f  move.b #$FF,(a1)+  dbra d0,t103f* free one byte, too high up to be named in sixteen bits  clr.b FREEBYTE(a4)*  moveq #0,d0  moveq #1,d1  movea.l a4,a0  lea MAPSZ(a4),a1  trap #0  dc.w FSchBit  bcs.s t103no* it answered: the number it gave IS the observation  moveq #0,d6  move.w d0,d6  bra.s t103vt103no  moveq #1,d6t103v  add.l #MAPSZ,a7  cmpi.l #EXPECT,d6  beq.w ispass  bra.w isfail*  use verdict.i  use report.i*idstr dc.b "RESULT t103 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  F$SchBit refuses a run it could only name wrongly",0  ends