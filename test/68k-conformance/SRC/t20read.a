* t20read.a -- CONF68K test t20: a read on a path opened in READ mode locks* nothing.** Claim (DOCS/claims.md): "Reading files that are opened in read or execute* modes does not cause record locking to occur because records cannot be* updated in these two modes" (Technical Manual, page 7-8), restated for the* calls themselves on page 7-11: "Read and ReadLine cause lock out of* records only if the file is open in update mode." So another process may* write the very bytes this one has just read, with no conflict at all.** This is t19 with one bit changed -- the access mode -- and it is the half* that a suite built only around "does a lock happen" would never have. A* system that locks on EVERY read passes t19 and fails here, and that is a* real and costly bug rather than a pedantic one: the manual warns that "if* shared files are routinely opened for update on a multi-user system, users* can become hopelessly record-locked for extended periods of time" (page* 7-10), which is precisely what over-eager locking would produce on files* nobody ever asked to lock.** It is also this suite's control for its own machinery. t19 reports 902 --* the child never came back -- and a reader is entitled to ask whether that* means the child was wedged or merely that the parent gave up too early.* Here the parent gives up on exactly the same schedule and the child comes* back with 0, so the schedule is not the thing producing 902 next door.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IRead set $89IWrite set $8AISeek set $88IClose set $8FIDelete set $87ATTRS set $001BUPDATE set 3RDONLY set 1*EXPECT set 0* psect t20read,Type_Lang,Attr_Rev,0,4096,startstart bsr ckrole tst.w d0 bne.w child** ---- parent: read the file WITHOUT update mode, then fork ---- lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose** RDONLY, not UPDATE. That single bit is the whole test. lea fname(pc),a0 moveq #RDONLY,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7** The probe runs on a path this test then keeps in read mode, which is fine:* SS_Lock with a size of zero is a release, and "A release is always* allowed" -- it is the request to TAKE a lock that a read-mode path has no* business making. What the probe is for is the device, not the path. bsr canlock bcc.s noloc moveq #0,d6 move.w d1,d6 bra.w isskip** Same read as t19, same fifty bytes, same position. Only the mode differs.noloc sub.l #128,a7 movea.l a7,a4 clr.l d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w ISeek bcs.w setuperr movea.l a4,a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IRead bcs.w setuperr* bsr contend bcs.w setuperr* moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail** ---- child: write the bytes the parent just read ----child lea fname(pc),a0 moveq #UPDATE,d0 trap #0 dc.w IOpen bcs.w chfail move.w d0,d7 bsr chticks bcs.w chfail clr.l d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w ISeek bcs.w chfail bsr chready lea data50(pc),a0 moveq #10,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcc.s chok moveq #0,d6 move.w d1,d6 bra.s chrepchok moveq #0,d6chrep bsr chsaw bra.w chdone* use verdict.i use fork.i use report.i*fname dc.b "SCRATCH/t20.dat",0myname dc.b "t20read",0data50 dc.b "0123456789012345678901234567890123456789012345678" dc.b 13idstr dc.b "RESULT t20 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0skipstr dc.b "SKIP",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  a read in read mode locks nothing against another process",0 ends