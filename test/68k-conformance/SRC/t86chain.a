* t86chain.a -- CONF68K test t86: F$Chain runs a new program in the same* process, and erases the intercept routine.** Claim (DOCS/claims.md): "F$Chain executes an entirely new program, but* without the overhead of creating a new process", and among the steps it* lists, "Intercepts and any pending signals are erased" (F$Chain, FUNCTION,* page 1 - 7). F$Send: with no intercept routine a signal aborts the process* and its code becomes the exit status (page 1 - 48); F$Wait returns the* child's ID in d0.w and that status in d1.w (page 1 - 71).** The module plays three parts, chosen by its parameter:*   parent (none)  forks the module with "C", waits half a second, sends the*                  child signal 300, and waits for it*   "C"            installs an intercept routine, then F$Chains to this same*                  module with "D"*   "D"            sleeps up to 500 ticks, then exits 99* If the chain erased the intercept, signal 300 finds the process without one* and ends it with status 300. If the intercept survived, the process shrugs* the signal off and exits 99 after its sleep. And if F$Chain made a new* process, the one F$Wait reports is not the one F$Fork returned.** obs is 1000 if F$Wait reported the ID F$Fork returned, plus the exit* status: 1300 when the claim holds; 1099 if the intercept survived the chain.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FFork set $03FWait set $04FChain set $05FExit set $06FSend set $08FIcpt set $09FSleep set $0AFRTE set $1EPARMMAX set 256NOCHILD set 900*EXPECT set 1300* psect t86chain,Type_Lang,Attr_Rev,0,2048,startstart tst.l d5 beq.s parent cmpi.l #PARMMAX,d5 bhi.s parent cmpi.b #'C',(a5) beq.w rolec cmpi.b #'D',(a5) beq.w roled*parent moveq #0,d0 moveq #0,d1 moveq #1,d2 moveq #3,d3 moveq #0,d4 lea parmc(pc),a1 lea myname(pc),a0 trap #0 dc.w FFork bcs.w setuperr move.w d0,d7 moveq #50,d0 trap #0 dc.w FSleep moveq #0,d0 move.w d7,d0 move.w #300,d1 trap #0 dc.w FSend moveq #20,d3pwait trap #0 dc.w FWait bcs.w setuperr tst.w d0 bne.s pgot subq.w #1,d3 bne.s pwait move.w #NOCHILD,d1 bra.w setuperrpgot moveq #0,d6 cmp.w d7,d0 bne.s pstat move.l #1000,d6pstat moveq #0,d0 move.w d1,d0 add.l d0,d6 cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail** ---- "C": an intercept routine, then become "D" in place ----rolec lea icpt(pc),a0 trap #0 dc.w FIcpt moveq #0,d0 moveq #0,d1 moveq #1,d2 moveq #3,d3 moveq #0,d4 lea parmd(pc),a1 lea myname(pc),a0 trap #0 dc.w FChain* F$Chain returns only on failure move.w #98,d1 trap #0 dc.w FExit** ---- "D": wait for the signal, bounded ----roled move.l #500,d0 trap #0 dc.w FSleep moveq #99,d1 trap #0 dc.w FExit*icpt trap #0 dc.w FRTE* use verdict.i use report.i*myname dc.b "t86chain",0parmc dc.b "C"parmd dc.b "D"idstr dc.b "RESULT t86 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  F$Chain keeps the process and erases its intercept routine",0 ends