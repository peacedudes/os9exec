* t61twopath.a -- CONF68K test t61: two update paths writing different bytes* of one file both keep their writes, whichever path closes first.** Claim (DOCS/claims.md): I$Write writes the bytes to the file at the path's* position (I$Write, FUNCTION, page 2 - 30), and files can be opened by several* paths at once (I$Open, FUNCTION, page 2 - 17). Nothing lets a write on one* path undo a write on another to a different part of the file. So after path* A writes 'A' at offset 8 and path B writes 'B' at offset 40 -- both in the* first sector -- both bytes must be in the file, however the paths are closed.** The file is set up and the two writes made twice: once closing A first, once* closing B first. obs is 0 when all four bytes survive. Otherwise it records* what was lost: +1 A's byte and +2 B's byte in the A-first round, +4 and +8* in the B-first round. An error that stopped the test is ERROR with its code.** os9exec lost B's byte in the B-first round until 2026-09-14 (obs=8): each* path kept its own copy of the sector, both wrote it back at close, and the* stale copy landed last. On a directory that made move leave the old name* beside the new one, on the same file descriptor.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IRead set $89IWrite set $8AISeek set $88IClose set $8FIDelete set $87ATTRS set $001B*EXPECT set 0* psect t61twopath,Type_Lang,Attr_Rev,0,2048,startstart sub.l #256,a7 movea.l a7,a4 moveq #0,d6* round 1: A closes first; lost bytes count 1 and 2 moveq #0,d4 bsr.w round bcs.w setuperr add.l d3,d6* round 2: B closes first; lost bytes count 4 and 8 moveq #1,d4 bsr.w round bcs.w setuperr lsl.l #2,d3 add.l d3,d6 lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail** round -- d4 = 0 to close A first, 1 to close B first. Returns d3 = 1 if A's* byte was lost, +2 if B's; carry set with the error in d1 if a step failed.round lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #3,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w rfail move.w d0,d7 movea.l a4,a0 move.w #199,d2rfill move.b #'.',(a0)+ dbra d2,rfill moveq #0,d0 move.w d7,d0 movea.l a4,a0 move.l #200,d1 trap #0 dc.w IWrite bcs.w rfail moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose* path A in d5, path B in d7, both for update lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IOpen bcs.w rfail move.w d0,d5 lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IOpen bcs.w rfail move.w d0,d7* B reads the sector first, so it holds a copy of it moveq #0,d0 move.w d7,d0 movea.l a4,a0 moveq #64,d1 trap #0 dc.w IRead bcs.w rfail* A: 'A' at 8 moveq #0,d0 move.w d5,d0 moveq #8,d1 trap #0 dc.w ISeek bcs.w rfail moveq #0,d0 move.w d5,d0 lea chA(pc),a0 moveq #1,d1 trap #0 dc.w IWrite bcs.w rfail* B: 'B' at 40 moveq #0,d0 move.w d7,d0 moveq #40,d1 trap #0 dc.w ISeek bcs.w rfail moveq #0,d0 move.w d7,d0 lea chB(pc),a0 moveq #1,d1 trap #0 dc.w IWrite bcs.s rfail tst.l d4 bne.s rbfirst moveq #0,d0 move.w d5,d0 trap #0 dc.w IClose moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose bra.s rcheckrbfirst moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose moveq #0,d0 move.w d5,d0 trap #0 dc.w IClosercheck lea fname(pc),a0 moveq #1,d0 trap #0 dc.w IOpen bcs.s rfail move.w d0,d5 moveq #0,d0 move.w d5,d0 movea.l a4,a0 moveq #64,d1 trap #0 dc.w IRead bcs.s rfail moveq #0,d0 move.w d5,d0 trap #0 dc.w IClose moveq #0,d3 cmpi.b #'A',8(a4) beq.s rgotA addq.l #1,d3rgotA cmpi.b #'B',40(a4) beq.s rgotB addq.l #2,d3rgotB andi.b #$FE,ccr rtsrfail ori.b #1,ccr rts* use verdict.i use report.i*fname dc.b "SCRATCH/t61.dat",0chA dc.b 'A'chB dc.b 'B'idstr dc.b "RESULT t61 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  two update paths keep both writes, whichever closes first",0 ends