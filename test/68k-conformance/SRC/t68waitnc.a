* t68waitnc.a -- CONF68K test t68: F$Wait with no child processes reports* E$NoChld.** Claim (DOCS/claims.md): F$Wait "returns an error only if the caller has no* child processes", and lists E$NoChld (F$Wait, FUNCTION and POSSIBLE* ERRORS, page 1 - 71); the error appendix gives E$NoChld as 000:226, an* F$Wait request made by a process with no children.** This process forks nothing, so its F$Wait must come straight back with* carry set and 226. obs is the error code, or 0 if the call "succeeded" --* which, with nobody to wait for, could only mean it returned a child that* does not exist. A system that instead blocks forever has no line in the* report at all, which runall's totals show.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FWait set $04*EXPECT set 226* psect t68waitnc,Type_Lang,Attr_Rev,0,2048,startstart moveq #0,d6 trap #0 dc.w FWait bcc.s t68ok move.w d1,d6t68ok cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*idstr dc.b "RESULT t68 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  F$Wait with no child processes reports E$NoChld",0 ends