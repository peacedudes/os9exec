* t64datmod.a -- CONF68K test t64: F$DatMod creates a data module as asked.** Claim (DOCS/claims.md): F$DatMod takes a size in d0.l, an attribute/* revision word in d1.w, access permission in d2.w, type/language in d3.w* and a name at (a0); it returns the type/language in d0.w, the attribute/* revision in d1.w, the data pointer in a1 and the header in a2. It "creates* a data module with the specified attribute/revision and clears the data* portion", the module is "created with a valid CRC, and entered into the* system module directory" (Technical Manual, F$DatMod, page 1 - 12, and* "Creating Data Modules" in the memory-modules chapter).** The attribute/revision asked for is $8001: attribute byte $80 with its top* bit set. That is deliberate. os9exec carried the word as a signed short* and shifted it, undefined behaviour in C, found by UBSan on 2026-09-19; a* value with the high bit clear would not have reached it.** So, in order: the call succeeds; d1.w comes back $8001 (else obs 1); d0.w* comes back the $0400 asked for (else 2); every byte of the data area is* zero (else 3); F$Link by the name finds the SAME header (else the link's* error code, or 4 if it found another module); and F$CRC over the whole* module leaves the 24-bit CRC constant $800FE3 (else 5) -- the check t36* and t37 make of a module OS-9 loaded, made here of one it built.** The created module is unlinked on every path once it exists. Its* attribute has no sticky bit, so that removes it, and a second run in the* same session creates it afresh rather than meeting the first one.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FLink set $00FUnLink set $02FCRC set $17FDatMod set $25MSize set 4*DSIZE set 100DATTR set $8001DACCESS set $0333DTYPE set $0400BADATTR set 1BADTYPE set 2NOTCLEAR set 3OTHERHDR set 4BADCRC set 5*EXPECT set 0* psect t64datmod,Type_Lang,Attr_Rev,0,2048,startstart lea dname(pc),a0 move.l #DSIZE,d0 move.w #DATTR,d1 move.w #DACCESS,d2 move.w #DTYPE,d3 moveq #0,d4 trap #0 dc.w FDatMod bcs.s t64err movea.l a2,a3 moveq #BADATTR,d6 cmpi.w #DATTR,d1 bne.s t64out moveq #BADTYPE,d6 cmpi.w #DTYPE,d0 bne.s t64out moveq #NOTCLEAR,d6 move.w #DSIZE-1,d5t64clr tst.b (a1)+ bne.s t64out dbra d5,t64clr lea dname(pc),a0 moveq #0,d0 trap #0 dc.w FLink bcs.s t64code moveq #OTHERHDR,d6 cmpa.l a2,a3 bne.s t64drop trap #0 dc.w FUnLink move.l MSize(a3),d0 movea.l a3,a0 move.l #$FFFFFFFF,d1 trap #0 dc.w FCRC bcs.s t64code moveq #BADCRC,d6 andi.l #$00FFFFFF,d1 cmpi.l #$00800FE3,d1 bne.s t64out moveq #0,d6 bra.s t64out* the link found some other module: drop that link, then ourst64drop trap #0 dc.w FUnLink bra.s t64outt64code moveq #0,d6 move.w d1,d6t64out movea.l a3,a2 trap #0 dc.w FUnLink cmpi.l #EXPECT,d6 beq.s ispass bra.s isfail* F$DatMod itself refused: there is no module to unlinkt64err moveq #0,d6 move.w d1,d6 bra.s isfail* use verdict.i use report.i*dname dc.b "t64data",0idstr dc.b "RESULT t64 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  F$DatMod builds the module asked for: attr, cleared, CRC, linkable",0 ends