* t54sysid.a -- CONF68K test t54: F$SysID identifies the system, pre-3.0 form.** Claim (DOCS/claims.md): F$SysID takes the addresses of three 80-byte* buffers in a0, a1 and a2 -- version string, copyright string, author* names, a zero address meaning that string is not wanted -- fills them* with NUL-terminated strings no longer than 80 bytes including the NUL,* and returns the licensee number in d0, the serial number in d1, the* processor in use in d2 and the processor the kernel was built for in d3,* both as Motorola part numbers, with d4 to d7 zero.** THIS IS THE FORM THAT EXISTED BEFORE OS-9 v3.0, and the claim is not* Microware's. The v2.4 Technical Manual does not document the call at all* -- it was "implemented but not documented" until 3.0 redefined it around* a parameter block -- so the contract above is the OS-9 Guru's, and it is* the contract the programs of that era use (the hc_utils `sysid` utility* passes exactly these registers). On a v3.0-or-later kernel this test* measures nothing about F$SysID: whatever it reports there is the new* form's reaction to the old form's registers, and is not a verdict.** All three buffers are asked for and filled with $FF beforehand, so a* string the kernel did not terminate within 80 bytes shows. The processor* number in use is checked to be nonzero and nothing more: which processor* it is belongs to the machine, not to the claim.** FAIL carries the error code when the call refuses (208, E$UnkSvc, being* the answer of a system without it), 1 when d2 is zero, and 2, 3 or 4 when* the version, copyright or author string has no terminator within its* buffer.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FSysID set $55*STRMAX set 80BUFS set 3*STRMAXNOMPU set 1NOTERM set 2*EXPECT set 0* psect t54sysid,Type_Lang,Attr_Rev,0,2048,startstart suba.l #BUFS,a7 movea.l a7,a0 move.w #BUFS-1,d0t54fill move.b #$FF,(a0)+ dbra d0,t54fill movea.l a7,a0 lea STRMAX(a7),a1 lea 2*STRMAX(a7),a2 trap #0 dc.w FSysID bcs.s t54err tst.l d2 bne.s t54mpu moveq #NOMPU,d6 bra.w isfailt54mpu moveq #NOTERM,d6 movea.l a7,a0 bsr.s t54term beq.s t54v bra.w isfailt54v addq.l #1,d6 lea STRMAX(a7),a0 bsr.s t54term beq.s t54c bra.w isfailt54c addq.l #1,d6 lea 2*STRMAX(a7),a0 bsr.s t54term beq.s t54a bra.w isfailt54a moveq #0,d6 bra.w ispasst54err moveq #0,d6 move.w d1,d6 bra.w isfail** t54term -- a0 = buffer. Returns Z set if a NUL lies within STRMAX bytes.t54term move.w #STRMAX-1,d5t54scan tst.b (a0)+ beq.s t54found dbra d5,t54scan moveq #1,d5 rtst54found moveq #0,d5 rts* use verdict.i use report.i*idstr dc.b "RESULT t54 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  F$SysID fills three terminated strings and names a processor",0 ends