* t07extend.a -- CONF68K test t07: I$Seek beyond the end of a file, then* write there.** Claim (DOCS/claims.md): I$Seek's FUNCTION text states a seek may target* any position even if the file is not that large, and that subsequent* writes automatically expand the file to the required size; I$Write's own* text states the same from the writing side. I$GetStt SS_Size returns the* current size. So seeking to 70000 and writing 5 bytes must leave a file* of exactly 70005 bytes.** The seek target is deliberately above 65535. I$Seek takes its position* in d1.l -- a full 32-bit byte offset -- and a target under 64K would pass* just as well on a system that only honoured the low 16 bits. That makes* this test the 32-bit-position check as much as the extension check.** It also means the suite needs roughly 80K of free space on whatever* device it runs from. If the write cannot be satisfied the test reports* ERROR with the code that stopped it -- a full disk is not a conformance* failure.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IRead set $89IWrite set $8AISeek set $88IClose set $8FIDelete set $87IGetStt set $8DSSSize set $02ATTRS set $001B*EXPECT set 70005* psect t07extend,Type_Lang,Attr_Rev,0,2048,startstart* Scratch buffer on the stack, never in the code psect: this module is* marked re-entrant and a real system may hold it in ROM, where a write* into its own body would fault rather than just be untidy. sub.l #128,a7 movea.l a7,a4 lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7* seek past the end -- 70000 does not fit in 16 bits move.l #70000,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w ISeek bcs.w setuperr lea data5(pc),a0 moveq #5,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr* ask the file how big it now is moveq #0,d0 move.w d7,d0 move.w #SSSize,d1 trap #0 dc.w IGetStt bcs.w setuperr move.l d2,d6 moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose cmpi.l #EXPECT,d6 beq.s ispass bra.s isfail* use verdict.i use report.i*fname dc.b "SCRATCH/t07.dat",0data5 dc.b "HELLO"idstr dc.b "RESULT t07 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  write after a seek past EOF extends the file to seek+count",0 ends