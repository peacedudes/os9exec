* t13evread.a -- CONF68K test t13: Ev$Read leaves the event value alone.** Claim (DOCS/claims.md): Ev$Read "reads the value of an event without waiting* or modifying the event variable" and returns that value in d1.l.  The event* here is created with a NON-ZERO wait auto-increment and read TWICE; both* reads must report the value the event was created with.** Both of those choices are load-bearing.  With a zero wait increment a system* that wrongly applied the increment would be indistinguishable from one that* did not.  And with a single read, "returned the value from before its own* increment" also looks correct -- only the second read separates them.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FEvent set $53EvCreat set 2EvUnLnk set 1EvDelet set 3EvRead set 6*INITVAL set 1234EXPECT set 1234* psect t13evread,Type_Lang,Attr_Rev,0,2048,startstart lea evname(pc),a0 move.l #INITVAL,d0 move.w #EvCreat,d1 move.w #-1,d2 move.w #1,d3 trap #0 dc.w FEvent bcs.w setuperr move.l d0,d5 move.l d5,d0 move.w #EvRead,d1 trap #0 dc.w FEvent bcs.w setuperr move.l d5,d0 move.w #EvRead,d1 trap #0 dc.w FEvent bcs.w setuperr move.l d1,d6 move.l d5,d0 move.w #EvUnLnk,d1 trap #0 dc.w FEvent lea evname(pc),a0 move.w #EvDelet,d1 trap #0 dc.w FEvent cmpi.l #EXPECT,d6 beq.s ispass bra.s isfail* use verdict.i use report.i*evname dc.b "cf13ev",0idstr dc.b "RESULT t13 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  Ev$Read returns the event value without changing it",0 ends