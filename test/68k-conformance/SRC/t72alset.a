* t72alset.a -- CONF68K test t72: A$Set sends ONE signal once its interval* has passed.** Claim (DOCS/claims.md): F$Alarm "creates an asynchronous software alarm* clock timer. The timer sends a signal to the calling process when the* specified time period has elapsed" (F$Alarm, page 1 - 1), and A$Set, given* the signal code in d2 and an interval in ticks in d3, "sends one signal* after the specified time interval has elapsed" and returns the alarm ID* in d0 (A$Set, page 1 - 2).** The process installs an intercept routine that keeps the first code and* counts every call, asks for signal 300 after 20 ticks, and then sleeps* 100 ticks in all -- a sleep a signal can cut short, so it goes back to* sleep for whatever is left. That is five times the interval: long enough* for the alarm, and for a second one had A$Set behaved like A$Cycle. obs is* 1000 x the signals received plus the first code: 1300 when the claim* holds; 0 if the alarm never came; 2300 or more if it came again.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FIcpt set $09FSleep set $0AFRTE set $1EFAlarm set $56ADelete set 0ASet set 1* in the data area, through a6*EXPECT set 1300* psect t72alset,Type_Lang,Attr_Rev,0,2048,start vsectCNT ds.w 1FIRST ds.w 1 endsstart clr.w CNT(a6) clr.w FIRST(a6) lea sighand(pc),a0 trap #0 dc.w FIcpt bcs.w setuperr moveq #0,d0 move.w #ASet,d1 move.l #300,d2 moveq #20,d3 trap #0 dc.w FAlarm bcs.w setuperr moveq #100,d4 bsr.s nap moveq #0,d6 move.w CNT(a6),d6 mulu #1000,d6 moveq #0,d0 move.w FIRST(a6),d0 add.l d0,d6 cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail** the intercept routine: keep the first code, count every callsighand tst.w CNT(a6) bne.s shcount move.w d1,FIRST(a6)shcount addq.w #1,CNT(a6) trap #0 dc.w FRTE** nap -- sleep d4 ticks in all, however often a signal cuts a sleep shortnap moveq #0,d0 move.l d4,d0 trap #0 dc.w FSleep tst.l d0 beq.s napdone move.l d0,d4 bra.s napnapdone rts* use verdict.i use report.i*idstr dc.b "RESULT t72 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  A$Set sends one signal after its interval",0 ends