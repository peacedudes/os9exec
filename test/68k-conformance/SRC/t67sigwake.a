* t67sigwake.a -- CONF68K test t67: S$Wake wakes a sleeping process without* ending it, even with no intercept routine.** Claim (DOCS/claims.md): the wakeup signal "activates a sleeping process* but does not cause examination of the signal intercept routine and will* not abort a process that has not made an F$Icpt call" (F$Send, page 1 -* 57); F$Sleep: "The process is activated before the full time interval if* a signal (in particular S$Wake) is received", and it returns "the* remaining number of ticks if awakened prematurely" in d0.l (page 1 - 61).** The same shape as t66, with S$Wake (1) in place of signal 300. The child* has no intercept routine and sleeps for 500 ticks; it exits 77 when F$Sleep* came back with ticks left over and 78 when it did not. So obs is 77 when* the claim holds; 1 (the signal code as exit status) would mean the wake* killed it, and 78 that the wake was lost.*SIGNAL set 1EXPECT set 77*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FFork set $03FWait set $04FExit set $06FSend set $08FSleep set $0APARMMAX set 256* the child's bounded sleep, and the parent's head start before signallingCHSLEEP set 500HEADSTART set 50* the child's own exit codes: woken before its sleep ran out, or notWOKEN set 77SLEPT set 78* F$Wait kept returning for something other than our childNOCHILD set 900* psect t67sigwake,Type_Lang,Attr_Rev,0,2048,startstart* role first: d5/a5 are the entry registers and hold the parameter tst.l d5 beq.s parent cmpi.l #PARMMAX,d5 bhi.s parent cmpi.b #'C',(a5) beq.s child** ---- parent: fork, give the child time to fall asleep, signal it, reap ----parent moveq #0,d0 moveq #0,d1 moveq #1,d2 moveq #3,d3 moveq #0,d4 lea childpm(pc),a1 lea myname(pc),a0 trap #0 dc.w FFork bcs.w setuperr move.w d0,d7 move.l #HEADSTART,d0 trap #0 dc.w FSleep moveq #0,d0 move.w d7,d0 move.w #SIGNAL,d1 trap #0 dc.w FSend bcs.s psendf moveq #20,d3pwait trap #0 dc.w FWait bcs.w setuperr cmp.w d7,d0 beq.s pgot subq.w #1,d3 bne.s pwait move.w #NOCHILD,d1 bra.w setuperrpgot moveq #0,d6 move.w d1,d6 cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* a refused F$Send: reap the child (it exits by itself) and report the codepsendf move.w d1,d6 trap #0 dc.w FWait move.w d6,d1 bra.w setuperr** ---- child: no F$Icpt; sleep, bounded, and say whether it was cut short ----child move.l #CHSLEEP,d0 trap #0 dc.w FSleep move.w #SLEPT,d1 tst.l d0 beq.s chexit move.w #WOKEN,d1chexit trap #0 dc.w FExit* use verdict.i use report.i*myname dc.b "t67sigwake",0childpm dc.b "C"idstr dc.b "RESULT t67 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  S$Wake wakes a sleeper with no F$Icpt and does not kill it",0 ends