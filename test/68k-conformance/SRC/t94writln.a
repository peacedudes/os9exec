* t94writln.a -- CONF68K test t94: I$WritLn stops at the carriage return* and writes no more of the buffer.** Claim (DOCS/claims.md): "I$WriteLn is similar to Write except it writes* data until a carriage return character or (d1) bytes are encountered", and* it returns "d1.l = Actual number of bytes written" (I$WritLn, page 2 - 31);* I$GetStt SS_Size returns the current size of the file in d2.l (page 2 - 13).** The buffer is "AB", CR, "XY" and the call offers all five bytes. Three must* be written -- the CR ends it -- so the count is 3 and the file is 3 bytes,* holding "AB" and the CR. The count and the size are asked separately* because they fail apart: a system that writes the whole buffer but reports* 3 is caught by the size, and one that writes 3 and reports 5 by the count.** The manual's own warning about the count is why the size is read from the* file rather than trusted from the call: on a character device the file* managers may add bytes that the count does not reflect. This test uses a* file precisely so that no such addition is in the picture.** obs is 100 for the count, plus 10 for the size, plus 1 for the three bytes* being the ones offered, terminator included: 111.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1ICreate set $83IOpen set $84IRead set $89IWritLn set $8CIClose set $8FIDelete set $87IGetStt set $8DSSSize set $02ATTRS set $001B*EXPECT set 111* psect t94writln,Type_Lang,Attr_Rev,0,2048,startstart sub.l #128,a7 movea.l a7,a4 lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 moveq #0,d6* lea line(pc),a0 moveq #5,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWritLn bcs.w setuperr cmpi.l #3,d1 bne.s t94size moveq #100,d6t94size moveq #0,d0 move.w d7,d0 move.w #SSSize,d1 trap #0 dc.w IGetStt bcs.s t94back cmpi.l #3,d2 bne.s t94back addi.l #10,d6t94back moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #1,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7 movea.l a4,a0 moveq #3,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IRead bcs.s t94done cmpi.l #3,d1 bne.s t94done cmpi.b #'A',0(a4) bne.s t94done cmpi.b #'B',1(a4) bne.s t94done cmpi.b #$0D,2(a4) bne.s t94done addq.l #1,d6t94done moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*fname dc.b "SCRATCH/t94.dat",0line dc.b "AB",$0D,"XY" dc.b 0idstr dc.b "RESULT t94 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  I$WritLn stops at the carriage return",0 ends