* t19lock.a -- CONF68K test t19: a read in update mode locks the record* against another process's write.** Claim (DOCS/claims.md): "When a file is opened in update mode, ANY read* causes the record to be locked out because RBF does not know in advance if* the record will be updated" (Technical Manual, page 7-8), and the locked* area "includes all bytes starting with the current file pointer and* extending for the number of bytes requested" (page 7-11). E$Lock, 252, is* "RECORD IS LOCKED-OUT - Another process is accessing the requested* record". With SS_Ticks set to 1 -- "if the record is not released* immediately, an error is returned" -- a second process writing into a* range this one has read is refused with 252 rather than made to wait.** This is the first test in the suite that needs two processes. A single* process cannot check it at any level of care, because RBF exempts a* process from its own locks: "RBF notices that the same process owns both* paths and keeps them from locking each other out" (page 7-8). See fork.i* for how the second process is arranged, why the parent rescues it rather* than trusting the timeout, and what each observable value means.** The parent takes the lock BEFORE forking, so there is no window in which* the child could arrive first: F$Fork cannot return a child that started* before the call that created it.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IRead set $89IWrite set $8AISeek set $88IClose set $8FIDelete set $87ATTRS set $001BUPDATE set 3*EXPECT set 252* psect t19lock,Type_Lang,Attr_Rev,0,4096,startstart* Role first: ckrole reads d5 and a5, which are entry registers and are* undefined the moment anything else runs. bsr ckrole tst.w d0 bne.w child** ---- parent: build the file, take the lock, then fork ---- lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose* lea fname(pc),a0 moveq #UPDATE,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7** Availability probe, and the reason this test can report SKIP: on a device* with no record locking under it every remaining step would measure the* shim rather than the claim. d6 carries the code the device gave, so the* report says which. See canlock in fork.i. bsr canlock bcc.s locked moveq #0,d6 move.w d1,d6 bra.w isskip** The read IS the lock -- nothing else here takes one. Fifty bytes from* position zero, so the locked range is [0,50) and the child's write at zero* lands inside it. Reading only half the file is deliberate: it leaves the* range a proper subset, so a system that locks the whole file on any read* still passes this and is caught by the tests that check extent.locked sub.l #128,a7 movea.l a7,a4 clr.l d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w ISeek bcs.w setuperr movea.l a4,a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IRead bcs.w setuperr* bsr contend bcs.w setuperr* moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail** ---- child: contend for the range the parent is holding ----child lea fname(pc),a0 moveq #UPDATE,d0 trap #0 dc.w IOpen bcs.w chfail move.w d0,d7 bsr chticks bcs.w chfail clr.l d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w ISeek bcs.w chfail* Everything is open and positioned; the write is the very next thing this* process does, which is what chready promises the parent. bsr chready lea data50(pc),a0 moveq #10,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcc.s chok moveq #0,d6 move.w d1,d6 bra.s chrepchok moveq #0,d6chrep bsr chsaw bra.w chdone* use verdict.i use fork.i use report.i*fname dc.b "SCRATCH/t19.dat",0myname dc.b "t19lock",0data50 dc.b "0123456789012345678901234567890123456789012345678" dc.b 13idstr dc.b "RESULT t19 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0skipstr dc.b "SKIP",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  a read in update mode locks the record against another process",0 ends