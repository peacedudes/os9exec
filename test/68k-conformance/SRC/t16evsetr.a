* t16evsetr.a -- CONF68K test t16: Ev$SetR adds its own increment.** Claim (DOCS/claims.md): Ev$SetR is "similar to Ev$Signl, but instead of using* the signal auto-increment value to update the event variable, the value in d2* is used".  So the event moves by d2 -- not by the signal auto-increment, and* not to d2 as Ev$Set would.** The event is created with a signal auto-increment that differs from the* increment passed in, and the increment differs from the resulting value, so* all three confusions -- signalled instead, set instead of added, not applied* at all -- land on different numbers.Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FEvent set $53EvCreat set 2EvUnLnk set 1EvDelet set 3EvWaitR set 5EvRead set 6EvInfo set 7EvSignl set 8EvSet set $0AEvSetR set $0B*INITVAL set 500INCR set 250EXPECT set 750* psect t16evsetr,Type_Lang,Attr_Rev,0,2048,startstart lea evname(pc),a0 move.l #INITVAL,d0 move.w #EvCreat,d1 move.w #0,d2 move.w #7,d3 trap #0 dc.w FEvent bcs.w setuperr move.l d0,d5 move.l d5,d0 move.w #EvSetR,d1 move.l #INCR,d2 trap #0 dc.w FEvent bcs.w setuperr move.l d5,d0 move.w #EvRead,d1 trap #0 dc.w FEvent bcs.w setuperr move.l d1,d6 move.l d5,d0 move.w #EvUnLnk,d1 trap #0 dc.w FEvent lea evname(pc),a0 move.w #EvDelet,d1 trap #0 dc.w FEvent cmpi.l #EXPECT,d6 beq.s ispass bra.s isfail* use verdict.i use report.i*evname dc.b "cf16ev",0idstr dc.b "RESULT t16 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  Ev$SetR moves the event by the increment it is given",0 ends