* t65prsnam.a -- CONF68K test t65: F$PrsNam finds one pathlist element.** Claim (DOCS/claims.md): F$PrsNam takes a string at (a0) and returns the* delimiter in d0.b, the element's length in d1.w, a0 moved past an* optional leading "/", and a1 at the element's last character +1. A* valid element holds upper and lower case letters, digits, periods,* underscores and dollar signs; ANY other character ends the name and is* returned as the delimiter (Technical Manual, F$PrsNam, page 1 - 45).** Three strings, each one piece of that sentence:*   "/D0/FILE"   the manual's own worked example: d0.b "/", d1.w 2, a0 one*                past the leading slash, a1 at the second slash.*   "a.b_C$9 x"  every character class the manual lists, once: length 7,*                ended by the space.*   "ab{c"       a character the manual does not list ends the name: length*                2, delimiter "{". os9exec accepted braces as name characters*                -- a Macintosh MPW convenience -- until 2026-09-19.** obs is 0 when everything holds; otherwise the error code of a refused call,* or 1-4 for the example (length, delimiter, a0, a1), 5-6 for the character* classes (length, delimiter) and 7-8 for the brace (length, delimiter).*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FPrsNam set $10*EXPECT set 0* psect t65prsnam,Type_Lang,Attr_Rev,0,2048,startstart* the manual's example lea ex(pc),a2 movea.l a2,a0 trap #0 dc.w FPrsNam bcs.w t65code moveq #1,d6 cmpi.w #2,d1 bne.w t65out moveq #2,d6 cmpi.b #'/',d0 bne.w t65out moveq #3,d6 lea 1(a2),a3 cmpa.l a3,a0 bne.w t65out moveq #4,d6 lea 3(a2),a3 cmpa.l a3,a1 bne.w t65out* every listed character class lea cls(pc),a0 trap #0 dc.w FPrsNam bcs.s t65code moveq #5,d6 cmpi.w #7,d1 bne.s t65out moveq #6,d6 cmpi.b #' ',d0 bne.s t65out* a character not in the list lea brc(pc),a0 trap #0 dc.w FPrsNam bcs.s t65code moveq #7,d6 cmpi.w #2,d1 bne.s t65out moveq #8,d6 cmpi.b #'{',d0 bne.s t65out moveq #0,d6t65out cmpi.l #EXPECT,d6 beq.w ispass move.l d1,d4 move.l d0,d5 lea dlen(pc),a3 moveq #0,d2 move.w d4,d2 bsr.w detail lea ddel(pc),a3 moveq #0,d2 move.b d5,d2 bsr.w detail bra.w isfailt65code moveq #0,d6 move.w d1,d6 bra.w isfail* use verdict.i use report.i*ex dc.b "/D0/FILE",0cls dc.b "a.b_C$9 x",0brc dc.b "ab{c",0idstr dc.b "RESULT t65 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  F$PrsNam ends a name at any character the manual does not list",0dlen dc.b "F$PrsNam returned the length",0ddel dc.b "and the delimiter",0 ends