* t74alcyc.a -- CONF68K test t74: A$Cycle repeats its signal until the* alarm is deleted.** Claim (DOCS/claims.md): A$Cycle "is similar to the A$Set function, except* that the alarm is reset after it is sent, to provide a recurring periodic* signal" (A$Cycle, page 1 - 3); A$Delete "removes a cyclic alarm" (page* 1 - 2).** Signal 300 every 20 ticks; after 110 ticks the count must be at least 3* (five periods have passed, so this allows two to be lost to scheduling* without calling the result wrong). Then the alarm is deleted by its ID and* the process waits 60 more ticks, three periods, and the count must not* move. obs is 100 if it repeated, plus 10 if it stopped when deleted, plus* 1 if the code was 300: 111 when the claim holds. A one-shot alarm scores* 11; one that deleting does not stop scores 101.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FIcpt set $09FSleep set $0AFRTE set $1EFAlarm set $56ADelete set 0ASet set 1ACycle set 2AAtDate set 3AAtJul set 4FTime set $15* in the data area, through a6CNT set 0FIRST set 2*EXPECT set 111* psect t74alcyc,Type_Lang,Attr_Rev,0,2048,startstart clr.w CNT(a6) clr.w FIRST(a6) lea sighand(pc),a0 trap #0 dc.w FIcpt bcs.w setuperr moveq #0,d0 move.w #ACycle,d1 move.l #300,d2 moveq #20,d3 trap #0 dc.w FAlarm bcs.w setuperr move.l d0,d7 moveq #110,d4 bsr.w nap move.w CNT(a6),d5 move.l d7,d0 move.w #ADelete,d1 trap #0 dc.w FAlarm* not setuperr: an alarm that never repeated has expired and may be refused,* and that is the claim failing, not the test. A refused delete of a live* cyclic alarm shows as the count still moving. moveq #60,d4 bsr.w nap moveq #0,d6 cmpi.w #3,d5 blo.s t74c2 addi.l #100,d6t74c2 cmp.w CNT(a6),d5 bne.s t74c3 addi.l #10,d6t74c3 cmpi.w #300,FIRST(a6) bne.s t74v addq.l #1,d6t74v cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* the intercept routine: keep the first code, count every callsighand tst.w CNT(a6) bne.s shcount move.w d1,FIRST(a6)shcount addq.w #1,CNT(a6) trap #0 dc.w FRTE** nap -- sleep d4 ticks in all, however often a signal cuts a sleep shortnap moveq #0,d0 move.l d4,d0 trap #0 dc.w FSleep tst.l d0 beq.s napdone move.l d0,d4 bra.s napnapdone rts* use verdict.i use report.i*idstr dc.b "RESULT t74 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  A$Cycle repeats its signal until the alarm is deleted",0 ends