* t60gprdsc.a -- CONF68K test t60: F$GPrDsc of a process ID past any process* table reports E$IPrcID.** Claim (DOCS/claims.md): F$GPrDsc copies the descriptor of the process named* by d0.w and lists an illegal process ID as its error (Technical Manual,* F$GPrDsc, page 1 - 36); the error-code appendix assigns 224 to a process ID* naming a non-existent process. So an ID no process can have must answer* 224 -- never a copy of whatever lies beyond the table.** Four IDs, all far past any plausible table: $0100, $01A8, $7FFF and $FFFF.* obs is 224 when every one is refused that way. Otherwise it is the first* different answer: the error code it gave, or 0 if the call succeeded.** os9exec indexed its process table with d0.w unchecked until 2026-09-14, so* these IDs read host memory past the array. A process monitor walking IDs* was told of processes that do not exist, and then took a bus error.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FGPrDsc set $18*EXPECT set 224* psect t60gprdsc,Type_Lang,Attr_Rev,0,2048,startstart* a small copy is enough to be refused or not; the buffer is on the stack sub.l #128,a7 movea.l a7,a4 lea pids(pc),a3 moveq #3,d5t60nxt moveq #0,d0 move.w (a3)+,d0 moveq #64,d1 movea.l a4,a0 trap #0 dc.w FGPrDsc bcc.s t60got moveq #0,d6 move.w d1,d6 cmpi.l #EXPECT,d6 bne.s t60jdg dbra d5,t60nxt bra.s t60jdgt60got* the call copied a descriptor for a process that cannot exist moveq #0,d6t60jdg cmpi.l #EXPECT,d6 beq.s ispass bra.s isfail* use verdict.i use report.i*pids dc.w $0100,$01A8,$7FFF,$FFFFidstr dc.b "RESULT t60 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  F$GPrDsc of a process ID past any table reports E$IPrcID",0 ends