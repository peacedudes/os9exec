* t21defr.a -- CONF68K test t21: a record locked by one process defers* another process's READ of the same bytes.** Claim (DOCS/claims.md): record locking exists to recognise "when a process* is trying to read a record that another process may be modifying" and to* defer "the read request until the record is safe" (Technical Manual, page* 7-7) -- the reading side is the case the whole mechanism was designed* around. With SS_Ticks at 1, "if the record is not released immediately, an* error is returned", so the deferred reader is told 252 instead of waiting.** This is t19 with the CHILD's operation changed from a write to a read, and* it is here to localise rather than to broaden. t19 and t21 make the same* demand of the same lock and differ only in how the second process asks;* an implementation that treats the two paths separately -- one of which* resumes a woken waiter and one of which does not -- reports two different* observations here and is caught in the act. A single test using only a* write could not tell that apart from the whole lock being broken.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IRead set $89IWrite set $8AISeek set $88IClose set $8FIDelete set $87ATTRS set $001BUPDATE set 3*EXPECT set 252* psect t21defr,Type_Lang,Attr_Rev,0,4096,startstart bsr ckrole tst.w d0 bne.w child* lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #UPDATE,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7 bsr canlock bcc.s ready moveq #0,d6 move.w d1,d6 bra.w isskipready move.l #0,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w ISeek bcs.w setuperr sub.l #128,a7 movea.l a7,a4 movea.l a4,a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IRead bcs.w setuperr* bsr contend bcs.w setuperr* moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail*child lea fname(pc),a0 moveq #UPDATE,d0 trap #0 dc.w IOpen bcs.w chfail move.w d0,d7 bsr chticks bcs.w chfail move.l #0,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w ISeek bcs.w chfail bsr chready sub.l #128,a7 movea.l a7,a4 movea.l a4,a0 moveq #10,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IRead bcc.s chok moveq #0,d6 move.w d1,d6 bra.s chrepchok moveq #0,d6chrep bsr chsaw bra.w chdone* use verdict.i use fork.i use report.i*fname dc.b "SCRATCH/t21.dat",0myname dc.b "t21defr",0data50 dc.b "0123456789012345678901234567890123456789012345678" dc.b 13idstr dc.b "RESULT t21 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0skipstr dc.b "SKIP",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  a locked record defers another process's read",0 ends