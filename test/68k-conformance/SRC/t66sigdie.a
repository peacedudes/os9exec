* t66sigdie.a -- CONF68K test t66: a signal ends a process that has no* intercept routine, and the signal code becomes its exit status.** Claim (DOCS/claims.md): "If the destination process for the signal is* sleeping or waiting, it is activated so that it may process the signal.* The signal processing intercept routine is executed, if it exists (see* F$Icpt), otherwise the signal aborts the destination process, and the* signal code becomes the exit status (see F$Wait)" (F$Send, page 1 - 57);* and F$Wait: "If the child process died due to a signal, the exit status* word (register d1) is the signal code" (page 1 - 71).** The module forks itself; the child (parameter "C") installs no intercept* routine and sleeps for 500 ticks. The parent waits half a second, sends* it signal 300 -- in the user-defined range, 256-65535, so it means nothing* to anyone but this test -- and reaps it. obs is the exit status F$Wait* reports: 300 when the claim holds. 77 would mean the signal only woke the* child and it exited by itself; 78 that it was never delivered and the* child slept its whole sleep. The bounded sleep is what keeps a system* that drops the signal from hanging the run.*SIGNAL set 300EXPECT set 300*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FFork set $03FWait set $04FExit set $06FSend set $08FSleep set $0APARMMAX set 256* the child's bounded sleep, and the parent's head start before signallingCHSLEEP set 500HEADSTART set 50* the child's own exit codes: woken before its sleep ran out, or notWOKEN set 77SLEPT set 78* F$Wait kept returning for something other than our childNOCHILD set 900* psect t66sigdie,Type_Lang,Attr_Rev,0,2048,startstart* role first: d5/a5 are the entry registers and hold the parameter tst.l d5 beq.s parent cmpi.l #PARMMAX,d5 bhi.s parent cmpi.b #'C',(a5) beq.s child** ---- parent: fork, give the child time to fall asleep, signal it, reap ----parent moveq #0,d0 moveq #0,d1 moveq #1,d2 moveq #3,d3 moveq #0,d4 lea childpm(pc),a1 lea myname(pc),a0 trap #0 dc.w FFork bcs.w setuperr move.w d0,d7 move.l #HEADSTART,d0 trap #0 dc.w FSleep moveq #0,d0 move.w d7,d0 move.w #SIGNAL,d1 trap #0 dc.w FSend bcs.s psendf moveq #20,d3pwait trap #0 dc.w FWait bcs.w setuperr cmp.w d7,d0 beq.s pgot subq.w #1,d3 bne.s pwait move.w #NOCHILD,d1 bra.w setuperrpgot moveq #0,d6 move.w d1,d6 cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* a refused F$Send: reap the child (it exits by itself) and report the codepsendf move.w d1,d6 trap #0 dc.w FWait move.w d6,d1 bra.w setuperr** ---- child: no F$Icpt; sleep, bounded, and say whether it was cut short ----child move.l #CHSLEEP,d0 trap #0 dc.w FSleep move.w #SLEPT,d1 tst.l d0 beq.s chexit move.w #WOKEN,d1chexit trap #0 dc.w FExit* use verdict.i use report.i*myname dc.b "t66sigdie",0childpm dc.b "C"idstr dc.b "RESULT t66 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  a signal kills a process with no F$Icpt; its code is the exit status",0 ends