* t32ticks.a -- CONF68K test t32: SS_Ticks on a path that cannot honour it.** Claim (DOCS/claims.md): SS_Ticks is an RBF SetStat.  A file manager that does* not implement a SetStat must report E$UnkSvc (208) -- the code the manual* assigns to an unknown service request -- not do something undefined.  /nil is* not an RBF device on any medium, so this is the same claim everywhere.** Runs LAST in the suite on purpose.  The defect it was written for is a call* through an uninitialised dispatch slot, which takes the whole emulator down* rather than returning; from the end of the run that costs only this test's* own line instead of turning every later test into a MISSING.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ISetStt set $8EIClose set $8FSSTicks set $10*EXPECT set 208* psect t32ticks,Type_Lang,Attr_Rev,0,2048,startstart lea nilname(pc),a0 moveq #3,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7 moveq #0,d6 moveq #0,d0 move.w d7,d0 move.w #SSTicks,d1 moveq #5,d2 trap #0 dc.w ISetStt bcc.s noerror move.w d1,d6noerror moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose cmpi.l #EXPECT,d6 beq.s ispass bra.s isfail* use verdict.i use report.i*nilname dc.b "/nil",0idstr dc.b "RESULT t32 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  SS_Ticks on a non-RBF path reports E$UnkSvc",0 ends