* t102cctl.a -- CONF68K test t102: F$CCtl flushes for anyone, and refuses a* reserved bit.** Claim (DOCS/claims.md): "If d0.l is set to zero, the system instruction and* data caches are flushed. Non-super-group, user-state processes may perform* this generic operation." The precise operations are bits 0-2 (data cache* enable/disable/flush) and 4-6 (instruction cache), and "all other bits are* reserved. If any reserved bit is set, an E$Param error is returned"; E$Param* is the page's only listed error (F$CCtl, page 1 - 6). The appendix numbers* E$Param 000:225 (page Error Codes - 7).** Both halves matter and they pull in opposite directions. The generic flush* must SUCCEED for an ordinary process -- a machine with no cache has nothing* to do, and answering E$UnkSvc would break the thing the page says every* program building code in memory must do before running it. The reserved bit* must FAIL -- a system that accepted anything would also accept the flush,* and this test could not tell the two apart with one call.** Bit 3 is the reserved bit used here: it sits between the two defined groups,* so a system that masked with $77 and one that masked with $7F disagree about* it, which is exactly the boundary worth pinning.** obs is 100 if the generic flush succeeded, plus 10 if a defined precise* operation (flush both caches, $44) succeeded too, plus 1 if bit 3 earned* E$Param: 111.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FCCtl set $5AEPARAM set 225*EXPECT set 111* psect t102cctl,Type_Lang,Attr_Rev,0,2048,startstart moveq #0,d6 moveq #0,d4 moveq #0,d5 moveq #0,d7* exg, not move, keeps each call's error: a move would clear the carry that* says whether the call failed.* the generic flush, which any user-state process may ask for moveq #0,d0 trap #0 dc.w FCCtl exg d1,d4 bcs.s t102pre moveq #0,d4 moveq #100,d6* a defined precise operation: flush both caches (bits 2 and 6)t102pre moveq #$44,d0 trap #0 dc.w FCCtl exg d1,d5 bcs.s t102res moveq #0,d5 addi.l #10,d6* a reserved bit: bit 3t102res moveq #8,d0 trap #0 dc.w FCCtl exg d1,d7 bcc.s t102acc cmpi.w #EPARAM,d7 bne.s t102v addq.l #1,d6t102v cmpi.l #EXPECT,d6 beq.w ispass lea dflush(pc),a3 moveq #0,d2 move.w d4,d2 bsr.w detail lea dprec(pc),a3 moveq #0,d2 move.w d5,d2 bsr.w detail lea dresv(pc),a3 moveq #0,d2 move.w d7,d2 bsr.w detail bra.w isfailt102acc moveq #0,d7 bra.s t102v* use verdict.i use report.i*idstr dc.b "RESULT t102 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  F$CCtl flushes for any process and refuses a reserved bit",0dflush dc.b "F$CCtl d0=0 (flush all) error (0: none)",0dprec dc.b "F$CCtl d0=$44 error (0: none)",0dresv dc.b "F$CCtl d0=8 (reserved bit) error (0: accepted)",0 ends