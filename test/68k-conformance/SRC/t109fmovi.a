* t109fmovi.a -- CONF68K test t109: a float stored as an integer rounds by* FPCR and saturates.** Claim (DOCS/claims.md), M68000 Family Programmer's Reference, FMOVE to an* integer format: the value is rounded by the FPCR mode, and one too large* for the format is an operand error that stores the largest integer of its* sign. One digit each, in order: 2.7->3, -2.5->-2 (to nearest even),* 3e9->$7FFFFFFF, -3e9->$80000000, 300.0 as a byte->$7F, and with FPCR set* to round toward zero, 2.7->2.** WHY: an INFERENCE for the saturated values (the reference names the* operand error; what is stored with its trap disabled is our reading).* os9exec's emulation once truncated whatever FPCR said.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FSTrap set $0ET_LINEF set $2CEXPECT set 111111 psect t109fmovi,Type_Lang,Attr_Rev,0,2048,startstart moveq #0,d0 movea.l d0,a0 lea exctbl(pc),a1 trap #0 dc.w FSTrap bcs.w setuperr moveq #0,d6 moveq #0,d4 subq.l #8,a7 movea.l a7,a2 lea twoseven(pc),a0 dc.w $F210,$5400 moveq #0,d0 dc.w $F200,$6000 mulu #10,d6 cmpi.l #3,d0 beq.s y1 moveq #1,d7 bsr.w t109miss bra.s c1y1 addq.l #1,d6c1 lea mtwohalf(pc),a0 dc.w $F210,$5400 moveq #0,d0 dc.w $F200,$6000 mulu #10,d6 cmpi.l #-2,d0 beq.s y2 moveq #2,d7 bsr.w t109miss bra.s c2y2 addq.l #1,d6c2 lea threeg(pc),a0 dc.w $F210,$5400 moveq #0,d0 dc.w $F200,$6000 mulu #10,d6 cmpi.l #$7FFFFFFF,d0 beq.s y3 moveq #3,d7 bsr.w t109miss bra.s c3y3 addq.l #1,d6c3 lea mthreeg(pc),a0 dc.w $F210,$5400 moveq #0,d0 dc.w $F200,$6000 mulu #10,d6 cmpi.l #$80000000,d0 beq.s y4 moveq #4,d7 bsr.w t109miss bra.s c4y4 addq.l #1,d6c4 lea threehund(pc),a0 dc.w $F210,$5400 moveq #0,d0 dc.w $F200,$7800 mulu #10,d6 cmpi.b #$7F,d0 beq.s y5 moveq #5,d7 bsr.w t109miss bra.s c5y5 addq.l #1,d6c5 dc.w $F23C,$9000 dc.l $00000010 lea twoseven(pc),a0 dc.w $F210,$5400 moveq #0,d0 dc.w $F200,$6000 dc.w $F23C,$9000 dc.l 0 mulu #10,d6 cmpi.l #2,d0 beq.s y6 moveq #6,d7 bsr.w t109miss bra.s c6y6 addq.l #1,d6c6 cmpi.l #EXPECT,d6 beq.w ispass lea dchk(pc),a3 move.l d4,d2 bsr.w detail lea dval(pc),a3 move.l d5,d2 bsr.w detail bra.w isfail* t109miss -- d7 = the check that just disagreed, d0 = what it stored.* Keeps the FIRST one, for the DETAIL lines a FAIL prints.t109miss tst.l d4 bne.s t109mx move.l d7,d4 move.l d0,d5t109mx rts* No FPU and no FPU emulation: the first FPU instruction is a line-F trap.* That system cannot exercise the claim, which is a SKIP, not a failure.exctbl dc.w T_LINEF,nofpu-*-4 dc.w -1nofpu* the digits scored before the trap, from the saved d6 (R$d6, 24(a5)),* so a partial FPU -- a 68040 or 68060 with no FPSP -- shows how far it got move.l 24(a5),d6 lea skipstr(pc),a5 bra.w report use verdict.i use report.i aligntwoseven dc.l $40059999,$9999999Amtwohalf dc.l $C0040000,0threeg dc.l $41E65A0B,$C0000000mthreeg dc.l $C1E65A0B,$C0000000threehund dc.l $4072C000,0idstr dc.b "RESULT t109 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0skipstr dc.b "SKIP",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  a float stored as an integer rounds by FPCR and saturates",0dchk dc.b "first check that disagreed",0dval dc.b "integer that check stored",0 ends