* t28exts.a -- CONF68K test t28: a record lock covers the bytes that were* asked for and no more.** Claim (DOCS/claims.md): "The locked out area includes all bytes starting* with the current file pointer and extending for the number of bytes* requested" (Technical Manual, page 7-11). So a fifty-byte read at position* zero locks [0,50) and leaves everything past it alone: another process* may write at 60 with no conflict.** This is the other half of t19, and the pair is what makes either one mean* anything. t19 says a lock happens; on its own it is satisfied by a system* that locks the whole file, or the whole device, on any read at all -- which* would be catastrophic on a shared file and would still pass. t28 is the* upper bound. The contending write is at 60, comfortably past the end of* the locked range and comfortably short of end of file, so neither the* record lock nor EOF lock can account for a refusal.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IRead set $89IWrite set $8AISeek set $88IClose set $8FIDelete set $87ATTRS set $001BUPDATE set 3*EXPECT set 0* psect t28exts,Type_Lang,Attr_Rev,0,4096,startstart bsr ckrole tst.w d0 bne.w child* lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #UPDATE,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7 bsr canlock bcc.s ready moveq #0,d6 move.w d1,d6 bra.w isskipready move.l #0,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w ISeek bcs.w setuperr sub.l #128,a7 movea.l a7,a4 movea.l a4,a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IRead bcs.w setuperr* bsr contend bcs.w setuperr* moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail*child lea fname(pc),a0 moveq #UPDATE,d0 trap #0 dc.w IOpen bcs.w chfail move.w d0,d7 bsr chticks bcs.w chfail move.l #60,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w ISeek bcs.w chfail bsr chready lea data50(pc),a0 moveq #10,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcc.s chok moveq #0,d6 move.w d1,d6 bra.s chrepchok moveq #0,d6chrep bsr chsaw bra.w chdone* use verdict.i use fork.i use report.i*fname dc.b "SCRATCH/t28.dat",0myname dc.b "t28exts",0data50 dc.b "0123456789012345678901234567890123456789012345678" dc.b 13idstr dc.b "RESULT t28 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0skipstr dc.b "SKIP",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  a record lock covers only the bytes that were requested",0 ends