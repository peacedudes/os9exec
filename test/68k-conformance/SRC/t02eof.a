* t02eof.a -- CONF68K test t02: I$Read once a file is fully consumed.** Claim (DOCS/claims.md): after all data in a file has been read, the next* I$Read reports E$EOF, error 211. The manual states this in I$Read's own* FUNCTION text and lists E$EOF in its POSSIBLE ERRORS.** The distinction this test has to respect: the same passage says a read* that finds LESS data than it asked for returns the short count and is* NOT an end-of-file error (t06 checks that half). So this test consumes* the file exactly -- 4 bytes written, 4 bytes read -- and only then issues* the read that must fail. Asking for more than 4 on the first read would* test t06's claim instead and never reach the EOF condition.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IRead set $89IWrite set $8AISeek set $88IClose set $8FIDelete set $87IGetStt set $8DSSSize set $02ATTRS set $001B*EXPECT set 211* psect t02eof,Type_Lang,Attr_Rev,0,2048,startstart* Scratch buffer on the stack, never in the code psect: this module is* marked re-entrant and a real system may hold it in ROM, where a write* into its own body would fault rather than just be untidy. sub.l #128,a7 movea.l a7,a4 lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea data4(pc),a0 moveq #4,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose lea fname(pc),a0 moveq #1,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7* consume the file exactly movea.l a4,a0 moveq #4,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IRead bcs.w setuperr* the file is now exhausted: this read must fail movea.l a4,a0 moveq #4,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IRead bcc.s t02ok moveq #0,d6 move.w d1,d6 bra.s t02jdgt02ok moveq #0,d6t02jdg cmpi.l #EXPECT,d6 beq.s ispass bra.s isfail* use verdict.i use report.i*fname dc.b "SCRATCH/t02.dat",0data4 dc.b "ABCD"idstr dc.b "RESULT t02 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  I$Read of an exhausted file reports E$EOF",0 ends