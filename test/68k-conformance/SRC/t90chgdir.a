* t90chgdir.a -- CONF68K test t90: I$ChgDir changes the data directory or the* execution directory, according to the access mode, and refuses a file.** Claim (DOCS/claims.md): I$ChgDir takes an access mode in d0.b and a pathlist* at (a0); "the file specified must be a directory file"; "if the access mode* is read, write, or update, the current data directory changes. If the access* mode is execute, the current execution directory changes" (I$ChgDir, page* 2 - 3). Its errors are E$BPNam and E$BMode; the page does not say which a* plain file earns, so this asks only that it is refused.** Three steps, on a file this test makes in SCRATCH:*   chd (mode 1) to that FILE      must fail*   chd (mode 4, execute) to ".."     the DATA directory must not move: the*                                      file still opens as "SCRATCH/t90.dat"*   chd (mode 1, read) to SCRATCH      the data directory must move: the file*                                      now opens as "t90.dat"** The execute-mode step names ".." because an execute-mode pathlist is* resolved against the EXECUTION directory, not the data one -- naming the* data directory's own SCRATCH there earns E$PNNF, as it should, and would* test nothing. The suite's execution directory is its CMDS, so ".." is the* directory the data paths below are relative to, and moving there is a real* move that must still leave the data directory where it was.** obs is 100 + 10 + 1 for the three: 111. A system where execute mode moved* the data directory too scores 101, since the first open would then fail.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IChgDir set $86ICreate set $83IOpen set $84IClose set $8FIDelete set $87ATTRS set $001BMREAD set 1MEXEC set 4*EXPECT set 111* psect t90chgdir,Type_Lang,Attr_Rev,0,2048,startstart lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose moveq #0,d6* a plain file is not a directory lea fname(pc),a0 moveq #MREAD,d0 trap #0 dc.w IChgDir bcc.s t90exec move.l #100,d6* execute mode must leave the data directory alonet90exec lea uname(pc),a0 moveq #MEXEC,d0 trap #0 dc.w IChgDir bcs.s t90data lea fname(pc),a0 moveq #1,d0 trap #0 dc.w IOpen bcs.s t90data move.w d0,d7 addi.l #10,d6 moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose* read mode must move itt90data lea dname(pc),a0 moveq #MREAD,d0 trap #0 dc.w IChgDir bcs.s t90fin lea bname(pc),a0 moveq #1,d0 trap #0 dc.w IOpen bcs.s t90fin move.w d0,d7 addq.l #1,d6 moveq #0,d0 move.w d7,d0 trap #0 dc.w ICloset90fin lea bname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*fname dc.b "SCRATCH/t90.dat",0bname dc.b "t90.dat",0dname dc.b "SCRATCH",0uname dc.b "..",0idstr dc.b "RESULT t90 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  I$ChgDir moves the data or execution directory by its access mode",0 ends