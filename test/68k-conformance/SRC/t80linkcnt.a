* t80linkcnt.a -- CONF68K test t80: a module stays while it has links, and* leaves the module directory when the last one is given up.** Claim (DOCS/claims.md): F$UnLink decrements the module's link count, and* "when the link count equals zero, the module is removed from the module* directory and its memory is de-allocated" (F$UnLink, page 1 - 69); F$Link* increments it (F$Link, page 1 - 41); F$DatMod creates a module and enters* it in the module directory (page 1 - 12).** A data module is created (the creator holds one link), linked by name* (two), unlinked once (one). It must still be there: a second F$Link by* name must find the SAME header. That link is given back (one), and then* the creator's (none). Now the module is gone: F$Link by name must fail* with E$MNF.** obs is 100 if the module survived one unlink out of two links, plus 10 if* that link found the same header, plus 1 if it was gone after the last* unlink: 111. A system that removes on the first unlink scores 1; one that* never removes scores 110.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FLink set $00FUnLink set $02FDatMod set $25EMNF set 221*EXPECT set 111* psect t80linkcnt,Type_Lang,Attr_Rev,0,2048,startstart lea dname(pc),a0 moveq #64,d0 move.w #$8001,d1 move.w #$0333,d2 move.w #$0400,d3 moveq #0,d4 trap #0 dc.w FDatMod bcs.w setuperr movea.l a2,a3 moveq #0,d6* a second link, given straight back lea dname(pc),a0 moveq #0,d0 trap #0 dc.w FLink bcs.w setuperr trap #0 dc.w FUnLink* one link left: it must still be found, and be the same module lea dname(pc),a0 moveq #0,d0 trap #0 dc.w FLink bcs.s t80last moveq #100,d6 cmpa.l a2,a3 bne.s t80give addi.l #10,d6t80give trap #0 dc.w FUnLink* the creator's link, the last onet80last movea.l a3,a2 trap #0 dc.w FUnLink lea dname(pc),a0 moveq #0,d0 trap #0 dc.w FLink bcc.s t80still cmpi.w #EMNF,d1 bne.s t80v addq.l #1,d6 bra.s t80vt80still trap #0 dc.w FUnLinkt80v cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*dname dc.b "t80data",0idstr dc.b "RESULT t80 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  a module stays while linked and goes with the last unlink",0 ends