* t73aldel.a -- CONF68K test t73: A$Delete removes an alarm that has not* gone off.** Claim (DOCS/claims.md): "A$Delete removes a cyclic alarm, or any alarm* that has not expired", given the alarm ID in d0 (A$Delete, page 1 - 2);* A$Set returns that ID in d0 (same page).** Two alarms: signal 300 after 30 ticks, deleted at once by its ID, and* signal 301 after 60 ticks, left alone. The second is the control. Without* it an alarm system that never fired at all would "delete" perfectly. The* process then sleeps 120 ticks in all (going back to sleep whenever a* signal cuts it short). obs is 1000 x the signals received plus the first* code: 1301 when the claim holds; 2300 or 1300 if the deleted alarm still* went off; 0 if nothing arrived, which says the control never fired; or* the error code if A$Delete refused its own alarm's ID.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FIcpt set $09FSleep set $0AFRTE set $1EFAlarm set $56ADelete set 0ASet set 1* in the data area, through a6CNT set 0FIRST set 2*EXPECT set 1301* psect t73aldel,Type_Lang,Attr_Rev,0,2048,startstart clr.w CNT(a6) clr.w FIRST(a6) lea sighand(pc),a0 trap #0 dc.w FIcpt bcs.w setuperr moveq #0,d0 move.w #ASet,d1 move.l #300,d2 moveq #30,d3 trap #0 dc.w FAlarm bcs.w setuperr move.l d0,d7 moveq #0,d0 move.w #ASet,d1 move.l #301,d2 moveq #60,d3 trap #0 dc.w FAlarm bcs.w setuperr move.l d7,d0 move.w #ADelete,d1 trap #0 dc.w FAlarm bcc.s t73wait moveq #0,d6 move.w d1,d6 bra.w isfailt73wait moveq #120,d4 bsr.s nap moveq #0,d6 move.w CNT(a6),d6 mulu #1000,d6 moveq #0,d0 move.w FIRST(a6),d0 add.l d0,d6 cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail** the intercept routine: keep the first code, count every callsighand tst.w CNT(a6) bne.s shcount move.w d1,FIRST(a6)shcount addq.w #1,CNT(a6) trap #0 dc.w FRTE** nap -- sleep d4 ticks in all, however often a signal cuts a sleep shortnap moveq #0,d0 move.l d4,d0 trap #0 dc.w FSleep tst.l d0 beq.s napdone move.l d0,d4 bra.s napnapdone rts* use verdict.i use report.i*idstr dc.b "RESULT t73 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  A$Delete removes an alarm that has not gone off",0 ends