* t84pipekeep.a -- CONF68K test t84: a named pipe still holding data is kept* when its last path closes, and can be opened and read later.** Claim (DOCS/claims.md): "When a pipe path is closed, its path count* decreases. If no paths are left open on an unnamed pipe, its memory returns* to the system. With named pipes, its memory returns only if the pipe is* empty. A non-empty pipe (with no open paths) is artificially kept open,* waiting for another process to open and read from the pipe" (Interprocess* Communications, Close, page 4 - 14).** /pipe/t84p is created, four bytes written, and the only path closed. Then* it is opened by name and read. obs is 1 when the four bytes come back:* the claim holds. An open that finds no pipe reports its error; one that* finds an empty pipe (the data thrown away) reports 0 -- SS_Ready is asked* first so that case cannot block the run in a read nobody will satisfy.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1ICreate set $83IOpen set $84IRead set $89IWrite set $8AIClose set $8FIGetStt set $8DSSReady set $01FIcpt set $09FRTE set $1EFAlarm set $56ADelete set 0ASet set 1EEOF set 211*EXPECT set 1* psect t84pipekeep,Type_Lang,Attr_Rev,0,2048,startstart sub.l #16,a7 movea.l a7,a4 lea pname(pc),a0 moveq #3,d0 moveq #0,d1 moveq #0,d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea data4(pc),a0 moveq #4,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose* every path is closed; the pipe is not empty lea pname(pc),a0 moveq #3,d0 trap #0 dc.w IOpen bcc.s t84open moveq #0,d6 move.w d1,d6 bra.s t84vt84open move.w d0,d7 moveq #0,d6 moveq #0,d0 move.w d7,d0 move.w #SSReady,d1 trap #0 dc.w IGetStt bcs.s t84close movea.l a4,a0 moveq #4,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IRead bcs.s t84close cmpi.l #'WXYZ',(a4) bne.s t84close moveq #1,d6t84close moveq #0,d0 move.w d7,d0 trap #0 dc.w ICloset84v cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*pname dc.b "/pipe/t84p",0data4 dc.b "WXYZ"idstr dc.b "RESULT t84 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  a named pipe with data is kept after its last close",0 ends