* t111pipesz.a -- CONF68K test t111: SS_Size on a pipe that holds bytes.** Claim (DOCS/claims.md): an INFERENCE, stated as one. The Technical Manual* reads two ways: Pipeman's GetStat list says SS_Size "Returns the size of the* pipe buffer", and I$GetStt says "Return Current File Size (RBF, PIPE)".* os9exec refuses it, E$UnkSvc (208): less sized piped input with SS_Size,* and the binary people ran shows nothing for a size of 0 and stops short at* any other size, so only an error lets it read to the end. Ten bytes are* written first, so a size says which reading a system follows: 0, 10 (the* bytes waiting), or about 90 (the default buffer). obs is the size answered,* or the error code if the call is refused.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84IWrite set $8AIGetStt set $8DIClose set $8FSSSize set $02UPDATE set 3EXPECT set 208 psect t111pipesz,Type_Lang,Attr_Rev,0,2048,startstart lea pname(pc),a0 moveq #UPDATE,d0 trap #0 dc.w IOpen bcs.w setuperr move.w d0,d7 lea block(pc),a0 moveq #10,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr moveq #0,d0 move.w d7,d0 move.w #SSSize,d1 trap #0 dc.w IGetStt bcc.s t111ok moveq #0,d2 move.w d1,d2t111ok move.l d2,d6 moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* use verdict.i use report.i*pname dc.b "/pipe",0block dc.b "012345678",13idstr dc.b "RESULT t111 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  SS_Size on a pipe is refused E$UnkSvc (inference)",0 ends