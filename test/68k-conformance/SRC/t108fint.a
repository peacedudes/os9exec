* t108fint.a -- CONF68K test t108: FINT, FINTRZ, FMOD and FREM keep their* results floating and round as the FPU's rules say.** Claim (DOCS/claims.md), M68000 Family Programmer's Reference: FINT rounds* by the FPCR mode (to nearest, ties to even, at reset); FINTRZ rounds* toward zero; FMOD's quotient is rounded toward zero, FREM's to nearest.* One digit each, in order: FINT(-2.3)=-2, FINT(2.5)=2, FINTRZ(1e10)=1e10* (past 32 bits), FMOD(1e10,3)=1, FREM(-7,2)=1.** WHY: os9exec's emulation once computed all four through a 32-bit integer.* The fix follows the manual; this says whether real hardware agrees.*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FSTrap set $0ET_LINEF set $2CEXPECT set 11111 psect t108fint,Type_Lang,Attr_Rev,0,2048,startstart moveq #0,d0 movea.l d0,a0 lea exctbl(pc),a1 trap #0 dc.w FSTrap bcs.w setuperr moveq #0,d6 subq.l #8,a7 movea.l a7,a2 lea one(pc),a0 dc.w $F210,$5400 lea mtwo3(pc),a1 dc.w $F211,$5401 dc.w $F212,$7400 mulu #10,d6 cmpi.l #$C0000000,(a2) bne.s c1 cmpi.l #0,4(a2) bne.s c1 addq.l #1,d6c1 lea one(pc),a0 dc.w $F210,$5400 lea twohalf(pc),a1 dc.w $F211,$5401 dc.w $F212,$7400 mulu #10,d6 cmpi.l #$40000000,(a2) bne.s c2 cmpi.l #0,4(a2) bne.s c2 addq.l #1,d6c2 lea one(pc),a0 dc.w $F210,$5400 lea e10(pc),a1 dc.w $F211,$5403 dc.w $F212,$7400 mulu #10,d6 cmpi.l #$4202A05F,(a2) bne.s c3 cmpi.l #$20000000,4(a2) bne.s c3 addq.l #1,d6c3 lea e10(pc),a0 dc.w $F210,$5400 lea three(pc),a1 dc.w $F211,$5421 dc.w $F212,$7400 mulu #10,d6 cmpi.l #$3FF00000,(a2) bne.s c4 cmpi.l #0,4(a2) bne.s c4 addq.l #1,d6c4 lea mseven(pc),a0 dc.w $F210,$5400 lea two(pc),a1 dc.w $F211,$5425 dc.w $F212,$7400 mulu #10,d6 cmpi.l #$3FF00000,(a2) bne.s c5 cmpi.l #0,4(a2) bne.s c5 addq.l #1,d6c5 cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail* No FPU and no FPU emulation: the first FPU instruction is a line-F trap.* That system cannot exercise the claim, which is a SKIP, not a failure.exctbl dc.w T_LINEF,nofpu-*-4 dc.w -1nofpu moveq #11,d6 lea skipstr(pc),a5 bra.w report use verdict.i use report.i alignone dc.l $3FF00000,0two dc.l $40000000,0three dc.l $40080000,0mtwo3 dc.l $C0026666,$66666666twohalf dc.l $40040000,0mseven dc.l $C01C0000,0e10 dc.l $4202A05F,$20000000idstr dc.b "RESULT t108 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0skipstr dc.b "SKIP",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  FINT rounds to nearest even; FINTRZ, FMOD, FREM exact",0 ends