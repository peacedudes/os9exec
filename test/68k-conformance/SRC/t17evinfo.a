* t17evinfo.a -- CONF68K test t17: Ev$Info reports the event's value.** Claim (DOCS/claims.md): Ev$Info "returns a copy of the 32-byte event table* entry", indexed by "the system event number" in the LOW WORD of d0, and* returns in d0 the index it found.  The manual lists the entry's fields in* order -- ID, name, value, wait increment, signal increment, link count, next,* previous -- and states a 12-character name, a four-byte value and two queue* pointers, which leaves one word each for ID, the two increments and the link* count.  That puts the value at offset 14, and it must match the value the* event was created with.** The search LOOPS rather than assuming index 0.  A real OS-9 system may* already have events of its own below ours, and this suite exists to be run on* one; pinning the index would make it report a divergence that is really just* somebody else's event sitting in a lower slot.Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FEvent set $53EvCreat set 2EvDelet set 3EvWaitR set 5EvRead set 6EvInfo set 7EvSignl set 8EvSet set $0AEvSetR set $0B*INITVAL set 4321EXPECT set 4321TRIES set 16* psect t17evinfo,Type_Lang,Attr_Rev,0,2048,startstart* Buffer on the stack, never in the code psect -- this module is re-entrant* and may be held in ROM. sub.l #64,a7 movea.l a7,a4 lea evname(pc),a0 move.l #INITVAL,d0 move.w #EvCreat,d1 move.w #0,d2 move.w #1,d3 trap #0 dc.w FEvent bcs.w setuperr moveq #0,d6 moveq #0,d4 moveq #TRIES,d3infoloop movea.l a4,a0 move.l d4,d0 move.w #EvInfo,d1 trap #0 dc.w FEvent bcs.s infodone move.l 14(a4),d6 cmpi.l #EXPECT,d6 beq.s infodone addq.l #1,d0 move.l d0,d4 subq.l #1,d3 bne.s infoloopinfodone lea evname(pc),a0 move.w #EvDelet,d1 trap #0 dc.w FEvent cmpi.l #EXPECT,d6 beq.s ispass bra.s isfail* use verdict.i use report.i*evname dc.b "cf17ev",0idstr dc.b "RESULT t17 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  Ev$Info reports the event's value in its entry",0 ends