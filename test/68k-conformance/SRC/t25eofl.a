* t25eofl.a -- CONF68K test t25: the writer sitting at end of file holds it* against a second process trying to extend the same file.** Claim (DOCS/claims.md): "An EOF lock occurs when the user reads or writes* data at the end of file. The user keeps the end of file locked until a* read or write is performed that is not at the end of the file. EOF lock is* the only time that a write call automatically causes lock out of any part* of the file. This avoids problems that could occur when two users try to* simultaneously extend a file" (Technical Manual, page 7-9).** Note what makes this different from every other lock in the suite: it is* taken by WRITING, not by reading, and no call asked for it. The manual is* explicit that this is the sole such case, so a system could implement* every other test here correctly and still lose the one lock that keeps two* appenders from interleaving.** The holder never closes the file: creating it and writing to its end is* the whole of taking this lock -- "As soon as the file is created, EOF lock* is gained, and no other process is able to pass the writer in processing* the file."*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1IOpen set $84ICreate set $83IWrite set $8AISeek set $88IClose set $8FIDelete set $87ATTRS set $001BUPDATE set 3*EXPECT set 252* psect t25eofl,Type_Lang,Attr_Rev,0,4096,startstart bsr ckrole tst.w d0 bne.w child* lea fname(pc),a0 moveq #3,d0 trap #0 dc.w IDelete lea fname(pc),a0 moveq #2,d0 move.w #ATTRS,d1 clr.l d2 trap #0 dc.w ICreate bcs.w setuperr move.w d0,d7 lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr lea data50(pc),a0 moveq #50,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcs.w setuperr bsr canlock bcc.s ready moveq #0,d6 move.w d1,d6 bra.w isskipready* bsr contend bcs.w setuperr* moveq #0,d0 move.w d7,d0 trap #0 dc.w IClose cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail*child lea fname(pc),a0 moveq #UPDATE,d0 trap #0 dc.w IOpen bcs.w chfail move.w d0,d7 bsr chticks bcs.w chfail move.l #100,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w ISeek bcs.w chfail bsr chready lea data50(pc),a0 moveq #10,d1 moveq #0,d0 move.w d7,d0 trap #0 dc.w IWrite bcc.s chok moveq #0,d6 move.w d1,d6 bra.s chrepchok moveq #0,d6chrep bsr chsaw bra.w chdone* use verdict.i use fork.i use report.i*fname dc.b "SCRATCH/t25.dat",0myname dc.b "t25eofl",0data50 dc.b "0123456789012345678901234567890123456789012345678" dc.b 13idstr dc.b "RESULT t25 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0skipstr dc.b "SKIP",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  a writer at end of file holds EOF lock against another writer",0 ends