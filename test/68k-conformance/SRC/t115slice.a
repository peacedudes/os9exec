* t115slice.a -- CONF68K test t115: a user-state process is time-sliced,* so one that makes no system calls cannot keep the machine to itself.** Claim (DOCS/claims.md): "User-state routines are time-sliced" (The* Kernel, User-state and System-state, page 2 - 2); "A real-time clock* interrupts the CPU at every tick. ... At any occurrence of a tick, OS-9* can suspend execution of one program and begin execution of another"* (Process Scheduling, page 2 - 27).** The module forks itself; the child (parameter "C") spins in a loop that* makes no system call at all, then exits by itself. The parent sleeps a* tenth of a second, sends the child signal 300, and reaps it. The parent* can only wake from that sleep if the clock takes the CPU away from the* child, so obs is the exit status F$Wait reports: 300 when the claim* holds -- the signal found the child still spinning and killed it (t66* is the claim that it does) -- and 55 when the child ran its loop to the* end before the parent ran again. The loop is bounded so that a system* without time-slicing reports FAIL instead of hanging the run; it is far* longer than the head start on any processor, and a passing system never* waits for it.*SIGNAL set 300EXPECT set 300*Prgrm set 1Objct set 1ReEnt set $80Type_Lang set (Prgrm<<8)+ObjctAttr_Rev set (ReEnt<<8)+1FFork set $03FWait set $04FExit set $06FSend set $08FSleep set $0APARMMAX set 256* the child's spin, and the parent's head start before signallingSPINS set 100000000HEADSTART set 10* the child's own exit code: it finished spinning before anyone else ranFINISHED set 55* F$Wait kept returning for something other than our childNOCHILD set 900* psect t115slice,Type_Lang,Attr_Rev,0,2048,startstart* role first: d5/a5 are the entry registers and hold the parameter tst.l d5 beq.s parent cmpi.l #PARMMAX,d5 bhi.s parent cmpi.b #'C',(a5) beq.w child** ---- parent: fork the spinner, sleep, signal it, reap ----parent moveq #0,d0 moveq #0,d1 moveq #1,d2 moveq #3,d3 moveq #0,d4 lea childpm(pc),a1 lea myname(pc),a0 trap #0 dc.w FFork bcs.w setuperr move.w d0,d7 move.l #HEADSTART,d0 trap #0 dc.w FSleep moveq #0,d0 move.w d7,d0 move.w #SIGNAL,d1 trap #0 dc.w FSend* refused: the child is gone already, so its own status is the answer moveq #20,d3pwait trap #0 dc.w FWait bcs.w setuperr cmp.w d7,d0 beq.s pgot subq.w #1,d3 bne.s pwait move.w #NOCHILD,d1 bra.w setuperrpgot moveq #0,d6 move.w d1,d6 cmpi.l #EXPECT,d6 beq.w ispass bra.w isfail** ---- child: spin with no system call, then exit by itself ----child move.l #SPINS,d0spin subq.l #1,d0 bne.s spin move.w #FINISHED,d1 trap #0 dc.w FExit* use verdict.i use report.i*myname dc.b "t115slice",0childpm dc.b "C"idstr dc.b "RESULT t115 ",0passtr dc.b "PASS",0failstr dc.b "FAIL",0errstr dc.b "ERROR",0obsstr dc.b "  obs=",0expstr dc.b " exp=",0descstr dc.b "  a process that makes no system calls is time-sliced",0 ends