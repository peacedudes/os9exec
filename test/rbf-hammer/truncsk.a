* truncsk <file> <newsize>: SS_Size, then seek to the new end,* so RBF's close-time truncation runs and frees the tail.* Hand-written assembly, so the module is all ours: a C build links the* vendor's cstart and library, which cannot be given away. The shell has no* way to shrink a file, and the hammer's scenarios need one.* Exits 1 on bad arguments or a file that will not open, as the C original* did; a refused SS_Size is not an error here, the scenario checks the result.  use /dd/DEFS/oskdefs.dF$Exit equ $06I$Open equ $84I$Seek equ $88I$SetStt equ $8EI$Close equ $8F  psect truncsk,(Prgrm<<8)+Objct,(ReEnt<<8)+1,1,256,start* a5 = the parameter string, ended by CRstart:  movea.l a5,a0skip1:  cmpi.b #$20,(a0)  bne.s name  addq.l #1,a0  bra.s skip1name:  movea.l a0,a2nchar:  move.b (a0),d0  cmpi.b #$20,d0  beq.s nend  cmpi.b #$0D,d0  beq.s bad  tst.b d0  beq.s bad  addq.l #1,a0  bra.s ncharnend:  clr.b (a0)+skip2:  cmpi.b #$20,(a0)  bne.s number  addq.l #1,a0  bra.s skip2* d4 = the size, decimal; d3 counts its digitsnumber:  moveq #0,d4  moveq #0,d3digit:  moveq #0,d0  move.b (a0)+,d0  subi.b #$30,d0  bcs.s ndone  cmpi.b #9,d0  bhi.s ndone  move.l d4,d1  lsl.l #3,d4  add.l d1,d4  add.l d1,d4  add.l d0,d4  addq.w #1,d3  bra.s digitndone:  tst.w d3  beq.s bad  movea.l a2,a0  moveq #3,d0  OS9 I$Open  bcs.s bad  move.w d0,d7  moveq #2,d1  move.l d4,d2  OS9 I$SetStt* the pointer to the new end, so the close-time truncation runs  move.w d7,d0  move.l d4,d1  OS9 I$Seek  move.w d7,d0  OS9 I$Close  moveq #0,d1  OS9 F$Exitbad:  moveq #1,d1  OS9 F$Exit  ends