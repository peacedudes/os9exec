* Live-tests F$Load($01), F$Link($00), F$UnLink($02), F$Fork($03),
* F$Wait($04) against 68k/syscall-reference.md, using childprg68k.a
* (F$Exit(77), already built and on disk) as the load/link/fork target.
* Register conventions below were cross-checked against os9exec's own
* fcalls.c (OS9_F_Load/F_Link/F_UnLink/F_Fork/F_Wait) before writing this
* -- all matched the skill's existing documented shape exactly, so this
* pass is a live confirmation, not a correction.
*
Prgrm set 1
Objct set 1
ReEnt set $80
Type_Lang set (Prgrm<<8)+Objct
Attr_Rev set (ReEnt<<8)+1
FLink set $00
FLoad set $01
FUnLink set $02
FFork set $03
FWait set $04
IWrite set $8A
FExit set $06
*
 psect batch201,Type_Lang,Attr_Rev,0,800,start
start
* --- F$Load(d0.w=mode,(a0)=name) -> d0.w=type,d1.w=attr,(a1)=entry,(a2)=hdr ---
 lea cpname(pc),a0
 clr.l d0
 trap #0
 dc.w FLoad
 bcc ldok
 move.l d1,d7
 lea ldfailmsg(pc),a0
 move.l #ldfaillen,d1
 moveq #1,d0
 trap #0
 dc.w IWrite
 move.l d7,d1
 bsr printnum
 bra done
ldok
 move.l a2,a4          save module header ptr for F$UnLink
 lea ldpassmsg(pc),a0
 move.l #ldpasslen,d1
 moveq #1,d0
 trap #0
 dc.w IWrite
 moveq #0,d1
 move.w d0,d1
 bsr printnum
*
* --- F$Link(d0.w=type,(a0)=name) -> same shape as F$Load; module is now
* resident (F$Load links too), so this should succeed by finding it ---
 lea cpname(pc),a0
 clr.l d0
 trap #0
 dc.w FLink
 bcc lkok
 move.l d1,d7
 lea lkfailmsg(pc),a0
 move.l #lkfaillen,d1
 moveq #1,d0
 trap #0
 dc.w IWrite
 move.l d7,d1
 bsr printnum
 bra unlinktest
lkok
 lea lkpassmsg(pc),a0
 move.l #lkpasslen,d1
 moveq #1,d0
 trap #0
 dc.w IWrite
*
* --- F$UnLink((a2)=module ptr) x2 -- one per link (F$Load + F$Link) ---
unlinktest
 movea.l a4,a2
 trap #0
 dc.w FUnLink
 bcc un1ok
 lea unfailmsg(pc),a0
 move.l #unfaillen,d1
 moveq #1,d0
 trap #0
 dc.w IWrite
 bra forktest
un1ok
 movea.l a4,a2
 trap #0
 dc.w FUnLink
 bcc un2ok
 lea unfailmsg(pc),a0
 move.l #unfaillen,d1
 moveq #1,d0
 trap #0
 dc.w IWrite
 bra forktest
un2ok
 lea unpassmsg(pc),a0
 move.l #unpasslen,d1
 moveq #1,d0
 trap #0
 dc.w IWrite
*
* --- F$Fork(d0.w=type,d1.l=mem,d2.l=paramsz,d3.w=#paths,d4.w=prior,
* (a0)=name,(a1)=params) -> d0.w=child pid ---
forktest
 lea cpname(pc),a0
 clr.l d0
 clr.l d1
 clr.l d2
 clr.l d3
 moveq #128,d4
 movea.l a0,a1          harmless nonzero param ptr, param size is 0
 trap #0
 dc.w FFork
 bcc fkok
 move.l d1,d7
 lea fkfailmsg(pc),a0
 move.l #fkfaillen,d1
 moveq #1,d0
 trap #0
 dc.w IWrite
 move.l d7,d1
 bsr printnum
 bra done
fkok
 move.l d0,d6           save child pid
 lea fkpassmsg(pc),a0
 move.l #fkpasslen,d1
 moveq #1,d0
 trap #0
 dc.w IWrite
 moveq #0,d1
 move.w d6,d1
 bsr printnum
*
* --- F$Wait() -> d0.w=child pid, d1.w=exit status ---
 trap #0
 dc.w FWait
 move.l d0,d4
 move.l d1,d5
 lea wtpassmsg(pc),a0
 move.l #wtpasslen,d1
 moveq #1,d0
 trap #0
 dc.w IWrite
 moveq #0,d1
 move.w d4,d1
 bsr printnum
 lea spacemsg(pc),a0
 moveq #1,d1
 moveq #1,d0
 trap #0
 dc.w IWrite
 moveq #0,d1
 move.w d5,d1
 bsr printnum
*
done
 moveq #0,d1
 trap #0
 dc.w FExit
*
* printnum: d1.l = unsigned value to print as decimal, followed by CR+LF.
printnum
 sub.l #16,a7
 movea.l a7,a1
 adda.l #16,a1
 move.l d1,d2
 moveq #0,d3
 tst.l d2
 bne.s pn_loop
 move.b #'0',-(a1)
 moveq #1,d3
 bra.s pn_output
pn_loop
 tst.l d2
 beq.s pn_output
 divu.w #10,d2
 move.w d2,d0
 swap d2
 move.b d2,d1
 add.b #'0',d1
 move.b d1,-(a1)
 addq.w #1,d3
 clr.l d2
 move.w d0,d2
 bra.s pn_loop
pn_output
 movea.l a1,a0
 move.l d3,d1
 moveq #1,d0
 trap #0
 dc.w IWrite
 add.l #16,a7
 lea crbyte(pc),a0
 moveq #2,d1
 moveq #1,d0
 trap #0
 dc.w IWrite
 rts
*
cpname dc.b "childprg68k",0
ldpassmsg dc.b "PASS F$Load type="
ldpasslen equ *-ldpassmsg
ldfailmsg dc.b "FAIL F$Load err="
ldfaillen equ *-ldfailmsg
lkpassmsg dc.b "PASS F$Link (already resident via F$Load)",13,10
lkpasslen equ *-lkpassmsg
lkfailmsg dc.b "FAIL F$Link err="
lkfaillen equ *-lkfailmsg
unpassmsg dc.b "PASS F$UnLink x2 (one per link)",13,10
unpasslen equ *-unpassmsg
unfailmsg dc.b "FAIL F$UnLink err=",13,10
unfaillen equ *-unfailmsg
fkpassmsg dc.b "PASS F$Fork pid="
fkpasslen equ *-fkpassmsg
fkfailmsg dc.b "FAIL F$Fork err="
fkfaillen equ *-fkfailmsg
wtpassmsg dc.b "PASS F$Wait pid/status="
wtpasslen equ *-wtpassmsg
spacemsg dc.b " "
crbyte dc.b 13,10
 ends
