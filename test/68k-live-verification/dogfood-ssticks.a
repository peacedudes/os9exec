* SS_Ticks: give up on somebody else's lock instead of waiting forever.
*
* A program that would rather be late than fail should wait as long as it
* takes -- that is the default, and what the record lock does with no limit
* set. But a program that must not hang behind a peer that has stopped
* responding needs to say "wait this long, then tell me you couldn't".
* SS_Ticks is how it says so; without it, os9exec waited unbounded.
*
* This runs as the WAITER half of a pair. The holder (lockhold) takes the
* record and sits on it. This program asks for a short limit, tries to read
* the same bytes, and should come back with E_LOCK ($FE... no: 252) rather
* than blocking until the holder is done.
*
*   run as:  lockhold &  ssticks
*
* Prints one line. "OK" means the wait was bounded as asked. "FAIL blocked"
* means it waited the holder out anyway -- the limit was ignored.
*
Prgrm     set 1
Objct     set 1
ReEnt     set $80
Type_Lang set (Prgrm<<8)+Objct
Attr_Rev  set (ReEnt<<8)+1
*
IOpen     set $84
IRead     set $89
IWrite    set $8A
IClose    set $8F
ISetStt   set $8E
FExit     set $06
Update_   set 3
SSTicks   set $10
ELOCK     set 252
*
 psect ssticks,Type_Lang,Attr_Rev,0,800,start
*
start
 lea     fname(pc),a0
 move.b  #Update_,d0
 trap    #0
 dc.w    IOpen
 bcs     noopen
 move.w  d0,d6
*
* --- ask for a short limit: 30 ticks
 move.w  d6,d0
 move.w  #SSTicks,d1
 move.l  #30,d2
 trap    #0
 dc.w    ISetStt
 bcs     nolimit
*
* --- now try to read what the holder is holding
 move.w  d6,d0
 lea     rbuf(pc),a0
 move.l  #8,d1
 trap    #0
 dc.w    IRead
 bcs     gaveup
*
* got the data: either nothing was holding it, or we waited it out
 lea     mblock(pc),a0
 move.l  #mblocklen,d1
 bsr     say
 bra     done
*
gaveup
 cmpi.w  #ELOCK,d1
 bne     othererr
 lea     mok(pc),a0
 move.l  #moklen,d1
 bsr     say
 bra     done
othererr
 lea     mother(pc),a0
 move.l  #motherlen,d1
 bsr     say
 bra     done
*
nolimit
 lea     mnolim(pc),a0
 move.l  #mnolimlen,d1
 bsr     say
*
done
 move.w  d6,d0
 trap    #0
 dc.w    IClose
 moveq   #0,d1
 trap    #0
 dc.w    FExit
*
noopen
 lea     mopen(pc),a0
 move.l  #mopenlen,d1
 bsr     say
 moveq   #1,d1
 trap    #0
 dc.w    FExit
*
say
 move.w  #2,d0
 trap    #0
 dc.w    IWrite
 rts
*
fname   dc.b "/h1/CLAUDETEST/rec2.dat",0
rbuf    dc.b "........"
mok     dc.b "ssticks: OK   gave up as asked (E_LOCK)",13
moklen  equ *-mok
mblock  dc.b "ssticks: FAIL blocked until the holder finished",13
mblocklen equ *-mblock
mother  dc.b "ssticks: FAIL some other error",13
motherlen equ *-mother
mnolim  dc.b "ssticks: FAIL SS_Ticks itself refused",13
mnolimlen equ *-mnolim
mopen   dc.b "ssticks: cannot open the file",13
mopenlen equ *-mopen
*
 ends
